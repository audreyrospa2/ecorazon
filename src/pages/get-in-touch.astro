---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import contactRaw from '../data/contact.json';

type Contact = {
  hero: { title: string; subtitle: string };
  contactInfo: {
    email: string;
    emailNote: string;
    responseTime: string;
    responseTimeNote: string;
    location: string;
    locationNote: string;
  };
  whatHappensNext: { title: string; desc: string }[];
  whyPartner: { icon: string; title: string; desc: string }[];
  faq: { question: string; answer: string }[];
  otherWaysToConnect: { icon: string; title: string; desc: string; linkLabel: string; mailtoSubject: string }[];
  finalCta: { title: string; subtitle: string };
};

const contact = contactRaw as Contact;

// FAQ renders in two columns
const faqMid = Math.ceil(contact.faq.length / 2);
const faqCol1 = contact.faq.slice(0, faqMid);
const faqCol2 = contact.faq.slice(faqMid);

const stepColors = ['bg-forest-green', 'bg-deep-olive', 'bg-cork-brown'];
---

<Layout title="Contact Us - Ecorazón">
  <Header />
  
  <main>
    <!-- Hero Section -->
    <section class="bg-gradient-to-br from-warm-beige to-gray-100 py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-forest-green mb-6">
          {contact.hero.title}
        </h1>
        <p class="text-xl text-gray-700 max-w-3xl mx-auto">
          {contact.hero.subtitle}
        </p>
      </div>
    </section>

    <!-- Contact Form Section -->
    <section class="py-16 bg-white" id="contact-form">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
          
          <!-- Contact Form -->
          <div>
            <h2 class="text-3xl font-bold text-forest-green mb-8">
              Start Your Project
            </h2>
            
            <!-- Success Message (shown after redirect back) -->
            <div id="success-message" class="hidden mb-6 p-4 bg-green-100 border border-green-400 text-green-700 rounded-md">
              <p class="font-semibold">✓ Thank you for your message!</p>
              <p class="text-sm">We'll get back to you within 24 hours.</p>
            </div>
            
            <!-- SIMPLIFIED FORM - Let Web3Forms handle everything -->
            <!-- NOTE: form fields, access key, and recipient emails are intentionally
                 not CMS-editable — this is integration wiring, not content. -->
            <form 
              action="https://api.web3forms.com/submit" 
              method="POST" 
              class="space-y-6"
            >
              
              <input type="hidden" name="access_key" value="7bc476c3-41ea-4ba8-94c6-0ebbc252e42a">
              <input type="hidden" name="redirect" value="https://ecorazon.vercel.app/get-in-touch?success=true">
              <input type="hidden" name="email" value="hello@onesparkcreations.com,hello@ecorazon.co">
              <input type="hidden" name="subject" value="New Contact Form Submission from Ecorazón">
              <input type="hidden" name="from_name" value="Ecorazón Contact Form">
              
              <!-- Name -->
              <div>
                <label for="name" class="block text-sm font-medium text-gray-700 mb-2">
                  Name *
                </label>
                <input 
                  type="text" 
                  id="name" 
                  name="name" 
                  required
                  class="w-full px-4 py-3 border border-gray-300 rounded-md focus:ring-2 focus:ring-forest-green focus:border-transparent"
                  placeholder="Your full name"
                />
              </div>

              <!-- Email -->
              <div>
                <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
                  Email *
                </label>
                <input 
                  type="email" 
                  id="email" 
                  name="email" 
                  required
                  class="w-full px-4 py-3 border border-gray-300 rounded-md focus:ring-2 focus:ring-forest-green focus:border-transparent"
                  placeholder="your.email@company.com"
                />
              </div>

              <!-- Company -->
              <div>
                <label for="company" class="block text-sm font-medium text-gray-700 mb-2">
                  Company
                </label>
                <input 
                  type="text" 
                  id="company" 
                  name="company"
                  class="w-full px-4 py-3 border border-gray-300 rounded-md focus:ring-2 focus:ring-forest-green focus:border-transparent"
                  placeholder="Your company name"
                />
              </div>

              <!-- Phone Number -->
              <div>
                <label for="phone" class="block text-sm font-medium text-gray-700 mb-2">
                  Phone Number
                </label>
                <input 
                  type="tel" 
                  id="phone" 
                  name="phone"
                  class="w-full px-4 py-3 border border-gray-300 rounded-md focus:ring-2 focus:ring-forest-green focus:border-transparent"
                  placeholder="+1 (555) 123-4567"
                />
              </div>

              <!-- Project Type -->
              <div>
                <label for="project-type" class="block text-sm font-medium text-gray-700 mb-2">
                  Project Type
                </label>
                <select 
                  id="project-type" 
                  name="Project Type"
                  class="w-full px-4 py-3 border border-gray-300 rounded-md focus:ring-2 focus:ring-forest-green focus:border-transparent"
                >
                  <option value="">Select a service</option>
                  <option value="Bespoke Corporate Gifts">Bespoke Corporate Gifts</option>
                  <option value="Exclusive Branded Merchandise">Exclusive Branded Merchandise</option>
                  <option value="Co-Branded Creations">Co-Branded Creations</option>
                  <option value="Consultation Only">Consultation Only</option>
                  <option value="Other">Other</option>
                </select>
              </div>

              <!-- Budget Range -->
              <div>
                <label for="budget" class="block text-sm font-medium text-gray-700 mb-2">
                  Budget Range (Optional)
                </label>
                <select 
                  id="budget" 
                  name="Budget Range"
                  class="w-full px-4 py-3 border border-gray-300 rounded-md focus:ring-2 focus:ring-forest-green focus:border-transparent"
                >
                  <option value="">Select budget range</option>
                  <option value="Under $5,000">Under $5,000</option>
                  <option value="$5,000 - $15,000">$5,000 - $15,000</option>
                  <option value="$15,000 - $50,000">$15,000 - $50,000</option>
                  <option value="$50,000+">$50,000+</option>
                  <option value="Let's discuss">Let's discuss</option>
                </select>
              </div>

              <!-- Timeline -->
              <div>
                <label for="timeline" class="block text-sm font-medium text-gray-700 mb-2">
                  Project Timeline
                </label>
                <select 
                  id="timeline" 
                  name="Timeline"
                  class="w-full px-4 py-3 border border-gray-300 rounded-md focus:ring-2 focus:ring-forest-green focus:border-transparent"
                >
                  <option value="">Select timeline</option>
                  <option value="As soon as possible">As soon as possible</option>
                  <option value="Within 1 month">Within 1 month</option>
                  <option value="Within 3 months">Within 3 months</option>
                  <option value="Within 6 months">Within 6 months</option>
                  <option value="Flexible">Flexible</option>
                </select>
              </div>

              <!-- Message -->
              <div>
                <label for="message" class="block text-sm font-medium text-gray-700 mb-2">
                  Message *
                </label>
                <textarea 
                  id="message" 
                  name="message" 
                  rows="6" 
                  required
                  class="w-full px-4 py-3 border border-gray-300 rounded-md focus:ring-2 focus:ring-forest-green focus:border-transparent"
                  placeholder="Tell us about your project, goals, and any specific requirements or ideas you have in mind..."
                ></textarea>
              </div>

              <!-- ESG Goals -->
              <div>
                <label class="flex items-center">
                  <input 
                    type="checkbox" 
                    name="ESG Initiative" 
                    value="Yes"
                    class="mr-3 h-4 w-4 text-forest-green focus:ring-forest-green border-gray-300 rounded"
                  />
                  <span class="text-sm text-gray-700">
                    This project is part of our ESG (Environmental, Social, Governance) initiatives
                  </span>
                </label>
              </div>

              <!-- Newsletter -->
              <div>
                <label class="flex items-center">
                  <input 
                    type="checkbox" 
                    name="Newsletter Subscription" 
                    value="Yes"
                    class="mr-3 h-4 w-4 text-forest-green focus:ring-forest-green border-gray-300 rounded"
                  />
                  <span class="text-sm text-gray-700">
                    I'd like to receive updates about Ecorazón's work and sustainability tips
                  </span>
                </label>
              </div>

              <!-- Honeypot for spam protection -->
              <input type="checkbox" name="botcheck" class="hidden" style="display: none;">

              <!-- Submit Button -->
              <button 
                type="submit"
                class="w-full bg-forest-green text-white py-3 px-6 rounded-md text-lg font-semibold hover:bg-deep-olive transition-colors"
              >
                Send Message
              </button>
            </form>
          </div>

          <!-- Contact Information -->
          <div class="space-y-8">
            
            <!-- Contact Details -->
            <div class="bg-warm-beige p-8 rounded-lg">
              <h3 class="text-2xl font-bold text-forest-green mb-6">Get in Touch</h3>
              
              <div class="space-y-4">
                <div class="flex items-start">
                  <div class="text-2xl mr-4">📩</div>
                  <div>
                    <h4 class="font-semibold text-forest-green">Email</h4>
                    <p class="text-gray-700">{contact.contactInfo.email}</p>
                    <p class="text-gray-600 text-sm">{contact.contactInfo.emailNote}</p>
                  </div>
                </div>
                
                <div class="flex items-start">
                  <div class="text-2xl mr-4">⏰</div>
                  <div>
                    <h4 class="font-semibold text-forest-green">Response Time</h4>
                    <p class="text-gray-700">{contact.contactInfo.responseTime}</p>
                    <p class="text-gray-600 text-sm">{contact.contactInfo.responseTimeNote}</p>
                  </div>
                </div>
                
                <div class="flex items-start">
                  <div class="text-2xl mr-4">🌍</div>
                  <div>
                    <h4 class="font-semibold text-forest-green">Location</h4>
                    <p class="text-gray-700">{contact.contactInfo.location}</p>
                    <p class="text-gray-600 text-sm">{contact.contactInfo.locationNote}</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- What to Expect -->
            <div class="bg-white border-2 border-forest-green p-8 rounded-lg">
              <h3 class="text-2xl font-bold text-forest-green mb-6">What Happens Next?</h3>
              
              <div class="space-y-4">
                {contact.whatHappensNext.map((step, i) => (
                  <div class="flex items-start">
                    <div class={`${stepColors[i % stepColors.length]} text-white rounded-full w-8 h-8 flex items-center justify-center text-sm font-bold mr-4 mt-1`}>
                      {i + 1}
                    </div>
                    <div>
                      <h4 class="font-semibold text-forest-green">{step.title}</h4>
                      <p class="text-gray-700 text-sm">{step.desc}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <!-- Why Choose Us -->
            <div>
              <h3 class="text-2xl font-bold text-forest-green mb-6">Why Partner with Us?</h3>
              
              <div class="space-y-4">
                {contact.whyPartner.map((item) => (
                  <div class="flex items-start">
                    <div class="text-xl mr-3">{item.icon}</div>
                    <div>
                      <h4 class="font-semibold text-forest-green">{item.title}</h4>
                      <p class="text-gray-700 text-sm">{item.desc}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>

          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-16 bg-warm-beige">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-forest-green mb-6">
            Frequently Asked Questions
          </h2>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="space-y-6">
            {faqCol1.map((item) => (
              <div>
                <h4 class="text-lg font-semibold text-forest-green mb-2">{item.question}</h4>
                <p class="text-gray-700">{item.answer}</p>
              </div>
            ))}
          </div>
          
          <div class="space-y-6">
            {faqCol2.map((item) => (
              <div>
                <h4 class="text-lg font-semibold text-forest-green mb-2">{item.question}</h4>
                <p class="text-gray-700">{item.answer}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Alternative Contact Methods -->
    <section class="py-16 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-forest-green mb-6">
            Other Ways to Connect
          </h2>
          <p class="text-lg text-gray-700 max-w-3xl mx-auto">
            Choose the communication method that works best for you
          </p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {contact.otherWaysToConnect.map((item) => (
            <div class="text-center p-6">
              <div class="text-4xl mb-4">{item.icon}</div>
              <h3 class="text-xl font-semibold text-forest-green mb-3">{item.title}</h3>
              <p class="text-gray-700 mb-4">{item.desc}</p>
              <a href={`mailto:${contact.contactInfo.email}?subject=${encodeURIComponent(item.mailtoSubject)}`} class="text-forest-green font-semibold hover:text-deep-olive transition-colors">
                {item.linkLabel}
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Final CTA Section -->
    <section class="py-16 bg-forest-green text-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">
          {contact.finalCta.title}
        </h2>
        <p class="text-xl text-gray-200 mb-8 max-w-3xl mx-auto">
          {contact.finalCta.subtitle}
        </p>
        <div class="space-x-4">
          <a href="#contact-form" class="inline-block bg-white text-forest-green px-8 py-3 rounded-md text-lg font-semibold hover:bg-gray-100 transition-colors">
            Start Your Project
          </a>
          <a href="/programme" class="inline-block border-2 border-white text-white px-8 py-3 rounded-md text-lg font-semibold hover:bg-white hover:text-forest-green transition-colors">
            View Our Work
          </a>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>

<script>
  // Show success message if redirected back with success parameter
  if (window.location.search.includes('success=true')) {
    const successMessage = document.getElementById('success-message');
    if (successMessage) {
      successMessage.classList.remove('hidden');
      successMessage.scrollIntoView({ behavior: 'smooth', block: 'center' });
      
      // Remove the success parameter from URL
      window.history.replaceState({}, '', '/get-in-touch');
    }
  }

  // Smooth scrolling for anchor links
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', (e) => {
      e.preventDefault();
      const href = anchor.getAttribute('href');
      const target = document.querySelector(href || '');
      if (target) {
        target.scrollIntoView({
          behavior: 'smooth',
          block: 'start'
        });
      }
    });
  });
</script>