---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Projects - Ecorazón">
  <Header />

  <main class="projects-page">

    <section class="projects-hero">
      <h1 class="projects-title">Projects</h1>
      <p class="projects-sub">Four ideas, one lab. Slide through them.</p>
    </section>

    <section class="showcase" id="showcase" aria-label="Ecorazón projects">

      <div class="showcase-viewport" tabindex="0">
        <div class="showcase-track">

          <!-- Ecorazón -->
          <article class="showcase-slide is-active">
            <div class="showcase-text">
              <p class="showcase-kicker">Ecorazón</p>
              <h2 class="showcase-heading">Custom corporate gifts</h2>
              <p>Custom corporate gifts for brands that care about people, planet and purpose.</p>
              <a class="btn" href="/services">See our services</a>
            </div>
            <div class="showcase-photos">
              <div class="ph ph-1" style="--a:#95BD8D;--b:#275D2F"><span>Placeholder</span></div>
              <div class="ph ph-2" style="--a:#cfe3c9;--b:#5f8f63"><span>Placeholder</span></div>
              <div class="ph ph-3" style="--a:#e8d9c2;--b:#a98a5f"><span>Placeholder</span></div>
            </div>
          </article>

          <!-- 01 HKArtWalk -->
          <article class="showcase-slide">
            <div class="showcase-text">
              <p class="showcase-kicker">01 — HKArtWalk</p>
              <h2 class="showcase-heading">Hong Kong Cultural Walking Experiences</h2>
              <p>HKArtWalk invites people to discover Hong Kong through art, food, ecology and local stories.</p>
              <p>Explore cultural walking experiences that connect places with the stories and communities behind them.</p>
              <a class="btn" href="https://hkartwalk.org" target="_blank" rel="noopener">Explore HKArtWalk ↗</a>
            </div>
            <div class="showcase-photos">
              <div class="ph ph-1" style="--a:#9db9c9;--b:#5d7f94"><span>Placeholder</span></div>
              <div class="ph ph-2" style="--a:#6b6a63;--b:#2a2a27"><span>Placeholder</span></div>
              <div class="ph ph-3" style="--a:#f0b777;--b:#7a5a7e"><span>Placeholder</span></div>
            </div>
          </article>

          <!-- 02 Peaceful Artopia -->
          <article class="showcase-slide">
            <div class="showcase-text">
              <p class="showcase-kicker">02 — Peaceful Artopia</p>
              <h2 class="showcase-heading">Inclusive Art &amp; Creative Careers</h2>
              <p>Peaceful Artopia connects neurodivergent young artists with communities through exhibitions, cultural experiences and creative collaborations. Rooted in Cheung Chau and powered by the Neurodivergent Artist Career Ecosystem (NACE), it builds pathways towards recognition, commissions and sustainable creative livelihoods.</p>
            </div>
            <div class="showcase-photos">
              <div class="ph ph-1" style="--a:#e6b3c4;--b:#a1567a"><span>Placeholder</span></div>
              <div class="ph ph-2" style="--a:#c9d9a8;--b:#6e9a62"><span>Placeholder</span></div>
              <div class="ph ph-3" style="--a:#a9c6d8;--b:#3f6b8a"><span>Placeholder</span></div>
            </div>
          </article>

          <!-- 03 Neuroseed -->
          <article class="showcase-slide">
            <div class="showcase-text">
              <p class="showcase-kicker">03 — Neuroseed</p>
              <h2 class="showcase-heading">Brain Science Through Play</h2>
              <p>Neuroseed brings neuroscience to life through gamified, experiential learning, helping all walks of life explore brain development, stress, supportive relationships and trauma-informed care.</p>

              <div class="showcase-sub">
                <h3>Brainy In-Charge</h3>
                <p>An experiential board game that uses role-play and simulation to explore how everyday interactions and environments shape children’s brain development.</p>
                <a class="btn" href="#">Explore the Board Game</a> <!-- TODO: real link -->
              </div>

              <div class="showcase-sub">
                <h3>NeuroSeed Train-the-Trainer Programme</h3>
                <p>A programme for facilitators preparing to guide NeuroSeed learning experiences.</p>
                <a class="btn" href="#">Explore the Training</a> <!-- TODO: real link -->
              </div>
            </div>
            <div class="showcase-photos">
              <div class="ph ph-1" style="--a:#f3d27a;--b:#c8793a"><span>Placeholder</span></div>
              <div class="ph ph-2" style="--a:#b9a7e0;--b:#5a4a9a"><span>Placeholder</span></div>
              <div class="ph ph-3" style="--a:#8fd0c0;--b:#2f7d73"><span>Placeholder</span></div>
            </div>
          </article>

        </div>
      </div>

      <!-- pagination: small image thumbnails (swap background for real photos later) -->
      <nav class="showcase-thumbs" aria-label="Slide navigation">
        <button class="showcase-thumb is-active" type="button" aria-label="Ecorazón" aria-current="true" style="--a:#95BD8D;--b:#275D2F"></button>
        <button class="showcase-thumb" type="button" aria-label="01 HKArtWalk" style="--a:#9db9c9;--b:#5d7f94"></button>
        <button class="showcase-thumb" type="button" aria-label="02 Peaceful Artopia" style="--a:#e6b3c4;--b:#a1567a"></button>
        <button class="showcase-thumb" type="button" aria-label="03 Neuroseed" style="--a:#f3d27a;--b:#c8793a"></button>
      </nav>

    </section>
  </main>

  <Footer />
</Layout>

<style is:global>
  .projects-page { padding-top: 72px; font-family: 'DM Sans', sans-serif; color: #000; }

  .projects-hero { padding: 5rem clamp(2rem, 8vw, 7rem) 1rem; }
  .projects-title { font-weight: 700; font-size: clamp(2rem, 4vw, 3.5rem); margin: 0 0 .5rem; line-height: 1.1; }
  .projects-sub { margin: 0; opacity: .65; }

  .btn { display: inline-block; margin-top: 1.25rem; padding: .6rem 1.4rem; background: #95BD8D; color: #fff; font-weight: 600; text-decoration: none; transition: background .2s; }
  .btn:hover { background: #C08EA4; }

  /* ─── SHOWCASE (horizontal drag slider) ─── */
  .showcase {
    background: #f3f0ea;
    padding: 4rem 0 3.5rem;
    overflow: hidden;
    --slide-w: min(1100px, 82vw);
  }

  .showcase-viewport {
    overflow: hidden;
    cursor: grab;
    touch-action: pan-y;      /* vertical page scroll still works on touch */
    outline: none;
    user-select: none;
  }
  .showcase-viewport.is-dragging { cursor: grabbing; }

  .showcase-track {
    display: flex;
    gap: 4vw;
    width: max-content;
    transition: transform 1s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }
  .showcase-track.no-anim { transition: none; }

  .showcase-slide {
    flex: 0 0 var(--slide-w);
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: 3rem;
    min-height: 520px;
    opacity: 0.35;
    transform: scale(0.96);
    transition: opacity 0.8s ease, transform 0.8s ease;
  }
  .showcase-slide.is-active { opacity: 1; transform: scale(1); }

  .showcase-kicker {
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 600;
    opacity: .6;
    margin: 0 0 .75rem;
  }
  .showcase-heading {
    font-weight: 700;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    line-height: 1.15;
    margin: 0 0 1rem;
  }
  .showcase-text p { line-height: 1.8; margin: 0 0 .75rem; max-width: 52ch; }

  .showcase-sub { margin-top: 1.25rem; padding-top: 1rem; border-top: 1px solid rgba(0, 0, 0, 0.12); }
  .showcase-sub h3 { font-weight: 700; font-size: 1.05rem; margin: 0 0 .35rem; }
  .showcase-sub .btn { margin-top: .5rem; }

  /* photo collage */
  .showcase-photos { position: relative; width: 100%; aspect-ratio: 1.25 / 1; }
  .ph {
    position: absolute;
    border-radius: 10px;
    overflow: hidden;
    background: linear-gradient(135deg, var(--a, #ccc), var(--b, #888));
    box-shadow: 0 14px 30px rgba(0, 0, 0, 0.18);
    display: flex;
    align-items: flex-end;
    pointer-events: none;
  }
  .ph span { font-size: .7rem; color: rgba(255,255,255,.85); padding: .5rem .7rem; }
  .ph img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .ph-1 { left: 0;   top: 24%; width: 52%; height: 44%; transform: rotate(-4deg); }
  .ph-2 { left: 36%; top: 2%;  width: 32%; height: 64%; transform: rotate(1deg); z-index: 2; }
  .ph-3 { left: 62%; top: 10%; width: 34%; height: 66%; transform: rotate(4deg); z-index: 3; }

  /* pagination: tiny image thumbnails */
  .showcase-thumbs { display: flex; justify-content: center; align-items: center; gap: .5rem; margin-top: 2.5rem; }
  .showcase-thumb {
    width: 38px; height: 28px;
    border: none; padding: 0; border-radius: 4px; cursor: pointer;
    background: linear-gradient(135deg, var(--a, #ccc), var(--b, #888));
    background-size: cover; background-position: center;
    opacity: .45;
    box-shadow: 0 2px 6px rgba(0, 0, 0, .15);
    transition: width .5s cubic-bezier(.22, 1, .36, 1), height .5s cubic-bezier(.22, 1, .36, 1), opacity .3s ease, transform .3s ease;
  }
  .showcase-thumb:hover { opacity: .8; transform: translateY(-2px); }
  .showcase-thumb.is-active { width: 72px; height: 46px; opacity: 1; outline: 2px solid #fff; box-shadow: 0 6px 14px rgba(0, 0, 0, .25); }
  .showcase-thumb:focus-visible { outline: 2px solid #000; outline-offset: 3px; }

  @media (max-width: 768px) {
    .showcase { padding: 3rem 0 2.5rem; --slide-w: 86vw; }
    .showcase-slide { grid-template-columns: 1fr; gap: 1.5rem; min-height: 0; }
    .showcase-photos { order: -1; aspect-ratio: 1.4 / 1; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const root = document.getElementById('showcase');
    if (!root) return;

    const viewport = root.querySelector<HTMLElement>('.showcase-viewport')!;
    const track = root.querySelector<HTMLElement>('.showcase-track')!;
    const slides = Array.from(root.querySelectorAll<HTMLElement>('.showcase-slide'));
    const thumbs = Array.from(root.querySelectorAll<HTMLButtonElement>('.showcase-thumb'));

    let index = 0;
    let baseX = 0;
    let startX = 0;
    let dx = 0;
    let pressed = false;
    let dragging = false;

    // x-offset that centres slide i in the viewport (neighbours peek in)
    const offsetFor = (i: number) =>
      (viewport.clientWidth - slides[i].offsetWidth) / 2 - slides[i].offsetLeft;

    function go(i: number, animate = true) {
      index = Math.max(0, Math.min(slides.length - 1, i));
      baseX = offsetFor(index);
      track.classList.toggle('no-anim', !animate);
      track.style.transform = `translate3d(${baseX}px, 0, 0)`;
      slides.forEach((s, n) => s.classList.toggle('is-active', n === index));
      thumbs.forEach((t, n) => {
        t.classList.toggle('is-active', n === index);
        if (n === index) t.setAttribute('aria-current', 'true');
        else t.removeAttribute('aria-current');
      });
    }

    thumbs.forEach((t, n) => t.addEventListener('click', () => go(n)));

    // ── drag / swipe ──
    viewport.addEventListener('pointerdown', (e: PointerEvent) => {
      pressed = true;
      dragging = false;
      startX = e.clientX;
      dx = 0;
    });

    viewport.addEventListener('pointermove', (e: PointerEvent) => {
      if (!pressed) return;
      dx = e.clientX - startX;
      if (!dragging && Math.abs(dx) > 6) {
        dragging = true;
        viewport.setPointerCapture(e.pointerId);
        viewport.classList.add('is-dragging');
        track.classList.add('no-anim');
      }
      if (dragging) {
        // rubber-band at the ends
        const atEdge = (index === 0 && dx > 0) || (index === slides.length - 1 && dx < 0);
        track.style.transform = `translate3d(${baseX + (atEdge ? dx * 0.3 : dx)}px, 0, 0)`;
      }
    });

    function endDrag() {
      if (!pressed) return;
      pressed = false;
      viewport.classList.remove('is-dragging');
      if (dragging) {
        const threshold = Math.min(120, viewport.clientWidth * 0.15);
        if (dx < -threshold) go(index + 1);
        else if (dx > threshold) go(index - 1);
        else go(index);
      }
      // keep `dragging` true until after the click event so links don't fire
      setTimeout(() => { dragging = false; }, 0);
    }
    viewport.addEventListener('pointerup', endDrag);
    viewport.addEventListener('pointercancel', endDrag);

    // block link clicks that were really drags
    viewport.addEventListener('click', (e) => {
      if (dragging) { e.preventDefault(); e.stopPropagation(); }
    }, true);

    // stop native image/link dragging from hijacking the gesture
    viewport.addEventListener('dragstart', (e) => e.preventDefault());

    // keyboard
    viewport.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowRight') go(index + 1);
      if (e.key === 'ArrowLeft') go(index - 1);
    });

    window.addEventListener('resize', () => go(index, false));
    go(0, false);
  });
</script>