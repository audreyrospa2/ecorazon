  /* ─── C.Y.C.L.E. LIBRARY SHELF ─── */
  .lib-hero,
  .lib-hero *,
  .lib-hero *::before,
  .lib-hero *::after { box-sizing: border-box; }

  .lib-hero {
    height: 100vh;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;   /* still centers .lib-head within the leftover space above the shelf */
    padding: 6rem clamp(1rem, 4vw, 3rem) 0;  /* bottom padding removed so the shelf can sit flush */
    background: #f7f5f0;
    overflow: hidden;
  }

  .lib-head {
    max-width: 640px;
    margin: 0 0 3rem;
    text-align: center;
    flex-shrink: 0;
  }

  .lib-intro {
    margin-left: auto;
    margin-right: auto;        /* max-width + auto margins center the paragraph block itself */
  }

  .lib-title {
    font-family: 'MaoWei', sans-serif;
    font-weight: 700;
    font-size: clamp(2.75rem, 6vw, 4.5rem); 
    line-height: 1.1;
    color: #000;
    margin: 0 0 0.5rem;
  }

  .lib-tagline {
    font-family: 'MaoWei', sans-serif;
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    color: #6b8f76;
    margin: 0 0 1.25rem;
  }

  .lib-intro {
    font-family: 'MaoWei', sans-serif;
    font-size: 1.2rem;
    line-height: 1.7;
    color: rgba(0,0,0,0.65);
    max-width: 62ch;
    margin: 0;
  }

  /* ─── shelf ─── */
  .lib-shelf-viewport {
    position: relative;
    width: 100%;
    height: 420px;
    margin-top: auto;
    overflow: hidden;
    perspective: 1800px;
    cursor: grab;
    touch-action: pan-y;   /* let vertical page scroll pass through, we handle horizontal ourselves */
  }
  .lib-shelf-viewport.dragging {
    cursor: grabbing;
  }
  .lib-shelf-viewport::before,
  .lib-shelf-viewport::after {
    content: '';
    position: absolute;
    top: 0; bottom: 18px;
    width: min(10vw, 100px);
    z-index: 20;
    pointer-events: none;
  }
  .lib-shelf-viewport::before { left: 0; background: linear-gradient(90deg, #f7f5f0, transparent); }
  .lib-shelf-viewport::after  { right: 0; background: linear-gradient(270deg, #f7f5f0, transparent); }

  .lib-shelf-track {
    display: flex;
    align-items: flex-end;
    gap: 10px;
    width: max-content;
    will-change: transform;
    user-select: none;
  }

  .lib-board {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 18px;
    background: #ddd2ba;
    box-shadow: 0 12px 20px rgba(0,0,0,0.15);
  }

  /* real width transition — this is what pushes siblings aside.
     width now driven by --w / --open-w custom properties so JS
     only ever needs to toggle the .is-open class, on click. */
  .lib-book {
    position: relative;
    flex: 0 0 auto;
    width: var(--w);
    transform-style: preserve-3d;
    transition: width 0.55s cubic-bezier(.22,.9,.34,1);
    cursor: pointer;
  }

  .lib-book.is-open {
    width: var(--open-w, 230px);
  }

  /* fore-edge — the sliver of "pages" peeking out past the spine,
     this is what stops each book reading as a flat colour block */
  .lib-book::after {
    content: '';
    position: absolute;
    top: 5px;
    bottom: 5px;
    right: -4px;
    width: 7px;
    background: repeating-linear-gradient(
      to bottom,
      #f6efe1 0px, #f6efe1 2px,
      #e4d7bf 2px, #e4d7bf 3px
    );
    border-radius: 0 3px 3px 0;
    box-shadow: 2px 2px 5px rgba(0,0,0,0.18);
    z-index: 1;
  }

  .lib-spine {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    writing-mode: vertical-rl;
    text-orientation: mixed;
    font-family: 'MaoWei', sans-serif;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: rgba(255,255,255,0.92);
    padding: 1.4rem 0;
    border-radius: 2px 6px 6px 2px;
    z-index: 2;
    box-shadow:
      inset -5px 0 10px rgba(0,0,0,0.18),
      inset 3px 0 6px rgba(255,255,255,0.12),
      0 10px 16px rgba(0,0,0,0.2);
  }
  .lib-spine span {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-height: 100%;
  }

  /* headbands — the little woven caps real hardcovers have at the
     top and bottom of the spine */
  .lib-spine::before,
  .lib-spine::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 8px;
    background: repeating-linear-gradient(
      90deg,
      rgba(255,255,255,0.55) 0 3px,
      rgba(0,0,0,0.18) 3px 6px
    );
  }
  .lib-spine::before {
    top: 0;
    border-radius: 2px 6px 0 0;
  }
  .lib-spine::after {
    bottom: 0;
    border-radius: 0 0 6px 2px;
  }

  /* cover fills whatever the book's current width is — since the
     book itself now grows on click (not hover) this can't overlap
     a neighbour mid-drag, only once a click is confirmed */
  .lib-cover {
    position: absolute;
    inset: 0;
    transform-origin: left center;
    backface-visibility: hidden;
    transform: rotateY(90deg);
    transition: transform 0.55s cubic-bezier(.22,.9,.34,1);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.25rem 1.35rem;
    border-radius: 2px 6px 6px 2px;
    box-shadow: 0 22px 40px rgba(0,0,0,0.35);
    z-index: 3;
  }
  .lib-cover h4 {
    font-family: 'MaoWei', sans-serif;
    font-weight: 700;
    font-size: 1.05rem;
    line-height: 1.2;
    color: #fff;
    margin: 0 0 0.5rem;
  }
  .lib-cover a {
    font-family: 'MaoWei', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    color: #fff;
    text-decoration: none;
    align-self: flex-start;
    border-bottom: 1px solid rgba(255,255,255,0.6);
    padding-bottom: 2px;
  }

  /* flip is now click-triggered (via .is-open, toggled in JS)
     instead of :hover, so dragging the shelf never fights with a
     book trying to open mid-swipe */
  .lib-book.is-open .lib-cover {
    transform: rotateY(0deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .lib-book, .lib-cover { transition: none; }
  }

