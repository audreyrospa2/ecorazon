  font-size: 1.2rem;
  cursor: pointer;
  transition: background 0.25s ease, color 0.25s ease, transform 0.2s ease;
}
.courses-arrow:hover { background: #6b8f76; color: #fff; transform: translateY(-2px); }

.courses-track {
