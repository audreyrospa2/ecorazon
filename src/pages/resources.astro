    align-items: center;
    justify-content: center;
    padding: 5rem clamp(1rem, 4vw, 3rem) 3rem;
    background: #f7f5f0;
  }
 
  .showcase-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    width: 100%;
    max-width: 1120px;
  }
 
  /* ── left column ── */
