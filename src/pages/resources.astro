---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Get all published blog posts, sorted by date (newest first)
const allPosts = await getCollection('blog', ({ data }: CollectionEntry<'blog'>) => {
  return data.draft !== true;
});

const sortedPosts = allPosts.sort((a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) => 
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const featuredPosts = sortedPosts.slice(0, 2);
const latestPosts = sortedPosts.slice(2, 8);

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('en-US', { 
    year: 'numeric', 
    month: 'short' 
  }).format(new Date(date));
}

function getCategoryTag(category: string) {
  const tags: Record<string, string> = {
    'Artist Stories': 'green',
    'Materials': 'olive',
    'Impact': 'olive',
    'Partnerships': 'olive',
    'Tips': 'green',
    'Innovation': 'brown',
    'Community': 'olive',
  };
  return tags[category] || 'green';
}
---

<Layout title="Resources - Ecorazón">
  <Header />

  <main class="resources-page">

    <!-- Think Tank Hero -->
    <section class="tt-hero">
      <div class="tt-hero-head">
        <h1 class="tt-title animate-fade-in">Ecorazón Think Tank</h1>
        <p class="tt-subtitle animate-fade-in-delay">The Knowledge Commons for ideas, evidence and alliances towards a more empathetic economy.</p>
      </div>
    
      <div class="tt-stack-wrap">
        <div class="tt-stack" id="ttStack">
          <button class="tt-card" data-index="0">
            <div class="tt-card-top">
              <span class="tt-card-step">01</span>
            </div>
            <div class="tt-card-bottom">
              <h3 class="tt-card-title">The C.Y.C.L.E. Library</h3>
              <p class="tt-card-desc">A living archive of research, case studies and toolkits on circular materials, dignified labor and community-rooted design — open to anyone building a more empathetic economy.</p>
              <a href="#lib-hero" class="tt-card-link">Explore →</a>
            </div>
          </button>
    
          <button class="tt-card" data-index="1">
            <div class="tt-card-top">
              <span class="tt-card-step">02</span>
            </div>
            <div class="tt-card-bottom">
              <h3 class="tt-card-title">Project Showcase</h3>
              <p class="tt-card-desc">Real initiatives from our network of artists, cooperatives and partners — documented from first sketch to finished impact, with the people and numbers behind them.</p>
              <a href="#showcase-hero" class="tt-card-link">Explore →</a>
            </div>
          </button>
    
          <button class="tt-card" data-index="2">
            <div class="tt-card-top">
              <span class="tt-card-step">03</span>
            </div>
            <div class="tt-card-bottom">
              <h3 class="tt-card-title">Human Sustainability Academy</h3>
              <p class="tt-card-desc">Workshops and learning pathways for teams and artisans alike, covering wellbeing, fair practice and the human side of sustainable business.</p>
              <a href="#academy-hero" class="tt-card-link">Explore →</a>
            </div>
          </button>
    
          <button class="tt-card" data-index="3">
            <div class="tt-card-top">
              <span class="tt-card-step">04</span>
            </div>
            <div class="tt-card-bottom">
              <h3 class="tt-card-title">Strategic Partners</h3>
              <p class="tt-card-desc">The organizations, foundations and companies co-building this commons with us — and how your team can join the alliance.</p>
              <a href="#partners-hero" class="tt-card-link">Explore →</a>
            </div>
          </button>
        </div>
      </div>
    </section>

    <!-- Ecorazón Academy -->
    <section class="acad-hero" id="academy-hero">
      <div class="acad-top">
        <span class="acad-pill acad-pill--1">#Wellbeing</span>
        <span class="acad-pill acad-pill--2">#FairPractice</span>
        <span class="acad-pill acad-pill--3">#Workshops</span>
        <span class="acad-pill acad-pill--4">#Community</span>
        <span class="acad-pill acad-pill--5">#Skills</span>

        <svg class="acad-mark animate-fade-in" viewBox="0 0 80 100" width="64" height="80" fill="none" stroke="#fff" stroke-width="2" aria-hidden="true">
          <ellipse cx="40" cy="50" rx="34" ry="46" />
          <ellipse cx="40" cy="50" rx="14" ry="46" />
          <circle cx="40" cy="50" r="2" fill="#fff" />
        </svg>

        <h2 class="acad-title animate-fade-in">Ecorazón Academy</h2>
        <p class="acad-intro animate-fade-in-delay">Explore our full range of courses and workshops across different topics, and register for the experience that's right for you.</p>
        <a href="#" class="acad-cta animate-fade-in-delay">Get Started <span aria-hidden="true">→</span></a>
      </div>

      <div class="acad-why">
        <h3 class="acad-why-title">
          Why Ecorazón Academy?
          <span>Learning through play.<br />Mastering skills that stay.</span>
        </h3>
        <div class="acad-feature">
          <div class="acad-feature-icon" aria-hidden="true"></div>
          <h4>Practical skills for real life</h4>
          <p>Learn skills you can put into practice—in everyday life, relationships and work.</p>
        </div>
      </div>
    </section>

    <!-- Academy Courses Carousel -->
    <section class="courses-hero" id="courses-hero">
      <div class="courses-head">
        <h3 class="courses-title">Our Courses</h3>
        <div class="courses-nav">
          <button type="button" class="courses-arrow" id="coursesPrev" aria-label="Previous courses">←</button>
          <button type="button" class="courses-arrow" id="coursesNext" aria-label="Next courses">→</button>
        </div>
      </div>

      <div class="courses-track" id="coursesTrack">

        <article class="course-card">
          <div class="course-media" style="--media: linear-gradient(135deg,#cfe4c9,#6b8f76);">
            <div class="course-badges">
              <span class="course-badge">Online</span>
              <span class="course-badge course-badge--dark">Featured</span>
            </div>
          </div>
          <div class="course-body">
            <h4 class="course-name">Neuroseed Train-the-Trainer Programme</h4>
            <div class="course-tags">
              <span class="course-tag course-tag--green">#Facilitation</span>
              <span class="course-tag course-tag--blue">#ForTrainers</span>
            </div>
            <div class="course-stats">
              <div><small>Theory</small><strong>00 hrs</strong></div>
              <div><small>Practice</small><strong>00 hrs</strong></div>
            </div>
          </div>
          <div class="course-foot">
            <span class="course-instructor">Instructor name</span>
            <button type="button" class="course-btn" data-course-open>Details <span aria-hidden="true">↗</span></button>
          </div>
        </article>

        <article class="course-card">
          <div class="course-media" style="--media: linear-gradient(135deg,#eeccdc,#c48fa4);">
            <div class="course-badges">
              <span class="course-badge">In person</span>
            </div>
          </div>
          <div class="course-body">
            <h4 class="course-name">Mindful Workplaces: Wellbeing That Lasts</h4>
            <div class="course-tags">
              <span class="course-tag course-tag--pink">#Wellbeing</span>
              <span class="course-tag course-tag--green">#Teams</span>
            </div>
            <div class="course-stats">
              <div><small>Theory</small><strong>00 hrs</strong></div>
              <div><small>Practice</small><strong>00 hrs</strong></div>
            </div>
          </div>
          <div class="course-foot">
            <span class="course-instructor">Instructor name</span>
            <button type="button" class="course-btn" data-course-open>Details <span aria-hidden="true">↗</span></button>
          </div>
        </article>

        <article class="course-card">
          <div class="course-media" style="--media: linear-gradient(135deg,#e3cdb2,#a07850);">
            <div class="course-badges">
              <span class="course-badge">Online</span>
              <span class="course-badge">In person</span>
            </div>
          </div>
          <div class="course-body">
            <h4 class="course-name">Fair Practice for Creative Makers</h4>
            <div class="course-tags">
              <span class="course-tag course-tag--brown">#FairPractice</span>
              <span class="course-tag course-tag--blue">#Artists</span>
            </div>
            <div class="course-stats">
              <div><small>Theory</small><strong>00 hrs</strong></div>
              <div><small>Practice</small><strong>00 hrs</strong></div>
            </div>
          </div>
          <div class="course-foot">
            <span class="course-instructor">Instructor name</span>
            <button type="button" class="course-btn" data-course-open>Details <span aria-hidden="true">↗</span></button>
          </div>
        </article>

        <article class="course-card">
          <div class="course-media" style="--media: linear-gradient(135deg,#cfe4c9,#95BD8D);">
            <div class="course-badges">
              <span class="course-badge">In person</span>
            </div>
          </div>
          <div class="course-body">
            <h4 class="course-name">Community Workshop Design &amp; Facilitation</h4>
            <div class="course-tags">
              <span class="course-tag course-tag--green">#Community</span>
              <span class="course-tag course-tag--pink">#Workshops</span>
            </div>
            <div class="course-stats">
              <div><small>Theory</small><strong>00 hrs</strong></div>
              <div><small>Practice</small><strong>00 hrs</strong></div>
            </div>
          </div>
          <div class="course-foot">
            <span class="course-instructor">Instructor name</span>
            <button type="button" class="course-btn" data-course-open>Details <span aria-hidden="true">↗</span></button>
          </div>

          <template class="course-detail">
            <p class="cd-lead">A short overview of the programme goes here: who it's for and what they'll walk away with.</p>

            <div class="cd-grid">
              <div><small>Format</small><strong>Online</strong></div>
              <div><small>Duration</small><strong>00 weeks</strong></div>
              <div><small>Theory</small><strong>00 hrs</strong></div>
              <div><small>Practice</small><strong>00 hrs</strong></div>
              <div><small>Next intake</small><strong>TBC</strong></div>
              <div><small>Instructor</small><strong>Instructor name</strong></div>
            </div>

            <h5 class="cd-heading">What you'll learn</h5>
            <ul class="cd-list">
              <li>First learning outcome</li>
              <li>Second learning outcome</li>
              <li>Third learning outcome</li>
            </ul>

            <a href="/get-in-touch" class="course-btn cd-register">Register interest</a>
          </template>
        </article>

      </div>
    </section>
    <div class="course-modal" id="courseModal" hidden>
      <div class="course-modal-backdrop" data-close></div>
      <div class="course-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="courseModalTitle">
        <button type="button" class="course-modal-close" data-close aria-label="Close">×</button>
        <div class="course-modal-media" id="courseModalMedia"></div>
        <div class="course-modal-content" id="courseModalContent"></div>
      </div>
    </div>

    <!-- Strategic Partners -->
    <section class="partners-hero" id="partners-hero">
      <div class="partners-head">
        <h2 class="partners-title animate-fade-in">Strategic Partners</h2>
        <p class="partners-tagline animate-fade-in-delay">Shared values. Greater impact.</p>
        <p class="partners-intro animate-fade-in-delay">Together, we connect expertise, resources and communities to create solutions that no one organisation could build alone.</p>
        <p class="partners-intro animate-fade-in-delay">We collaborate with educators, artists, community organisations, social innovators and technology partners who believe progress should be human, responsible and shared.</p>
      </div>

      <div class="partners-rows" id="partnersRows">
        <div class="partners-row" data-direction="left" data-duration="34s">
          <div class="partners-track" id="partnersRow1"></div>
        </div>
        <div class="partners-row" data-direction="right" data-duration="40s">
          <div class="partners-track" id="partnersRow2"></div>
        </div>
      </div>
    </section>

    <!-- Project Showcase -->
    <section class="showcase-hero" id="showcase-hero">
      <div class="showcase-head">
        <h2 class="showcase-title animate-fade-in">Project Showroom</h2>
        <p class="showcase-tagline animate-fade-in-delay">Ideas, made visible.</p>
        <p class="showcase-intro animate-fade-in-delay">Discover projects, pilot programmes and case studies that bring research into the real world. From ESG and CSR initiatives to inclusive arts, employee wellbeing, co-creation workshops and responsible technology experiments — each project shows how insight can become shared impact.</p>
      </div>

      <div class="showcase-stack">

        <div class="showcase-card">
          <div class="showcase-tab"><span class="showcase-tab-title">Corporate Culture &amp; Wellbeing</span></div>
          <div class="showcase-card-head">
            <span class="showcase-card-subtitle">Where work feels human</span>
            <span class="showcase-chevron">⌄</span>
          </div>
          <div class="showcase-card-body">
            <p>Rituals, spaces and small interventions that help teams feel seen — from onboarding gifts to wellbeing pilots run inside partner offices.</p>
          </div>
        </div>

        <div class="showcase-card">
          <div class="showcase-tab"><span class="showcase-tab-title">Inclusive Arts &amp; Community</span></div>
          <div class="showcase-card-head">
            <span class="showcase-card-subtitle">Art that makes room</span>
            <span class="showcase-chevron">⌄</span>
          </div>
          <div class="showcase-card-body">
            <p>Co-created works and community workshops that widen who gets to make and be seen — built alongside the artists and neighbourhoods involved.</p>
          </div>
        </div>

        <div class="showcase-card">
          <div class="showcase-tab"><span class="showcase-tab-title">Sustainable Brand Experiences</span></div>
          <div class="showcase-card-head">
            <span class="showcase-card-subtitle">Less waste, more meaning</span>
            <span class="showcase-chevron">⌄</span>
          </div>
          <div class="showcase-card-body">
            <p>Gifting and brand moments designed around material honesty — sourcing, packaging and stories that hold up past the unboxing.</p>
          </div>
        </div>

        <div class="showcase-card">
          <div class="showcase-tab"><span class="showcase-tab-title">Human-Centred AI Pilots</span></div>
          <div class="showcase-card-head">
            <span class="showcase-card-subtitle">Technology, kept accountable</span>
            <span class="showcase-chevron">⌄</span>
          </div>
          <div class="showcase-card-body">
            <p>Early experiments testing where AI genuinely helps a team or a customer — and where it should stay out of the way.</p>
          </div>
        </div>

      </div>
    </section>

    <!-- The C.Y.C.L.E. Library -->
    <section class="lib-hero" id="lib-hero">
      <div class="lib-head">
        <h2 class="lib-title animate-fade-in">The C.Y.C.L.E. Library</h2>
        <p class="lib-tagline animate-fade-in-delay">Ideas worth growing.</p>
        <p class="lib-intro animate-fade-in-delay">A curated digital library of research papers, white papers, trend reports and frameworks exploring empathy, sustainable development, inclusive design, social innovation and technology with purpose.</p>
      </div>

      <div class="lib-shelf-viewport">
        <div class="lib-shelf-track" id="libShelf"></div>
        <div class="lib-board"></div>
      </div>
    </section>


    <!-- From the Journal -->
    <section class="journal-hero" id="from-the-journal">
      <div class="journal-head">
        <h2 class="journal-title animate-fade-in">From the Journal</h2>
        <p class="journal-tagline animate-fade-in-delay">Stories, insights and updates.</p>
        <p class="journal-intro animate-fade-in-delay">Field notes from our artists, partners and team. Open a book on the shelf above to see the articles filed under that topic.</p>
      </div>
      <p class="journal-status" id="journalStatus" hidden></p>


      {featuredPosts.length > 0 && (
        <div class="journal-featured">
          {featuredPosts.map((post: CollectionEntry<'blog'>) => (
            <a
              href={`/blog/${post.id}`}
              class="journal-featured-card"
              data-tags={(post.data.tags ?? []).join('|')}
              data-category={post.data.category}
            >
              <img src={post.data.image} alt={post.data.imageAlt} class="journal-featured-img" />
              <div class="journal-featured-body">
                <span class={`journal-badge journal-badge--${getCategoryTag(post.data.category)}`}>{post.data.category}</span>
                <h3>{post.data.title}</h3>
                <p>{post.data.excerpt}</p>
                <span class="journal-date">{formatDate(post.data.date)}</span>
              </div>
            </a>
          ))}
        </div>
      )}

      <div class="journal-grid" id="journalGrid">
        {latestPosts.map((post: CollectionEntry<'blog'>) => (
          <a
            href={`/blog/${post.id}`}
            class="journal-card"
            data-tags={(post.data.tags ?? []).join('|')}
            data-category={post.data.category}
          >
            <img src={post.data.image} alt={post.data.imageAlt} class="journal-card-img" />
            <div class="journal-card-body">
              <div class="journal-card-meta">
                <span class={`journal-badge journal-badge--${getCategoryTag(post.data.category)}`}>{post.data.category}</span>
                <span class="journal-date">{formatDate(post.data.date)}</span>
              </div>
              <h3>{post.data.title}</h3>
              <p>{post.data.excerpt}</p>
              {post.data.tags && post.data.tags.length > 0 && (
                <div class="journal-card-tags">
                  {post.data.tags.map((t: string) => <span class="journal-chip">{t}</span>)}
                </div>
              )}
            </div>
          </a>
        ))}
      </div>

      <p class="journal-empty" id="journalEmpty" hidden>No articles match that tag yet — try another one.</p>
    </section>

  </main>

  <Footer />
</Layout>

<style is:global>
  /* ─── THINK TANK HERO ─── */
  .tt-hero,
  .tt-hero *,
  .tt-hero *::before,
  .tt-hero *::after {
    box-sizing: border-box;
  }
 
  .tt-hero {
    height: 100vh;
    height: 100dvh;          /* was: calc(100vh - 72px) / calc(100dvh - 72px) */
    display: flex;
    flex-direction: column;
    padding: 9rem clamp(1rem, 4vw, 3rem) 0;
    background: #f7f5f0;
    overflow: hidden;
  }
 
  .tt-hero-head {
    max-width: 720px;
    margin: 0 0 3rem 0;
    flex-shrink: 0;
  }
 
  .tt-title {
    font-family: 'MaoWei', sans-serif;
    font-weight: 700;
    font-size: clamp(2rem, 4.2vw, 3.4rem);
    line-height: 1.08;
    color: #000000;
    margin: 0 0 1rem 0;
  }
 
  .tt-subtitle {
    font-family: 'MaoWei', sans-serif;
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    color: #000000;
    opacity: 0.65;
    line-height: 1.6;
    margin: 0;
    max-width: 560px;
  }
 
  /* ─── STACK ─── */
  .tt-stack-wrap {
    flex: 1;
    min-height: 0;
    position: relative;
    width: 100%;
  }

  .tt-stack {
    position: relative;
    width: 100%;
    height: 100%;   /* was: flex: 1; min-height: 0; margin: 0 auto; */
  }
 
  .tt-card {
    position: absolute;
    bottom: 0;
    width: 95%;
    border: none;
    text-align: left;
    padding: 2.5rem 2.75rem;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    color: #ffffff;
    box-shadow: 0 18px 40px rgba(0,0,0,0.14);
    transition: transform 0.55s cubic-bezier(.4,0,.2,1), opacity 0.5s ease;
    will-change: transform, opacity;
    /* overflow: hidden;  <-- removed, this was clipping content that didn't fit */
    background-size: cover;
    background-position: center;
    border-radius: 12px; /* optional, since we lost the clipped corners overflow:hidden gave us on the background — add this back if you want rounded corners on the bg image itself */
  }
 
  /* color tint sits over the background image; swap background-image
     for the real photo per card below, the tint stays as-is */
  .tt-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--tint);
    opacity: 0.82;
    z-index: 0;
  }
 
  .tt-card-top,
  .tt-card-bottom {
    position: relative;
    z-index: 1;
  }
 
  .tt-card:focus-visible {
    outline: 3px solid #000000;
    outline-offset: 3px;
  }
 
  .tt-card[data-index="0"] {
    left: 0%;
    height: 64%;
    min-height: 320px;   /* NEW — guarantees room for step number + title + desc + link */
    --tint: #6b8f76;
    background-image: linear-gradient(135deg, #cfd9c9, #8fa38a);
    z-index: 4;
    transform: translate(0, 0);
  }
  .tt-card[data-index="1"] {
    left: 5%;
    height: 86%;
    min-height: 380px;   /* NEW */
    --tint: #a07850;
    background-image: linear-gradient(135deg, #e3cdb2, #a9855e);
    z-index: 3;
    transform: translate(0, 0);
  }
  .tt-card[data-index="2"] {
    left: 1%;
    height: 75%;
    min-height: 360px;   /* NEW */
    --tint: #C08EA4;
    background-image: linear-gradient(135deg, #eeccdc, #c48fa4);
    z-index: 2;
    transform: translate(0, 0);
  }
  .tt-card[data-index="3"] {
    left: 4%;
    height: 100%;
    min-height: 420px;   /* NEW */
    --tint: #95BD8D;
    background-image: linear-gradient(135deg, #cfe4c9, #9ec295);
    z-index: 1;
    transform: translate(0, 0);
  }
 
  .tt-card--gone {
    transform: translateY(140%) !important;
    opacity: 0;
    pointer-events: none;
  }
 
  .tt-card--front { cursor: pointer; }
  .tt-card--waiting { cursor: default; }
 
  .tt-card-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
 
  .tt-card-step {
    font-family: 'MaoWei', sans-serif;
    font-size: clamp(2.75rem, 6vw, 4.5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    opacity: 0.95;
  }
 
  .tt-card-title {
    font-family: 'MaoWei', sans-serif;
    font-size: clamp(1.3rem, 2.2vw, 1.8rem);
    font-weight: 700;
    margin: 0 0 0.6rem 0;
    line-height: 1.2;
  }
 
  .tt-card-desc {
    font-family: 'MaoWei', sans-serif;
    font-size: 0.95rem;
    line-height: 1.6;
    opacity: 0.92;
    margin: 0 0 1.25rem 0;
    max-width: 46ch;
  }
 
  .tt-card-link {
    font-family: 'MaoWei', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    color: #ffffff;
    text-decoration: none;
    align-self: flex-start;
    border-bottom: 1px solid rgba(255,255,255,0.6);
    padding-bottom: 2px;
    transition: opacity 0.2s ease;
  }
  .tt-card-link:hover { opacity: 0.75; }
 
  @media (max-width: 768px) {
    .tt-hero { padding-top: 6rem; }
    .tt-hero-head { margin-bottom: 2rem; }
    .tt-card { width: 97%; padding: 1.75rem; }
  }
 
  @media (prefers-reduced-motion: reduce) {
    .tt-card { transition: opacity 0.3s ease; }
  }

  /* ─── ECORAZÓN ACADEMY ─── */
  .acad-hero,
  .acad-hero *,
  .acad-hero *::before,
  .acad-hero *::after { box-sizing: border-box; }

