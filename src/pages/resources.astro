  /* floating tag pills */
  .acad-pill {
    position: absolute;
    font-family: 'MaoWei', sans-serif;
    font-weight: 600;
    font-size: 1rem;
    color: #000;
    background: #fff;
    padding: 1.1rem 2.25rem;
