    font-weight: 700;
    font-size: clamp(2rem, 3.8vw, 3.1rem);
    line-height: 1.1;
    color: #000;
    margin: 0 0 0.4rem;
  }
  .showcase-tagline {
    font-family: 'MaoWei', sans-serif;
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.1rem, 1.8vw, 1.4rem);
    color: #6b8f76;
    margin: 0 0 0.9rem;
  }
  .showcase-intro {
    font-family: 'MaoWei', sans-serif;
    font-size: 0.98rem;
    line-height: 1.6;
    color: rgba(0,0,0,0.65);
    max-width: 46ch;
    margin: 0 0 1.5rem;
  }
 
  /* sorting tabs */
  .pj-sort { display: flex; flex-wrap: wrap; gap: 0.45rem; }
  .pj-sort-btn {
    font-family: 'MaoWei', sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    color: rgba(0,0,0,0.62);
    background: #fff;
    border: 1px solid rgba(0,0,0,0.08);
    border-radius: 999px;
    padding: 0.42rem 0.5rem 0.42rem 0.95rem;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease, transform 0.2s ease;
  }
  .pj-sort-btn:hover { transform: translateY(-1px); border-color: var(--tc); }
  .pj-sort-btn.is-active { background: var(--tc); border-color: var(--tc); color: #fff; }
  .pj-count {
    font-style: normal;
    font-size: 0.68rem;
    min-width: 1.4rem;
    height: 1.4rem;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: #f1eee7;
    color: rgba(0,0,0,0.55);
    transition: background 0.25s ease, color 0.25s ease;
  }
  .pj-sort-btn.is-active .pj-count { background: rgba(255,255,255,0.28); color: #fff; }
 
  .pj-filter-status {
    font-family: 'MaoWei', sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    color: #6b8f76;
    margin: 0.9rem 0 0;
  }
  .pj-filter-status button {
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    border-bottom: 1px solid currentColor;
    padding: 0;
    margin-left: 0.4rem;
    cursor: pointer;
  }
 
  /* ── the folder (right column) ── */
  .pj-folder {
    --c: #6b8f76;                       /* active category colour, set by JS */
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 580px;
    justify-self: end;
    height: clamp(460px, 66vh, 590px);
  }
 
  /* the darker "back of the folder" strip you see to the right of the tabs */
  .pj-back {
    position: absolute;
    left: 0;
    right: 0;
    top: 26px;
    height: 70px;
    background: var(--c);
    border-radius: 0 18px 0 0;
    z-index: 0;
    transition: background 0.4s ease;
  }
 
  .pj-tabs {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    height: 56px;
    flex: 0 0 auto;
  }
 
  .pj-tab {
    --tab-bg: color-mix(in srgb, var(--tc) 26%, #e9e6de);
    position: relative;
    isolation: isolate;
    flex: 0 0 auto;
    height: 40px;
    margin-left: -24px;                 /* tabs overlap, later ones on top */
    padding: 0 34px 0 26px;
    display: flex;
    align-items: center;
    font-family: 'MaoWei', sans-serif;
    font-size: 0.84rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: rgba(0,0,0,0.6);
    background: none;
    border: 0;
    cursor: pointer;
    white-space: nowrap;
    transition: height 0.4s cubic-bezier(.22,.9,.34,1), color 0.25s ease;
  }
  .pj-tab:first-child { margin-left: 0; }
 
  /* tab body + the sloped right edge */
  .pj-tab::before,
  .pj-tab::after {
    content: '';
    position: absolute;
    background: var(--tab-bg);
    z-index: -1;
    transition: background 0.3s ease;
  }
  .pj-tab::before {
    inset: 0 -2px 0 0;
    border-radius: 16px 16px 0 0;
  }
  .pj-tab::after {
    top: 0;
    bottom: 0;
    right: -22px;
    width: 44px;
    border-radius: 0 16px 0 0;
    transform: skewX(26deg);
    transform-origin: bottom left;
  }
 
  .pj-tab:hover { height: 45px; --tab-bg: color-mix(in srgb, var(--tc) 40%, #e9e6de); }
 
  /* the chosen tab pops up, takes its colour and sits in front */
  .pj-tab.is-active {
    z-index: 3;
    height: 54px;
    --tab-bg: var(--tc);
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 1px;
  }
 
  .pj-body {
    position: relative;
    z-index: 1;
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    background: #ece9e1;
    border-radius: 0 18px 18px 18px;
    box-shadow: 0 26px 50px -22px rgba(0,0,0,0.3);
    overflow: hidden;
  }
  /* soft fade at the bottom so it's clear the lower part scrolls */
  .pj-body::after {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 30px;
    background: linear-gradient(to bottom, rgba(236,233,225,0), #ece9e1);
    pointer-events: none;
  }
 
  /* page-change animation (JS toggles .is-out / .is-pre) */
  .pj-stage {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    transition: opacity 0.22s ease, transform 0.3s cubic-bezier(.22,.9,.34,1);
  }
  .pj-stage.is-out,
  .pj-stage.is-pre { opacity: 0; transform: translateX(var(--dx, 0px)); }
  .pj-stage.is-pre { transition: none; }
 
  /* static top part */
  .pj-head {
    position: relative;
    flex: 0 0 auto;
    padding: 1.35rem 1.6rem 1.1rem;
  }
  .pj-head::after {                     /* the thin divider line */
    content: '';
    position: absolute;
    left: 1.6rem; right: 1.6rem; bottom: 0;
    height: 1px;
    background: rgba(0,0,0,0.38);
  }
  .pj-head-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; }
  .pj-kicker {
    display: block;
    font-family: 'MaoWei', sans-serif;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--c) 75%, #000);
    margin-bottom: 0.3rem;
  }
  .pj-title {
    font-family: 'MaoWei', sans-serif;
    font-weight: 700;
    font-size: 1.3rem;
    line-height: 1.2;
    letter-spacing: 0.01em;
    color: #000;
    margin: 0;
  }
  .pj-nav { display: flex; align-items: center; gap: 0.45rem; flex: 0 0 auto; }
  .pj-counter { font-family: 'MaoWei', sans-serif; font-size: 0.74rem; color: rgba(0,0,0,0.5); min-width: 2.6rem; text-align: center; }
  .pj-arrow {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid rgba(0,0,0,0.12);
    background: #fff;
    color: #000;
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
    transition: background 0.25s ease, color 0.25s ease, transform 0.2s ease, opacity 0.2s ease;
  }
  .pj-arrow:hover:not(:disabled) { background: var(--c); border-color: var(--c); color: #fff; transform: translateY(-1px); }
  .pj-arrow:disabled { opacity: 0.35; cursor: default; }
 
  .pj-summary {
    font-family: 'MaoWei', sans-serif;
    font-size: 0.86rem;
    line-height: 1.55;
    color: rgba(0,0,0,0.68);
    margin: 0.7rem 0 0;
    max-width: 52ch;
  }
  .pj-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.8rem; }
  .pj-tag {
    font-family: 'MaoWei', sans-serif;
    font-size: 0.72rem;
    font-weight: 600;
    color: color-mix(in srgb, var(--c) 75%, #000);
    background: #fff;
    border: 1px solid rgba(0,0,0,0.08);
    border-radius: 999px;
    padding: 0.26rem 0.7rem;
    cursor: pointer;
    transition: background 0.25s ease, color 0.25s ease, transform 0.2s ease;
  }
  .pj-tag:hover { transform: translateY(-1px); }
  .pj-tag.is-active { background: var(--c); border-color: var(--c); color: #fff; }
 
  /* scrolling bottom part */
  .pj-scroll {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 1.2rem 1.6rem 2.6rem;
    scrollbar-width: thin;
    scrollbar-color: rgba(0,0,0,0.25) transparent;
  }
  .pj-media {
    border-radius: 14px;
    background-size: cover;
    background-position: center;
    background-image: linear-gradient(135deg, color-mix(in srgb, var(--c) 28%, #fff), var(--c));
  }
  .pj-hero { height: 150px; }
  .pj-meta {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.8rem;
    margin: 1rem 0 0.4rem;
    font-family: 'MaoWei', sans-serif;
  }
  .pj-meta dt { font-size: 0.7rem; color: rgba(0,0,0,0.45); margin: 0 0 0.15rem; }
  .pj-meta dd { font-size: 0.88rem; font-weight: 700; color: #000; margin: 0; }
  .pj-scroll h4 {
    font-family: 'MaoWei', sans-serif;
    font-weight: 700;
    font-size: 0.95rem;
    color: #000;
    margin: 1.2rem 0 0.4rem;
  }
  .pj-scroll p {
    font-family: 'MaoWei', sans-serif;
    font-size: 0.88rem;
    line-height: 1.65;
    color: rgba(0,0,0,0.7);
    margin: 0 0 0.7rem;
  }
  .pj-list {
    margin: 0 0 0.6rem;
    padding-left: 1.1rem;
    font-family: 'MaoWei', sans-serif;
    font-size: 0.88rem;
    line-height: 1.65;
    color: rgba(0,0,0,0.7);
  }
  .pj-list li::marker { color: var(--c); }
  .pj-gallery { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.7rem; margin-top: 1rem; }
  .pj-tile { height: 110px; border-radius: 12px; }
  .pj-tile:nth-child(2) { background-image: linear-gradient(315deg, color-mix(in srgb, var(--c) 22%, #fff), color-mix(in srgb, var(--c) 80%, #000)); }
  .pj-empty { font-family: 'MaoWei', sans-serif; padding: 2rem 1.6rem; color: rgba(0,0,0,0.5); }
 
  /* ── responsive ── */
  @media (max-width: 900px) {
    .showcase-layout { grid-template-columns: 1fr; }
    .pj-folder { max-width: none; justify-self: stretch; height: clamp(480px, 72vh, 640px); }
    .pj-sort { flex-wrap: nowrap; overflow-x: auto; padding-bottom: 4px; scrollbar-width: none; }
    .pj-sort::-webkit-scrollbar { display: none; }
    .pj-tab { padding: 0 28px 0 18px; margin-left: -20px; font-size: 0.78rem; }
    .pj-title { font-size: 1.15rem; }
  }
  @media (max-width: 480px) {
    .pj-meta { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
 
  @media (prefers-reduced-motion: reduce) {
    .pj-stage, .pj-tab, .pj-back, .pj-sort-btn, .pj-arrow, .pj-tag { transition: none; }
  }

  /* ─── STRATEGIC PARTNERS (compact) ─── */
  .partners-hero,
  .partners-hero *,
  .partners-hero *::before,
  .partners-hero *::after { box-sizing: border-box; }

  .partners-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4.5rem clamp(1rem, 4vw, 3rem);
    background: #f7f5f0;
    overflow: hidden;
    gap: 2rem;
  }

  .partners-head { max-width: 600px; text-align: center; }

  .partners-title {
    font-family: 'MaoWei', sans-serif;
    font-weight: 700;
    font-size: clamp(2rem, 3.8vw, 3.1rem);
    line-height: 1.1;
    color: #000;
    margin: 0 0 0.4rem;
  }
  .partners-tagline {
    font-family: 'MaoWei', sans-serif;
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.1rem, 1.8vw, 1.4rem);
    color: #6b8f76;
    margin: 0 0 0.9rem;
  }
  .partners-intro {
    font-family: 'MaoWei', sans-serif;
    font-size: 0.98rem;
    line-height: 1.6;
    color: rgba(0,0,0,0.65);
    max-width: 62ch;
    margin: 0 auto 0.5rem;
  }
  .partners-intro:last-of-type { margin-bottom: 0; }

  /* ── rows ── */
  .partners-rows {
    width: 100%;
    max-width: 1600px;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .partners-row {
    position: relative;
    width: 100%;
    overflow: hidden;
    padding: 6px 0;   /* room for the hover lift + shadow */
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .partners-track {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    width: max-content;
    will-change: transform;
    animation-name: partners-scroll-left;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    animation-duration: var(--row-duration, 20s);
  }
  .partners-row[data-direction="right"] .partners-track { animation-name: partners-scroll-right; }
  .partners-row.is-paused .partners-track { animation-play-state: paused; }

  @keyframes partners-scroll-left  { from { transform: translateX(0); }    to { transform: translateX(-50%); } }
  @keyframes partners-scroll-right { from { transform: translateX(-50%); } to { transform: translateX(0); } }

  /* ── card ── */
  .partner-card {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    width: 270px;
    padding: 0.8rem 1.3rem 0.8rem 0.8rem;
    background: #ffffff;
    border-radius: 999px;
    box-shadow: 0 6px 18px rgba(0,0,0,0.06);
    cursor: pointer;
    transition: transform 0.35s ease, opacity 0.35s ease, filter 0.35s ease, box-shadow 0.35s ease;
  }
  .partner-card:hover,
  .partner-card.is-active {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 12px 28px rgba(0,0,0,0.12);
  }
  .partners-rows.has-focus .partner-card:not(.is-active) { opacity: 0.4; filter: grayscale(1); }

  .partner-avatar {
    flex: 0 0 auto;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    position: relative;
    box-shadow: inset 0 -3px 7px rgba(0,0,0,0.25), inset 0 3px 5px rgba(255,255,255,0.35);
  }
  .partner-avatar::before { content: ''; position: absolute; inset: 0; border-radius: 50%; background: var(--avatar-gradient); }
  .partner-avatar::after  { content: ''; position: absolute; inset: 0; border-radius: 50%; background: radial-gradient(circle at 35% 30%, rgba(255,255,255,0.55), transparent 55%); }

  .partner-copy h3 {
    font-family: 'MaoWei', sans-serif;
    font-weight: 700;
    font-size: 0.92rem;
    line-height: 1.2;
    color: #000;
    margin: 0 0 0.2rem;
  }
  .partner-copy p {
    font-family: 'MaoWei', sans-serif;
    font-size: 0.76rem;
    line-height: 1.4;
    color: rgba(0,0,0,0.55);
    margin: 0;
  }
  .partner-link {
    display: inline-block;
    font-family: 'MaoWei', sans-serif;
    font-size: 0.74rem;
    font-weight: 600;
    color: #6b8f76;
    text-decoration: none;
    border-bottom: 1px solid rgba(107,143,118,0.5);
    padding-bottom: 1px;
    margin-top: 0.3rem;
    transition: opacity 0.2s ease;
  }
  .partner-link:hover { opacity: 0.7; }

  @media (max-width: 900px) {
    .partner-card { width: 240px; padding: 0.7rem 1.1rem 0.7rem 0.7rem; }
    .partner-avatar { width: 44px; height: 44px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .partners-track { animation: none; }
    .partner-card { transition: none; }
  }

  /* ─── FROM THE JOURNAL ─── */
  .journal-hero,
  .journal-hero *,
  .journal-hero *::before,
  .journal-hero *::after { box-sizing: border-box; }

  .journal-hero {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 5rem clamp(1rem, 4vw, 3rem) 4rem;
    background: #f7f5f0;
    gap: 2rem;
  }

  /* left = heading + sorting, right = pinned article */
  .journal-top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
    width: 100%;
    max-width: 1120px;
  }

  .journal-head { text-align: left; }

  .journal-title {
    font-family: 'MaoWei', sans-serif;
    font-weight: 700;
    font-size: clamp(2rem, 3.8vw, 3.1rem);
    line-height: 1.1;
    color: #000;
    margin: 0 0 0.4rem;
  }
  .journal-tagline {
    font-family: 'MaoWei', sans-serif;
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.1rem, 1.8vw, 1.4rem);
    color: #6b8f76;
    margin: 0 0 0.9rem;
  }
  .journal-intro {
    font-family: 'MaoWei', sans-serif;
    font-size: 0.98rem;
    line-height: 1.6;
    color: rgba(0,0,0,0.65);
    max-width: 46ch;
    margin: 0 0 1.4rem;
  }

  /* ── sorting tabs (category row + tag row) ── */
  .journal-filters { display: flex; flex-direction: column; gap: 0.9rem; }
  .journal-filter-group { display: flex; flex-direction: column; gap: 0.4rem; min-width: 0; }
  .journal-filter-label {
    font-family: 'MaoWei', sans-serif;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(0,0,0,0.4);
  }
  .journal-filter-row { display: flex; flex-wrap: wrap; gap: 0.4rem; }

  .journal-filter {
    font-family: 'MaoWei', sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    color: rgba(0,0,0,0.6);
    background: #fff;
    border: 1px solid rgba(0,0,0,0.08);
    border-radius: 999px;
    padding: 0.38rem 0.9rem;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease, transform 0.2s ease;
  }
  .journal-filter:hover { transform: translateY(-1px); }
  .journal-filter.is-active { background: #6b8f76; border-color: #6b8f76; color: #fff; }

  .journal-status {
    font-family: 'MaoWei', sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    color: #6b8f76;
    margin: 0.9rem 0 0;
  }

  /* ── pinned article ── */
  .journal-pinned {
    display: flex;
    flex-direction: column;
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
    text-decoration: none;
    box-shadow: 0 12px 32px rgba(0,0,0,0.08);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .journal-pinned:hover { transform: translateY(-4px); box-shadow: 0 20px 44px rgba(0,0,0,0.12); }
  .journal-pinned-img { width: 100%; height: clamp(180px, 30vh, 250px); object-fit: cover; }
  .journal-pinned-body { padding: 1.25rem 1.4rem 1.4rem; display: flex; flex-direction: column; gap: 0.5rem; }
  .journal-pinned-body h3 {
    font-family: 'MaoWei', sans-serif;
    font-weight: 700;
    font-size: 1.25rem;
    line-height: 1.25;
    color: #000;
    margin: 0;
  }
  .journal-pinned-body p {
    font-family: 'MaoWei', sans-serif;
    font-size: 0.9rem;
    line-height: 1.55;
    color: rgba(0,0,0,0.6);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .journal-pin-label {
    font-family: 'MaoWei', sans-serif;
    font-size: 0.72rem;
    font-weight: 600;
    color: rgba(0,0,0,0.5);
  }

  /* ── grid: 4 in a row ── */
  .journal-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.1rem;
    width: 100%;
    max-width: 1120px;
  }
  .journal-card {
    display: flex;
    flex-direction: column;
    background: #fff;
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none;
    box-shadow: 0 8px 22px rgba(0,0,0,0.06);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .journal-card:hover { transform: translateY(-4px); box-shadow: 0 16px 32px rgba(0,0,0,0.1); }
  .journal-card-img { width: 100%; height: 130px; object-fit: cover; }
  .journal-card-body { padding: 0.9rem 1rem 1.1rem; display: flex; flex-direction: column; gap: 0.45rem; }
  .journal-card-meta { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
  .journal-card-body h3 {
    font-family: 'MaoWei', sans-serif;
    font-weight: 700;
    font-size: 0.98rem;
    line-height: 1.3;
    color: #000;
    margin: 0;
  }
  .journal-card-body p {
    font-family: 'MaoWei', sans-serif;
    font-size: 0.82rem;
    line-height: 1.5;
    color: rgba(0,0,0,0.6);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── shared bits ── */
  .journal-badge {
    font-family: 'MaoWei', sans-serif;
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: #fff;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .journal-badge--green { background: #6b8f76; }
  .journal-badge--olive { background: #7f9c78; }
  .journal-badge--brown { background: #a07850; }

