    .acad-pill { font-size: 0.85rem; padding: 0.8rem 1.4rem; }
    .acad-pill--3, .acad-pill--5 { display: none; }
    .acad-pill--1 { top: 18%; left: 2%; }
    .acad-pill--2 { top: 26%; left: auto; right: 2%; }
