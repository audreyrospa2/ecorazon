  .showcase-card:nth-child(1){ --accent: #a07850; z-index: 10; } /* cork-brown — Corporate Culture */
  .showcase-card:nth-child(2){ --accent: #7f9c78; z-index: 20; } /* Artists purple — Inclusive Arts */
  .showcase-card:nth-child(3){ --accent: #C08EA4; z-index: 30; } /* forest-green — Sustainable Brand C08EA4 */
  .showcase-card:nth-child(4){ --accent: #6b8f76; z-index: 40; } /* Social Impact blue — AI Pilots */

  /* title: the whole file lifts a touch, as one piece */
  .showcase-card:has(.showcase-tab:hover){
    transform: translateY(-8px);
