.course-instructor {
  font-family: 'MaoWei', sans-serif;
  font-size: 0.9rem;
  font-weight: 600;
  color: #000;
}
.course-btn {
  font-family: 'MaoWei', sans-serif;
  font-size: 0.9rem;
  font-weight: 600;
  color: #fff;
  text-decoration: none;
