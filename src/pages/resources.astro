  margin-bottom: 1.5rem;
  font-family: 'MaoWei', sans-serif;
}
.cd-grid small {
  display: block;
  font-size: 0.75rem;
  color: rgba(0,0,0,0.45);
  margin-bottom: 0.2rem;
}
.cd-grid strong { font-size: 0.95rem; color: #000; }

.cd-heading {
  font-family: 'MaoWei', sans-serif;
  font-weight: 700;
  font-size: 1.1rem;
  color: #000;
  margin: 0 0 0.6rem;
}
.cd-list {
  margin: 0 0 1.75rem;
  padding-left: 1.2rem;
  font-family: 'MaoWei', sans-serif;
  font-size: 0.95rem;
