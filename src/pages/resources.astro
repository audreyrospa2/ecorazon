}

.course-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }
.course-tag {
  font-family: 'MaoWei', sans-serif;
  font-size: 0.75rem;
  font-weight: 600;
  padding: 0.3rem 0.75rem;
  border-radius: 999px;
}
.course-tag--green { background: #e3efdd; color: #5a7d4f; }
.course-tag--pink  { background: #f6e1ea; color: #a65c7c; }
.course-tag--blue  { background: #e0ebf5; color: #4a7fae; }
.course-tag--brown { background: #efe3d3; color: #8a6742; }

.course-stats {
  display: flex;
  gap: 2rem;
  margin-top: auto;
  font-family: 'MaoWei', sans-serif;
}
.course-stats small {
  display: block;
  font-size: 0.75rem;
  color: rgba(0,0,0,0.45);
