---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Get all published blog posts, sorted by date (newest first)
const allPosts = await getCollection('blog', ({ data }: CollectionEntry<'blog'>) => {
  return data.draft !== true;
});

const sortedPosts = allPosts.sort((a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) => 
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const featuredPosts = sortedPosts.slice(0, 2);
const latestPosts = sortedPosts.slice(2, 8);

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('en-US', { 
    year: 'numeric', 
    month: 'short' 
  }).format(new Date(date));
}

function getCategoryTag(category: string) {
  const tags: Record<string, string> = {
    'Artist Stories': 'green',
    'Materials': 'olive',
    'Impact': 'olive',
    'Partnerships': 'olive',
    'Tips': 'green',
    'Innovation': 'brown',
    'Community': 'olive',
  };
  return tags[category] || 'green';
}
---

<Layout title="Resources - Ecorazón">
  <Header />

  <main class="resources-page">

    <!-- Think Tank Hero -->
    <section class="tt-hero">
      <div class="tt-hero-head">
        <h1 class="tt-title animate-fade-in">Ecorazón Think Tank</h1>
        <p class="tt-subtitle animate-fade-in-delay">The Knowledge Commons for ideas, evidence and alliances towards a more empathetic economy.</p>
      </div>
    
      <div class="tt-stack-wrap">
        <div class="tt-stack" id="ttStack">
          <button class="tt-card" data-index="0">
            <div class="tt-card-top">
              <span class="tt-card-step">01</span>
            </div>
            <div class="tt-card-bottom">
              <h3 class="tt-card-title">The C.Y.C.L.E. Library</h3>
              <p class="tt-card-desc">A living archive of research, case studies and toolkits on circular materials, dignified labor and community-rooted design — open to anyone building a more empathetic economy.</p>
              <a href="#" class="tt-card-link">Explore →</a>
            </div>
          </button>
    
          <button class="tt-card" data-index="1">
            <div class="tt-card-top">
              <span class="tt-card-step">02</span>
            </div>
            <div class="tt-card-bottom">
              <h3 class="tt-card-title">Project Showcase</h3>
              <p class="tt-card-desc">Real initiatives from our network of artists, cooperatives and partners — documented from first sketch to finished impact, with the people and numbers behind them.</p>
              <a href="#" class="tt-card-link">Explore →</a>
            </div>
          </button>
    
          <button class="tt-card" data-index="2">
            <div class="tt-card-top">
              <span class="tt-card-step">03</span>
            </div>
            <div class="tt-card-bottom">
              <h3 class="tt-card-title">Human Sustainability Academy</h3>
              <p class="tt-card-desc">Workshops and learning pathways for teams and artisans alike, covering wellbeing, fair practice and the human side of sustainable business.</p>
              <a href="#" class="tt-card-link">Explore →</a>
            </div>
          </button>
    
          <button class="tt-card" data-index="3">
            <div class="tt-card-top">
              <span class="tt-card-step">04</span>
            </div>
            <div class="tt-card-bottom">
              <h3 class="tt-card-title">Strategic Partners</h3>
              <p class="tt-card-desc">The organizations, foundations and companies co-building this commons with us — and how your team can join the alliance.</p>
              <a href="#" class="tt-card-link">Explore →</a>
            </div>
          </button>
        </div>
      </div>
    </section>

    <!-- The C.Y.C.L.E. Library -->
    <section class="lib-hero">
      <div class="lib-head">
        <h2 class="lib-title animate-fade-in">The C.Y.C.L.E. Library</h2>
        <p class="lib-tagline animate-fade-in-delay">Ideas worth growing.</p>
        <p class="lib-intro animate-fade-in-delay">A curated digital library of research papers, white papers, trend reports and frameworks exploring empathy, sustainable development, inclusive design, social innovation and technology with purpose.</p>
      </div>

      <div class="lib-shelf-viewport">
        <div class="lib-shelf-track" id="libShelf"></div>
        <div class="lib-board"></div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style is:global>
  /* ─── THINK TANK HERO ─── */
  .tt-hero,
  .tt-hero *,
  .tt-hero *::before,
  .tt-hero *::after {
    box-sizing: border-box;
  }
 
  .tt-hero {
    height: 100vh;
    height: 100dvh;          /* was: calc(100vh - 72px) / calc(100dvh - 72px) */
    display: flex;
    flex-direction: column;
    padding: 9rem clamp(1rem, 4vw, 3rem) 0;
    background: #f7f5f0;
    overflow: hidden;
  }
 
  .tt-hero-head {
    max-width: 720px;
    margin: 0 0 3rem 0;
    flex-shrink: 0;
  }
 
  .tt-title {
    font-family: 'MaoWei', sans-serif;
    font-weight: 700;
    font-size: clamp(2rem, 4.2vw, 3.4rem);
    line-height: 1.08;
    color: #000000;
    margin: 0 0 1rem 0;
  }
 
  .tt-subtitle {
    font-family: 'MaoWei', sans-serif;
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    color: #000000;
    opacity: 0.65;
    line-height: 1.6;
    margin: 0;
    max-width: 560px;
  }
 
  /* ─── STACK ─── */
  .tt-stack-wrap {
    flex: 1;
    min-height: 0;
    position: relative;
    width: 100%;
  }

  .tt-stack {
    position: relative;
    width: 100%;
    height: 100%;   /* was: flex: 1; min-height: 0; margin: 0 auto; */
  }
 
  .tt-card {
    position: absolute;
    bottom: 0;
    width: 95%;
    border: none;
    text-align: left;
    padding: 2.5rem 2.75rem;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    color: #ffffff;
    box-shadow: 0 18px 40px rgba(0,0,0,0.14);
    transition: transform 0.55s cubic-bezier(.4,0,.2,1), opacity 0.5s ease;
    will-change: transform, opacity;
    /* overflow: hidden;  <-- removed, this was clipping content that didn't fit */
    background-size: cover;
    background-position: center;
    border-radius: 12px; /* optional, since we lost the clipped corners overflow:hidden gave us on the background — add this back if you want rounded corners on the bg image itself */
  }
 
  /* color tint sits over the background image; swap background-image
     for the real photo per card below, the tint stays as-is */
  .tt-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--tint);
    opacity: 0.82;
    z-index: 0;
  }
 
  .tt-card-top,
  .tt-card-bottom {
    position: relative;
    z-index: 1;
  }
 
  .tt-card:focus-visible {
    outline: 3px solid #000000;
    outline-offset: 3px;
  }
 
  .tt-card[data-index="0"] {
    left: 0%;
    height: 64%;
    min-height: 320px;   /* NEW — guarantees room for step number + title + desc + link */
    --tint: #6b8f76;
    background-image: linear-gradient(135deg, #cfd9c9, #8fa38a);
    z-index: 4;
    transform: translate(0, 0);
  }
  .tt-card[data-index="1"] {
    left: 5%;
    height: 86%;
    min-height: 380px;   /* NEW */
    --tint: #a07850;
    background-image: linear-gradient(135deg, #e3cdb2, #a9855e);
    z-index: 3;
    transform: translate(0, 0);
  }
  .tt-card[data-index="2"] {
    left: 1%;
    height: 75%;
    min-height: 360px;   /* NEW */
    --tint: #C08EA4;
    background-image: linear-gradient(135deg, #eeccdc, #c48fa4);
    z-index: 2;
    transform: translate(0, 0);
  }
  .tt-card[data-index="3"] {
    left: 4%;
    height: 100%;
    min-height: 420px;   /* NEW */
    --tint: #95BD8D;
    background-image: linear-gradient(135deg, #cfe4c9, #9ec295);
    z-index: 1;
    transform: translate(0, 0);
  }
 
  .tt-card--gone {
    transform: translateY(140%) !important;
    opacity: 0;
    pointer-events: none;
  }
 
  .tt-card--front { cursor: pointer; }
  .tt-card--waiting { cursor: default; }
 
  .tt-card-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
 
  .tt-card-step {
    font-family: 'MaoWei', sans-serif;
    font-size: clamp(2.75rem, 6vw, 4.5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    opacity: 0.95;
  }
 
  .tt-card-title {
    font-family: 'MaoWei', sans-serif;
    font-size: clamp(1.3rem, 2.2vw, 1.8rem);
    font-weight: 700;
    margin: 0 0 0.6rem 0;
    line-height: 1.2;
  }
 
  .tt-card-desc {
    font-family: 'MaoWei', sans-serif;
    font-size: 0.95rem;
    line-height: 1.6;
    opacity: 0.92;
    margin: 0 0 1.25rem 0;
    max-width: 46ch;
  }
 
  .tt-card-link {
    font-family: 'MaoWei', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    color: #ffffff;
    text-decoration: none;
    align-self: flex-start;
    border-bottom: 1px solid rgba(255,255,255,0.6);
    padding-bottom: 2px;
    transition: opacity 0.2s ease;
  }
  .tt-card-link:hover { opacity: 0.75; }
 
  @media (max-width: 768px) {
    .tt-hero { padding-top: 6rem; }
    .tt-hero-head { margin-bottom: 2rem; }
    .tt-card { width: 97%; padding: 1.75rem; }
  }
 
  @media (prefers-reduced-motion: reduce) {
    .tt-card { transition: opacity 0.3s ease; }
  }

  /* ─── C.Y.C.L.E. LIBRARY SHELF ─── */
  .lib-hero,
  .lib-hero *,
  .lib-hero *::before,
  .lib-hero *::after { box-sizing: border-box; }

  .lib-hero {
    height: 100vh;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;   /* still centers .lib-head within the leftover space above the shelf */
    padding: 6rem clamp(1rem, 4vw, 3rem) 0;  /* bottom padding removed so the shelf can sit flush */
    background: #f7f5f0;
    overflow: hidden;
  }

  .lib-head {
    max-width: 640px;
    margin: 0 0 3rem;
    text-align: center;
    flex-shrink: 0;
  }

  .lib-intro {
    margin-left: auto;
    margin-right: auto;        /* max-width + auto margins center the paragraph block itself */
  }

  .lib-title {
    font-family: 'MaoWei', sans-serif;
    font-weight: 700;
    font-size: clamp(2.75rem, 6vw, 4.5rem); 
    line-height: 1.1;
    color: #000;
    margin: 0 0 0.5rem;
  }

  .lib-tagline {
    font-family: 'MaoWei', sans-serif;
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    color: #6b8f76;
    margin: 0 0 1.25rem;
  }

  .lib-intro {
    font-family: 'MaoWei', sans-serif;
    font-size: 1.2rem;
    line-height: 1.7;
    color: rgba(0,0,0,0.65);
    max-width: 62ch;
    margin: 0;
  }

  /* ─── shelf ─── */
  .lib-shelf-viewport {
    position: relative;
    width: 100%;
    height: 420px;
    margin-top: auto;
    overflow: hidden;
    perspective: 1800px;
    cursor: grab;
    touch-action: pan-y;   /* let vertical page scroll pass through, we handle horizontal ourselves */
  }
  .lib-shelf-viewport.dragging {
    cursor: grabbing;
  }
  .lib-shelf-viewport::before,
  .lib-shelf-viewport::after {
    content: '';
    position: absolute;
    top: 0; bottom: 18px;
    width: min(10vw, 100px);
    z-index: 20;
    pointer-events: none;
  }
  .lib-shelf-viewport::before { left: 0; background: linear-gradient(90deg, #f7f5f0, transparent); }
  .lib-shelf-viewport::after  { right: 0; background: linear-gradient(270deg, #f7f5f0, transparent); }

  .lib-shelf-track {
    display: flex;
    align-items: flex-end;
    gap: 10px;
    width: max-content;
    will-change: transform;
    user-select: none;
  }

  .lib-board {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 18px;
    background: #ddd2ba;
    box-shadow: 0 12px 20px rgba(0,0,0,0.15);
  }

  /* real width transition — this is what pushes siblings aside */
  .lib-book {
    position: relative;
    flex: 0 0 auto;
    transform-style: preserve-3d;
    transition: width 0.55s cubic-bezier(.22,.9,.34,1);
    cursor: pointer;
  }

  .lib-spine {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    writing-mode: vertical-rl;
    text-orientation: mixed;
    font-family: 'MaoWei', sans-serif;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: rgba(255,255,255,0.92);
    padding: 0.9rem 0;
    box-shadow:
      inset -5px 0 10px rgba(0,0,0,0.18),
      inset 3px 0 6px rgba(255,255,255,0.12),
      0 10px 16px rgba(0,0,0,0.2);
  }
  .lib-spine span {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-height: 100%;
  }

  /* cover fills whatever the book's current width is — since the
     book itself now grows on hover, the cover never needs to be
     wider than its own box, so it can't overlap a neighbor */
  .lib-cover {
    position: absolute;
    inset: 0;
    transform-origin: left center;
    backface-visibility: hidden;
    transform: rotateY(90deg);
    transition: transform 0.55s cubic-bezier(.22,.9,.34,1);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.25rem 1.35rem;
    box-shadow: 0 22px 40px rgba(0,0,0,0.35);
  }
  .lib-cover h4 {
    font-family: 'MaoWei', sans-serif;
    font-weight: 700;
    font-size: 1.05rem;
    line-height: 1.2;
    color: #fff;
    margin: 0 0 0.5rem;
  }
  .lib-cover a {
    font-family: 'MaoWei', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    color: #fff;
    text-decoration: none;
    align-self: flex-start;
    border-bottom: 1px solid rgba(255,255,255,0.6);
    padding-bottom: 2px;
  }

  .lib-book:hover .lib-cover {
    transform: rotateY(0deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .lib-book, .lib-cover { transition: none; }
  }
</style>
 
<script>
  (function () {
    var stack = document.getElementById('ttStack');
    if (!stack) return;
    var cards = Array.prototype.slice.call(stack.querySelectorAll('.tt-card'));
    var TOTAL = cards.length;
    var step = 0;       // number of cards currently sent to the back
    var direction = 1;  // 1 = moving forward through the stack, -1 = restoring cards
 
    function render() {
      cards.forEach(function (card, i) {
        var isGone = i < step;
        card.classList.toggle('tt-card--gone', isGone);
        var isFront = i === step;
        card.classList.toggle('tt-card--front', isFront);
        card.classList.toggle('tt-card--waiting', !isFront && !isGone);
        card.tabIndex = isFront ? 0 : -1;
        card.setAttribute('aria-hidden', isFront ? 'false' : 'true');
      });
    }
 
    function advance() {
      if (step === TOTAL - 1 && direction === 1) direction = -1;
      if (step === 0 && direction === -1) direction = 1;
      step += direction;
      render();
    }
 
    stack.addEventListener('click', function (e) {
      var target = e.target;
      if (!(target instanceof Element)) return;
      var card = target.closest('.tt-card');
      if (!card) return;
      var index = Number(card.getAttribute('data-index'));
      if (index !== step) return;
      if (target.closest('.tt-card-link')) return;
      e.preventDefault();
      advance();
    });
 
    render();
  })();
</script>

<script is:inline>
  (function () {
    var track = document.getElementById('libShelf');
    if (!track) return;

    var viewportEl = track.parentElement;
    if (!viewportEl) return;

    // one book per tag for now — once real articles exist, each
    // article becomes a book and can carry more than one of these
    // tags as small chips on its cover
    var TAGS = [
      { name: 'Empathy Economy',            color: '#6b8f76' },
      { name: 'ESG',                        color: '#a07850' },
      { name: 'CSR',                        color: '#C08EA4' },
      { name: 'Design Thinking',            color: '#95BD8D' },
      { name: 'Human-Centred AI',           color: '#7a8fae' },
      { name: 'Inclusion & Accessibility',  color: '#c9a227' },
      { name: 'Wellbeing',                  color: '#8fae86' },
      { name: 'Culture',                    color: '#ab6b6f' },
      { name: 'Education',                 color: '#7f9c78' },
      { name: 'Talent Development',        color: '#9c7d54' }
    ];

    var WIDTHS  = [46, 58, 50, 64, 48, 56, 44, 60, 50, 58];
    var HEIGHTS = [360, 400, 340, 400, 370, 400, 350, 400, 365, 400];
    var GAP = 10;
    var COVER_W = 230;

    var baseSetWidth = TAGS.reduce(function (sum, _, i) {
      return sum + WIDTHS[i] + GAP;
    }, 0);

    // render enough copies of the tag list that the shelf always
    // spans at least 3 viewport-widths — the loop point stays
    // permanently off-screen, so there's never a visible gap
    var viewportW = viewportEl.clientWidth || window.innerWidth;
    var repeats = Math.max(4, Math.ceil((viewportW * 3) / baseSetWidth) + 1);

    for (var r = 0; r < repeats; r++) {
      TAGS.forEach(function (tagData, i) {
        var book = document.createElement('div');
        book.className = 'lib-book';
        book.style.width = WIDTHS[i] + 'px';
        book.style.height = HEIGHTS[i] + 'px';

        var spine = document.createElement('div');
        spine.className = 'lib-spine';
        spine.style.background = tagData.color;
        var span = document.createElement('span');
        span.textContent = tagData.name.toUpperCase();
        spine.appendChild(span);

        var cover = document.createElement('div');
        cover.className = 'lib-cover';
        cover.style.background = tagData.color;
        cover.innerHTML =
          '<h4>' + tagData.name + '</h4>' +
          '<a href="/blog?tag=' + encodeURIComponent(tagData.name) + '">Explore →</a>';

        book.appendChild(spine);
        book.appendChild(cover);

        book.addEventListener('mouseenter', function () {
          book.style.width = COVER_W + 'px';
        });
        book.addEventListener('mouseleave', function () {
          book.style.width = WIDTHS[i] + 'px';
        });

        track.appendChild(book);
      });
    }

    // ── manual slide: trackpad/wheel + drag, no auto-play ──
    var scrollX = 0;

    function wrap(x) {
      x = x % baseSetWidth;
      if (x > 0) x -= baseSetWidth;
      return x;
    }

    function render(withTransition) {
      track.style.transition = withTransition ? 'transform 0.2s ease-out' : 'none';
      track.style.transform = 'translateX(' + scrollX + 'px)';
    }
    render(false);

    // trackpad two-finger swipe (deltaX) + plain wheel fallback (deltaY)
    viewportEl.addEventListener('wheel', function (e) {
      var delta = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
      e.preventDefault();
      scrollX = wrap(scrollX - delta);
      render(false);
    }, { passive: false });

    // drag (mouse + touch, unified via Pointer Events)
    var dragging = false;
    var dragStartX = 0;
    var scrollAtDragStart = 0;

    viewportEl.addEventListener('pointerdown', function (e) {
      dragging = true;
      dragStartX = e.clientX;
      scrollAtDragStart = scrollX;
      viewportEl.classList.add('dragging');
      viewportEl.setPointerCapture(e.pointerId);
    });

    viewportEl.addEventListener('pointermove', function (e) {
      if (!dragging) return;
      var delta = e.clientX - dragStartX;
      scrollX = wrap(scrollAtDragStart + delta);
      render(false);
    });

    function endDrag() {
      if (!dragging) return;
      dragging = false;
      viewportEl.classList.remove('dragging');
    }
    viewportEl.addEventListener('pointerup', endDrag);
    viewportEl.addEventListener('pointercancel', endDrag);
  })();
</script>
 