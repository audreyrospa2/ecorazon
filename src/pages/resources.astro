<script is:inline>
  (function () {
    var stack = document.getElementById('ttStack');
    if (!stack) return;
    var cards = Array.prototype.slice.call(stack.querySelectorAll('.tt-card'));
    var TOTAL = cards.length;
    var step = 0;       // number of cards currently sent to the back
    var direction = 1;  // 1 = moving forward through the stack, -1 = restoring cards
 
    function render() {
      cards.forEach(function (card, i) {
        var isGone = i < step;
        card.classList.toggle('tt-card--gone', isGone);
        var isFront = i === step;
        card.classList.toggle('tt-card--front', isFront);
        card.classList.toggle('tt-card--waiting', !isFront && !isGone);
        card.tabIndex = isFront ? 0 : -1;
        card.setAttribute('aria-hidden', isFront ? 'false' : 'true');
      });
    }
 
    function advance() {
      if (step === TOTAL - 1 && direction === 1) direction = -1;
      if (step === 0 && direction === -1) direction = 1;
      step += direction;
      render();
    }
 
    stack.addEventListener('click', function (e) {
      var target = e.target;
      if (!(target instanceof Element)) return;
      var card = target.closest('.tt-card');
      if (!card) return;
      var index = Number(card.getAttribute('data-index'));
      if (index !== step) return;
      var link = target.closest('.tt-card-link');
      if (link) {
        e.preventDefault();
        var hash = link.getAttribute('href');
        var dest = hash && hash.length > 1 ? document.querySelector(hash) : null;
        if (dest) {
          var smooth = window.ecoSmoothScrollTo;
          if (smooth) smooth(dest, 1400, 100);
          else dest.scrollIntoView({ behavior: 'smooth' });
        }
        return;
      }
      e.preventDefault();
      advance();
    });
 
    render();
  })();
</script>

<script is:inline>
  (function () {
    var track = document.getElementById('libShelf');
    if (!track) return;

    var viewportEl = track.parentElement;
    if (!viewportEl) return;

    // spines = the 7 real `category` enum values from your content
    // collection schema (guaranteed to exist on every post) plus the
    // real tags confirmed from actual posts' frontmatter so far:
    // Artists, Social Impact, Sustainability, Corporate Gifting.
    // No invented values — share more posts' tags to expand this list.
    var TAGS = [
      { name: 'Artist Stories',    color: '#a07850' }, // category (cork-brown)
      { name: 'Materials',         color: '#6b8f76' }, // category (forest-green)
      { name: 'Impact',            color: '#7f9c78' }, // category (deep-olive)
      { name: 'Partnerships',      color: '#7f9c78' }, // category (deep-olive)
      { name: 'Tips',              color: '#6b8f76' }, // category (forest-green)
      { name: 'Innovation',        color: '#a07850' }, // category (cork-brown)
      { name: 'Community',         color: '#7f9c78' }, // category (deep-olive)
      { name: 'Artists',           color: '#8e5fa3' }, // tag (confirmed)
      { name: 'Social Impact',     color: '#4a7fae' }, // tag (confirmed)
      { name: 'Sustainability',    color: '#c9a227' }, // tag (confirmed)
      { name: 'Corporate Gifting', color: '#b5636b' }  // tag (confirmed)
    ];

    var WIDTHS  = [46, 58, 50, 64, 48, 56, 44, 60, 50, 58, 54];
    var HEIGHTS = [360, 400, 340, 400, 370, 400, 350, 400, 365, 400, 380];

    var GAP = 10;
    var COVER_W = 200;
    var CLICK_THRESHOLD = 6; // px of pointer movement before it counts as a drag, not a click

    var baseSetWidth = TAGS.reduce(function (sum, _, i) {
      return sum + WIDTHS[i] + GAP;
    }, 0);

    // render enough copies of the tag list that the shelf always
    // spans at least 3 viewport-widths — the loop point stays
    // permanently off-screen, so there's never a visible gap
    var viewportW = viewportEl.clientWidth || window.innerWidth;
    var repeats = Math.max(4, Math.ceil((viewportW * 3) / baseSetWidth) + 1);

    for (var r = 0; r < repeats; r++) {
      TAGS.forEach(function (tagData, i) {
        var book = document.createElement('div');
        book.className = 'lib-book';
        book.setAttribute('data-tag', tagData.name);
        book.style.setProperty('--w', WIDTHS[i] + 'px');
        book.style.setProperty('--open-w', COVER_W + 'px');
        // height follows the shelf scale (--s) so it fits smaller laptop screens
        book.style.height = 'calc(' + HEIGHTS[i] + 'px * var(--s, 1))';

        var spine = document.createElement('div');
        spine.className = 'lib-spine';
        spine.style.background = tagData.color;
        var span = document.createElement('span');
        span.textContent = tagData.name.toUpperCase();
        spine.appendChild(span);

        var cover = document.createElement('div');
        cover.className = 'lib-cover';
        cover.style.background = tagData.color;
        cover.innerHTML =
          '<h4>' + tagData.name + '</h4>' +
          '<a href="#from-the-journal">Read articles ↓</a>';

        book.appendChild(spine);
        book.appendChild(cover);

        // NOTE: no mouseenter/mouseleave here anymore — opening is
        // handled by the click detection in the pointer handlers
        // below, so it can't fire mid-drag.

        track.appendChild(book);
      });
    }

    // ── manual slide: trackpad/wheel + drag, no auto-play ──
    // click-to-open is layered onto the same pointer handlers so a
    // swipe never gets misread as a book click, and a click never
    // gets misread as the start of a swipe.
    var scrollX = 0;
    var openBook = null;

    function announce(tag) {
      window.dispatchEvent(new CustomEvent('library:tagchange', { detail: { tag: tag } }));
    }

    function setOpen(book, open) {
      if (open) {
        if (openBook && openBook !== book) openBook.classList.remove('is-open');
        book.classList.add('is-open');
        openBook = book;
        announce(book.getAttribute('data-tag'));
      } else {
        book.classList.remove('is-open');
        if (openBook === book) {
          openBook = null;
          announce('all');
        }
      }
    }
    function wrap(x) {
      x = x % baseSetWidth;
      if (x > 0) x -= baseSetWidth;
      return x;
    }

    function render(withTransition) {
      track.style.transition = withTransition ? 'transform 0.2s ease-out' : 'none';
      track.style.transform = 'translateX(' + scrollX + 'px)';
    }
    render(false);

    // trackpad two-finger swipe (deltaX) + plain wheel fallback (deltaY)
    viewportEl.addEventListener('wheel', function (e) {
      var delta = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
      e.preventDefault();
      scrollX = wrap(scrollX - delta);
      render(false);
    }, { passive: false });

    // drag (mouse + touch, unified via Pointer Events)
    var dragging = false;
    var moved = false;
    var dragStartX = 0;
    var dragStartY = 0;
    var scrollAtDragStart = 0;

    viewportEl.addEventListener('pointerdown', function (e) {
      dragging = true;
      moved = false;
      dragStartX = e.clientX;
      dragStartY = e.clientY;
      scrollAtDragStart = scrollX;
      viewportEl.classList.add('dragging');
      viewportEl.setPointerCapture(e.pointerId);
    });

    viewportEl.addEventListener('pointermove', function (e) {
      if (!dragging) return;
      var dx = e.clientX - dragStartX;
      var dy = e.clientY - dragStartY;
      if (!moved && (Math.abs(dx) > CLICK_THRESHOLD || Math.abs(dy) > CLICK_THRESHOLD)) {
        moved = true;
      }
      scrollX = wrap(scrollAtDragStart + dx);
      render(false);
    });

    function endDrag(e) {
      if (!dragging) return;
      dragging = false;
      viewportEl.classList.remove('dragging');

      // pointer barely moved → treat it as a click, not a swipe.
      // NOTE: can't use e.target here — once setPointerCapture is
      // active, every event's target is retargeted to viewportEl
      // itself, so we hit-test the real DOM at the release point.
      if (!moved && e) {
        var hit = document.elementFromPoint(e.clientX, e.clientY);
        if (!(hit instanceof Element)) return;
        if (hit.closest('a')) {
          window.ecoSmoothScrollTo(document.getElementById('from-the-journal'), 1400, 100);
          return;
        }

        var book = hit.closest('.lib-book');
        if (book) {
          setOpen(book, !book.classList.contains('is-open'));
        } else if (openBook) {
          setOpen(openBook, false);
        }
      }
    }
    viewportEl.addEventListener('pointerup', endDrag);
    viewportEl.addEventListener('pointercancel', function () {
      dragging = false;
      viewportEl.classList.remove('dragging');
    });
    viewportEl.addEventListener('click', function (e) {
      if (e.target instanceof Element && e.target.closest('a')) e.preventDefault();
    });
  })();
</script>

<script is:inline>
  (function () {
    var rowsEl = document.getElementById('partnersRows');
    var row1 = document.getElementById('partnersRow1');
    var row2 = document.getElementById('partnersRow2');
    if (!rowsEl || !row1 || !row2) return;
 
    // partners come from src/data/partners.json (edited in the admin → Partners tab)
    var PARTNERS = [];
    try { PARTNERS = JSON.parse(document.getElementById('partnersData').textContent) || []; } catch (e) {}
 
    // badge colours the admin can pick from
    var GRADIENTS = {
      blue:   'conic-gradient(from 200deg, #16324f, #3b82c4, #a9d8ef, #16324f)',
      green:  'conic-gradient(from 160deg, #0b3d1f, #3bb273, #b8ecc2, #0b3d1f)',
      orange: 'conic-gradient(from 140deg, #5c2a0a, #d97a3d, #f7d2ab, #5c2a0a)',
      purple: 'conic-gradient(from 120deg, #4a154b, #a64ac9, #e8c3ff, #4a154b)',
      slate:  'conic-gradient(from 200deg, #22333b, #5c7a89, #c3d3d6, #22333b)',
      gold:   'conic-gradient(from 150deg, #7a5c00, #e0b400, #fbe9ae, #7a5c00)'
    };
 
    function esc(s) {
      return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }
 
    function toTag(p) {
      return {
        name: p.name,
        desc: p.desc,
        filterValue: p.filterValue,
        gradient: p.image
          ? "url('" + String(p.image).replace(/'/g, '%27') + "') center / cover no-repeat"
          : (GRADIENTS[p.gradient] || GRADIENTS.green)
      };
    }
 
    var ROW_1_TAGS = PARTNERS.filter(function (p) { return Number(p.row) !== 2; }).map(toTag);
    var ROW_2_TAGS = PARTNERS.filter(function (p) { return Number(p.row) === 2; }).map(toTag);
 
    function buildCard(tag) {
      var card = document.createElement('div');
      card.className = 'partner-card';
      card.setAttribute('data-tag', tag.name);
 
      var avatar = document.createElement('div');
      avatar.className = 'partner-avatar';
      avatar.style.setProperty('--avatar-gradient', tag.gradient);
 
      var copy = document.createElement('div');
      copy.className = 'partner-copy';
      copy.innerHTML =
        '<h3>' + esc(tag.name) + '</h3><p>' + esc(tag.desc) + '</p>' +
        '<a class="partner-link" href="/resources?tag=' + encodeURIComponent(tag.filterValue || '') + '">Explore →</a>';
 
      card.appendChild(avatar);
      card.appendChild(copy);
      return card;
    }
 
    function fillTrack(track, tags) {
      if (!tags.length) { track.closest('.partners-row').style.display = 'none'; return; }
      // The scroll loop shifts by exactly half the track, so the set is repeated an even
      // number of times. Rows with only a few partners repeat more so they never show a gap.
      var copies = tags.length < 4 ? 4 : 2;
      for (var c = 0; c < copies; c++) {
        tags.forEach(function (tag) { track.appendChild(buildCard(tag)); });
      }
    }
 
    fillTrack(row1, ROW_1_TAGS);
    fillTrack(row2, ROW_2_TAGS);
 
    document.querySelectorAll('.partners-row').forEach(function (row) {
      row.style.setProperty('--row-duration', row.getAttribute('data-duration') || '34s');
    });
 
    // hovering (or clicking to "select") a card highlights every
    // card sharing its tag name and greys/dims the rest; clicking
    // again, or clicking empty space, clears the selection.
    var selectedTag = null;
 
    function applyFocus(tag) {
      var active = tag !== null;
      rowsEl.classList.toggle('has-focus', active);
      rowsEl.querySelectorAll('.partner-card').forEach(function (card) {
        card.classList.toggle('is-active', active && card.getAttribute('data-tag') === tag);
      });
    }
 
    rowsEl.addEventListener('mouseover', function (e) {
      if (selectedTag) return; // an explicit selection takes priority over hover previews
      var card = e.target.closest('.partner-card');
      if (card) applyFocus(card.getAttribute('data-tag'));
    });
 
    rowsEl.addEventListener('mouseleave', function () {
      if (!selectedTag) applyFocus(null);
    });
 
    rowsEl.addEventListener('click', function (e) {
      if (e.target.closest('a')) return; // let the Explore link navigate normally
      var card = e.target.closest('.partner-card');
      var tag = card ? card.getAttribute('data-tag') : null;
      selectedTag = (selectedTag && selectedTag === tag) ? null : tag;
      applyFocus(selectedTag);
    });
 
    // pause only the row being interacted with, so the other row
    // keeps drifting past while you read a card
    document.querySelectorAll('.partners-row').forEach(function (row) {
      row.addEventListener('mouseenter', function () { row.classList.add('is-paused'); });
      row.addEventListener('mouseleave', function () { row.classList.remove('is-paused'); });
    });
  })();
</script>

<!-- Academy: CTA scroll + cursor echo trail -->
<script is:inline>
  (function () {
    var hero = document.getElementById('academy-hero');

    // "View Our Courses" → smooth scroll to the courses carousel
    var cta = hero ? hero.querySelector('[data-scroll]') : null;
    if (cta) {
      cta.addEventListener('click', function (e) {
        e.preventDefault();
        var dest = document.querySelector(cta.getAttribute('href'));
        if (!dest) return;
        if (window.ecoSmoothScrollTo) window.ecoSmoothScrollTo(dest, 1400, 100);
        else dest.scrollIntoView({ behavior: 'smooth' });
      });
    }

    // no trail on touch screens or for reduced-motion users
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (window.matchMedia('(hover: none)').matches) return;

    // full-page layer, fixed to the viewport so the trail works anywhere on the page
    var layer = document.createElement('div');
    layer.className = 'acad-echo';
    layer.setAttribute('aria-hidden', 'true');
    document.body.appendChild(layer);

    // ── settings you can tweak ──
    var SPACING   = 30;    // px the cursor must travel before the next shape appears (bigger = fewer, more spread out)
    var LIFETIME  = 2400;  // ms each shape takes to grow, shrink and fade (bigger = slower)
    var MAX_ALIVE = 9;     // most shapes on screen at once; the oldest is removed first
    var SIZE_MIN  = 38, SIZE_MAX = 68;  // px

    // pastel palette
    var COLORS = ['#cdb8f0', '#bfe3c8', '#f4c6d8', '#f7e7a1', '#b9daf5', '#f9d3b8', '#d8e8b8'];
    var SHAPES = ['star4', 'burst', 'pill', 'circle', 'star4', 'burst'];

    function burst(points, inner) {
      var d = '';
      for (var i = 0; i < points * 2; i++) {
        var r = i % 2 ? inner : 12;
        var a = (Math.PI * i) / points - Math.PI / 2;
        d += (i ? 'L' : 'M') + (12 + r * Math.cos(a)).toFixed(2) + ' ' + (12 + r * Math.sin(a)).toFixed(2);
      }
      return d + 'Z';
    }
    var PATHS = {
      star4: 'M12 0C13 8 16 11 24 12C16 13 13 16 12 24C11 16 8 13 0 12C8 11 11 8 12 0Z',
      burst: burst(10, 8.5),
      pill: 'M8 5a4 4 0 0 1 8 0v14a4 4 0 0 1-8 0Z',
      circle: 'M12 3a9 9 0 1 0 0 18a9 9 0 1 0 0-18Z'
    };

    var last = null;     // where the last shape was dropped
    var count = 0;       // cycles colours / shapes so neighbours differ

    function rand(min, max) { return min + Math.random() * (max - min); }

    function spawn(x, y) {
      // keep the number on screen under the cap: retire the oldest early
      while (layer.children.length >= MAX_ALIVE) {
        var oldest = layer.firstElementChild;
        if (oldest._anim) oldest._anim.cancel();
        oldest.remove();
      }

      var size = Math.round(rand(SIZE_MIN, SIZE_MAX));
      var rot = Math.round(rand(-35, 35));
      var el = document.createElement('span');
      el.className = 'acad-echo-item';
      el.style.width = size + 'px';
      el.style.height = size + 'px';
      el.style.color = COLORS[count % COLORS.length];
      el.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="' + PATHS[SHAPES[count % SHAPES.length]] + '"/></svg>';
      count++;
      layer.appendChild(el);

      var at = 'translate3d(' + (x - size / 2) + 'px,' + (y - size / 2) + 'px,0)';
      // pops in, holds, then shrinks away while fading
      el._anim = el.animate([
        { transform: at + ' rotate(' + rot + 'deg) scale(0.2)',       opacity: 0,   offset: 0 },
        { transform: at + ' rotate(' + (rot + 8) + 'deg) scale(1)',   opacity: 0.95, offset: 0.22 },
        { transform: at + ' rotate(' + (rot + 25) + 'deg) scale(0)',  opacity: 0,   offset: 1 }
      ], { duration: LIFETIME, easing: 'ease-out', fill: 'forwards' });
      el._anim.onfinish = function () { el.remove(); };
    }

    document.addEventListener('mousemove', function (e) {
      var x = e.clientX;
      var y = e.clientY;
      if (!last) { last = { x: x, y: y }; return; }
      var dx = x - last.x, dy = y - last.y;
      if (dx * dx + dy * dy < SPACING * SPACING) return;   // not far enough yet: nothing appears
      last = { x: x, y: y };
      spawn(x, y);
    });
    document.documentElement.addEventListener('mouseleave', function () { last = null; });
  })();
</script>

<!-- Journal sorting: category row + tag row, synced with the shelf -->
<script is:inline>
  (function () {
    var filters = document.getElementById('journalFilters');
    if (!filters) return;

    var cards = Array.prototype.slice.call(document.querySelectorAll('#journalGrid .journal-card'));
    var statusEl = document.getElementById('journalStatus');
    var emptyEl = document.getElementById('journalEmpty');

    // category names come straight from the category chips, so there's no second list to keep in sync
    var categoryRow = filters.querySelector('[data-group="category"]');
    var categoryNames = Array.prototype.map.call(
      categoryRow.querySelectorAll('.journal-filter'),
      function (b) { return b.getAttribute('data-value'); }
    ).filter(function (v) { return v !== 'all'; });

    // category and tag work alone or together (together = a post must match both).
    // The pinned article is never filtered.
    var state = { category: 'all', tag: 'all' };

    function lower(s) { return String(s || '').toLowerCase(); }

    function syncChips() {
      filters.querySelectorAll('.journal-filter-row').forEach(function (row) {
        var group = row.getAttribute('data-group');
        var buttons = Array.prototype.slice.call(row.querySelectorAll('.journal-filter'));
        var hasMatch = buttons.some(function (b) { return lower(b.getAttribute('data-value')) === lower(state[group]); });
        buttons.forEach(function (btn) {
          var v = lower(btn.getAttribute('data-value'));
          btn.classList.toggle('is-active', hasMatch ? v === lower(state[group]) : v === 'all');
        });
      });
    }

    function apply() {
      var shown = 0;
      cards.forEach(function (card) {
        var tags = (card.getAttribute('data-tags') || '').split('|').map(lower);
        var okCat = state.category === 'all' || lower(card.getAttribute('data-category')) === lower(state.category);
        var okTag = state.tag === 'all' || tags.indexOf(lower(state.tag)) !== -1;
        var visible = okCat && okTag;
        card.classList.toggle('is-hidden', !visible);
        if (visible) shown++;
      });

      var active = [];
      if (state.category !== 'all') active.push(state.category);
      if (state.tag !== 'all') active.push(state.tag);

      if (statusEl) {
        statusEl.hidden = active.length === 0;
        statusEl.textContent = active.length === 0
          ? ''
          : shown + (shown === 1 ? ' article' : ' articles') + ' · ' + active.join(' + ');
      }
      if (emptyEl) emptyEl.hidden = shown > 0;
      syncChips();

      // keep the URL shareable (same ?tag= behaviour as before, plus ?category=)
      var url = new URL(window.location.href);
      if (state.tag === 'all') url.searchParams.delete('tag'); else url.searchParams.set('tag', state.tag);
      if (state.category === 'all') url.searchParams.delete('category'); else url.searchParams.set('category', state.category);
      window.history.replaceState({}, '', url);
    }

    // a value from the shelf or the URL: category names set the Category row, anything else sets the Tag row
    function resolve(value) {
      if (!value || lower(value) === 'all') {
        state.category = 'all';
        state.tag = 'all';
        return;
      }
      var match = categoryNames.filter(function (c) { return lower(c) === lower(value); })[0];
      if (match) {
        state.category = match;
        state.tag = 'all';
      } else {
        state.tag = value;
        state.category = 'all';
      }
    }

    // clicking a chip; clicking the active chip again goes back to "All"
    filters.addEventListener('click', function (e) {
      var btn = e.target instanceof Element ? e.target.closest('.journal-filter') : null;
      if (!btn) return;
      var group = btn.closest('.journal-filter-row').getAttribute('data-group');
      var value = btn.getAttribute('data-value');
      state[group] = lower(state[group]) === lower(value) ? 'all' : value;
      apply();
    });

    // shelf → journal (book opened = that topic, book closed = 'all')
    window.addEventListener('library:tagchange', function (e) {
      resolve(e.detail && e.detail.tag);
      apply();
    });

    // arriving from a Partner card link (/resources?tag=…) or a shared URL
    var params = new URLSearchParams(window.location.search);
    var urlTag = params.get('tag');
    var urlCategory = params.get('category');
    if (urlCategory || urlTag) {
      if (urlCategory) state.category = urlCategory;
      if (urlTag) {
        var asCategory = categoryNames.filter(function (c) { return lower(c) === lower(urlTag); })[0];
        if (asCategory && !urlCategory) state.category = asCategory;
        else state.tag = urlTag;
      }
      apply();
    }
  })();
</script>

<script is:inline>
  (function () {
    var folder = document.getElementById('pjFolder');
    var stage = document.getElementById('pjStage');
    if (!folder || !stage) return;
 
    var PROJECTS = [];
    try { PROJECTS = (JSON.parse(document.getElementById('projectsData').textContent) || {}).projects || []; } catch (e) {}
 
    var tabs = Array.prototype.slice.call(folder.querySelectorAll('.pj-tab'));
    var sortBtns = Array.prototype.slice.call(document.querySelectorAll('.pj-sort-btn'));
    var statusEl = document.getElementById('pjFilterStatus');
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!tabs.length) return;
 
    var CATS = tabs.map(function (t) {
      return { id: t.getAttribute('data-tab'), blurb: t.getAttribute('data-blurb') || '', color: t.getAttribute('data-color') };
    });
 
    var state = { cat: 0, i: 0, tag: null };
    var busy = false;
 
    function esc(s) {
      return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }
 
    // projects shown right now: this tab, narrowed by the active tag if there is one
    function list() {
      var id = CATS[state.cat].id;
      return PROJECTS.filter(function (p) {
        return p.cat === id && (!state.tag || (p.tags || []).indexOf(state.tag) !== -1);
      });
    }
 
    function renderStage() {
      var L = list();
      if (!L.length) { stage.innerHTML = '<p class="pj-empty">No projects here yet.</p>'; return; }
      if (state.i >= L.length) state.i = 0;
      var p = L[state.i];
      var imgs = p.images || [];
      var meta = p.meta || {};
      var body = p.body || [];
      var highlights = p.highlights || [];
 
      function bg(n) { return imgs[n] ? ' style="background-image:url(\'' + esc(imgs[n]) + '\')"' : ''; }
 
      var tagsHtml = (p.tags || []).map(function (t) {
        var on = state.tag === t;
        return '<button type="button" class="pj-tag' + (on ? ' is-active' : '') + '" data-tag="' + esc(t) + '">#' + esc(t) + (on ? ' ×' : '') + '</button>';
      }).join('');
 
      var metaKeys = Object.keys(meta).filter(function (k) { return String(meta[k] || '').trim(); });
      var metaHtml = metaKeys.length
        ? '<dl class="pj-meta">' + metaKeys.map(function (k) { return '<div><dt>' + esc(k) + '</dt><dd>' + esc(meta[k]) + '</dd></div>'; }).join('') + '</dl>'
        : '';
 
      var galleryHtml = (imgs[1] || imgs[2])
        ? '<div class="pj-gallery">' +
            (imgs[1] ? '<div class="pj-media pj-tile"' + bg(1) + '></div>' : '') +
            (imgs[2] ? '<div class="pj-media pj-tile"' + bg(2) + '></div>' : '') +
          '</div>'
        : '';
 
      stage.innerHTML =
        '<div class="pj-head">' +
          '<div class="pj-head-top">' +
            '<div><span class="pj-kicker">' + esc(CATS[state.cat].blurb) + '</span><h3 class="pj-title">' + esc(p.title) + '</h3></div>' +
            '<div class="pj-nav">' +
              '<button type="button" class="pj-arrow" data-step="-1" aria-label="Previous project"' + (L.length < 2 ? ' disabled' : '') + '>←</button>' +
              '<span class="pj-counter">' + (state.i + 1) + ' / ' + L.length + '</span>' +
              '<button type="button" class="pj-arrow" data-step="1" aria-label="Next project"' + (L.length < 2 ? ' disabled' : '') + '>→</button>' +
            '</div>' +
          '</div>' +
          (p.summary ? '<p class="pj-summary">' + esc(p.summary) + '</p>' : '') +
          (tagsHtml ? '<div class="pj-tags">' + tagsHtml + '</div>' : '') +
        '</div>' +
        '<div class="pj-scroll" tabindex="0">' +
          '<div class="pj-media pj-hero"' + bg(0) + '></div>' +
          metaHtml +
          (body.length ? '<h4>Overview</h4>' + body.map(function (t) { return '<p>' + esc(t) + '</p>'; }).join('') : '') +
          (highlights.length ? '<h4>Highlights</h4><ul class="pj-list">' + highlights.map(function (t) { return '<li>' + esc(t) + '</li>'; }).join('') + '</ul>' : '') +
          galleryHtml +
        '</div>';
    }
 
    // tabs, colours, counts, filter message — updates instantly
    function syncChrome() {
      tabs.forEach(function (t, i) {
        t.classList.toggle('is-active', i === state.cat);
        t.setAttribute('aria-selected', i === state.cat ? 'true' : 'false');
      });
      sortBtns.forEach(function (b, i) {
        b.classList.toggle('is-active', i === state.cat);
        b.setAttribute('aria-selected', i === state.cat ? 'true' : 'false');
      });
      folder.style.setProperty('--c', CATS[state.cat].color);
 
      if (statusEl) {
        statusEl.hidden = !state.tag;
        statusEl.innerHTML = state.tag ? 'Showing #' + esc(state.tag) + ' <button type="button" data-clear>Clear</button>' : '';
      }
    }
 
    // slide the current page out, swap the content, slide the new one in
    function swap(render, dir) {
      if (reduce) { render(); return; }
      busy = true;
      stage.style.setProperty('--dx', (-dir * 28) + 'px');
      stage.classList.add('is-out');
      setTimeout(function () {
        render();
        stage.style.setProperty('--dx', (dir * 28) + 'px');
        stage.classList.add('is-pre');
        void stage.offsetWidth;                       // flush so the jump happens without a transition
        stage.classList.remove('is-pre', 'is-out');
        busy = false;
      }, 210);
    }
 
    function setTab(i) {
      if (i < 0 || i === state.cat || busy) return;
      var dir = i > state.cat ? 1 : -1;
      state.cat = i; state.i = 0; state.tag = null;
      syncChrome();
      swap(renderStage, dir);
    }
    function step(d) {
      var L = list();
      if (L.length < 2 || busy) return;
      state.i = (state.i + d + L.length) % L.length;
      swap(renderStage, d);
    }
    function setTag(t) {
      if (busy) return;
      state.tag = state.tag === t ? null : t;
      state.i = 0;
      syncChrome();
      swap(renderStage, 1);
    }
 
    function indexOfTab(id) {
      for (var i = 0; i < CATS.length; i++) if (CATS[i].id === id) return i;
      return -1;
    }
 
    // clicks inside the folder: tabs, arrows, tags
    folder.addEventListener('click', function (e) {
      var t = e.target instanceof Element ? e.target : null;
      if (!t) return;
      var tab = t.closest('.pj-tab');
      if (tab) { setTab(indexOfTab(tab.getAttribute('data-tab'))); return; }
      var arrow = t.closest('.pj-arrow');
      if (arrow && !arrow.disabled) { step(Number(arrow.getAttribute('data-step'))); return; }
      var tag = t.closest('.pj-tag');
      if (tag) setTag(tag.getAttribute('data-tag'));
    });
 
    // the sorting tabs on the left do the same job as the folder tabs
    sortBtns.forEach(function (b) {
      b.addEventListener('click', function () { setTab(indexOfTab(b.getAttribute('data-tab'))); });
    });
    if (statusEl) {
      statusEl.addEventListener('click', function (e) {
        if (e.target instanceof Element && e.target.closest('[data-clear]')) setTag(state.tag);
      });
    }
 
    // ← → keys flip through projects while focus is inside the folder
    folder.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowLeft') { step(-1); }
      else if (e.key === 'ArrowRight') { step(1); }
    });
 
    // project counts on the sorting tabs
    sortBtns.forEach(function (b) {
      var id = b.getAttribute('data-tab');
      var n = PROJECTS.filter(function (p) { return p.cat === id; }).length;
      var badge = b.querySelector('.pj-count');
      if (badge) badge.textContent = n;
    });
 
    syncChrome();
    renderStage();
  })();
</script>
<script is:inline>
  window.ecoSmoothScrollTo = function (targetEl, duration) {
    if (!targetEl) return;
    duration = duration || 1400;
    var root = document.documentElement;
    var startY = window.scrollY || window.pageYOffset;
    var targetY = targetEl.getBoundingClientRect().top + startY;  // sections snap to their own top, so no header offset
    var startTime = null;

    root.classList.add('is-auto-scrolling');

    function easeInOutCubic(t) {
      return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
    }

    function step(timestamp) {
      if (!startTime) startTime = timestamp;
      var progress = Math.min((timestamp - startTime) / duration, 1);
      window.scrollTo(0, startY + (targetY - startY) * easeInOutCubic(progress));
      if (progress < 1) requestAnimationFrame(step);
      else root.classList.remove('is-auto-scrolling');
    }
    requestAnimationFrame(step);
  };
</script>

<script is:inline>
  (function () {
    var track = document.getElementById('coursesTrack');
    var prev = document.getElementById('coursesPrev');
    var next = document.getElementById('coursesNext');
    if (!track || !prev || !next) return;

    function stepSize() {
      var card = track.querySelector('.course-card');
      return card ? card.getBoundingClientRect().width + 24 : 320; // card width + gap
    }

    prev.addEventListener('click', function () {
      track.scrollBy({ left: -stepSize(), behavior: 'smooth' });
    });
    next.addEventListener('click', function () {
      track.scrollBy({ left: stepSize(), behavior: 'smooth' });
    });
  })();

  (function () {
    var modal = document.getElementById('courseModal');
    var mediaEl = document.getElementById('courseModalMedia');
    var contentEl = document.getElementById('courseModalContent');
    if (!modal || !mediaEl || !contentEl) return;

    var lastTrigger = null;

    function openModal(card, trigger) {
      var tpl = card.querySelector('template.course-detail');
      var title = card.querySelector('.course-name');
      var media = card.querySelector('.course-media');
      var tags = card.querySelector('.course-tags');

      // copy the card's image or gradient into the popup header
      mediaEl.style.backgroundImage = media ? getComputedStyle(media).backgroundImage : 'none';

      contentEl.innerHTML = '';
      var h = document.createElement('h3');
      h.id = 'courseModalTitle';
      h.textContent = title ? title.textContent : '';
      contentEl.appendChild(h);
      if (tags) contentEl.appendChild(tags.cloneNode(true));
      if (tpl) contentEl.appendChild(tpl.content.cloneNode(true));

      lastTrigger = trigger;
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
      modal.querySelector('.course-modal-dialog').scrollTop = 0;
      requestAnimationFrame(function () {
        modal.classList.add('is-open');
        modal.querySelector('.course-modal-close').focus();
      });
    }

    function closeModal() {
      if (modal.hidden) return;
      modal.classList.remove('is-open');
      document.body.style.overflow = '';
      setTimeout(function () { modal.hidden = true; }, 300);
      if (lastTrigger) lastTrigger.focus();
    }

    document.addEventListener('click', function (e) {
      var t = e.target;
      if (!(t instanceof Element)) return;

      var opener = t.closest('[data-course-open]');
      if (opener) {
        var card = opener.closest('.course-card');
        if (card) openModal(card, opener);
        return;
      }
      if (t.closest('[data-close]')) closeModal();
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeModal();
    });
  })();
</script>