}

.course-badges {
  position: absolute;
  top: 0.9rem;
  left: 0.9rem;
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
}
.course-badge {
  font-family: 'MaoWei', sans-serif;
  font-size: 0.78rem;
  font-weight: 600;
  color: #000;
  background: #fff;
  padding: 0.35rem 0.85rem;
