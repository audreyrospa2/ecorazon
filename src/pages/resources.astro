  .showcase-stack:has(.showcase-card:not(:last-child) .showcase-card-head:hover) .showcase-card:last-child::before,
  .showcase-stack:has(.showcase-card:not(:last-child) .showcase-card-body:hover) .showcase-card:last-child::before{ opacity: 0; }

  /* the tab — pokes above the card's own top edge, title lives here */
  .showcase-tab{
