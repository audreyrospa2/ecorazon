@media (max-width: 600px) {
  .course-card { flex-basis: 82vw; }
  .courses-arrow { width: 42px; height: 42px; }
}

@media (prefers-reduced-motion: reduce) {
  .courses-track { scroll-behavior: auto; }
  .course-card, .course-btn, .courses-arrow { transition: none; }
}

/* the Details trigger is now a <button>, so reset the native styles */
button.course-btn {
  border: none;
  cursor: pointer;
}

/* ─── COURSE DETAILS POPUP ─── */
.course-modal,
.course-modal *,
.course-modal *::before,
.course-modal *::after { box-sizing: border-box; }

.course-modal {
  position: fixed;
  inset: 0;
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1.5rem;
  opacity: 0;
  transition: opacity 0.3s ease;
}
.course-modal[hidden] { display: none; }
.course-modal.is-open { opacity: 1; }

.course-modal-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(20, 28, 22, 0.55);
  -webkit-backdrop-filter: blur(6px);
  backdrop-filter: blur(6px);
}

.course-modal-dialog {
  position: relative;
  width: 100%;
  max-width: 680px;
  max-height: 90vh;
  overflow-y: auto;
  background: #fff;
  border-radius: 28px;
  box-shadow: 0 30px 80px rgba(0,0,0,0.3);
  transform: translateY(24px) scale(0.98);
  transition: transform 0.35s cubic-bezier(.22,.9,.34,1);
}
.course-modal.is-open .course-modal-dialog { transform: translateY(0) scale(1); }

.course-modal-close {
  position: absolute;
  top: 1rem;
  right: 1rem;
  z-index: 2;
  width: 42px;
  height: 42px;
  border: none;
  border-radius: 50%;
  background: #fff;
  color: #000;
  font-size: 1.6rem;
  line-height: 1;
  cursor: pointer;
  box-shadow: 0 6px 18px rgba(0,0,0,0.15);
  transition: transform 0.2s ease;
}
.course-modal-close:hover { transform: rotate(90deg); }

.course-modal-media {
  height: 200px;
  margin: 0.75rem 0.75rem 0;
  border-radius: 20px;
  background-size: cover;
  background-position: center;
}

.course-modal-content { padding: 1.75rem 2rem 2rem; }

.course-modal-content h3 {
