  .acad-pill--1 { left: 6%;  top: 42%; transform: rotate(8deg); }
  .acad-pill--2 { left: 1%;  top: 58%; transform: rotate(-9deg); }
  .acad-pill--3 { left: 16%; top: 64%; transform: rotate(-12deg); }
  .acad-pill--4 { right: 4%; top: 38%; transform: rotate(-8deg); }
  .acad-pill--5 { right: 6%; top: 58%; transform: rotate(14deg); }

  /* why section */
  .acad-why {
    display: grid;
    grid-template-columns: 1fr auto;   /* title takes the space, feature hugs the right */
    align-items: start;
    gap: 3rem;
    width: 100%;
