---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import coursesData from '../data/courses.json';
import partnersData from '../data/partners.json';
import projectsData from '../data/projects.json';

// Get all published blog posts, sorted by date (newest first)
const allPosts = await getCollection('blog', ({ data }: CollectionEntry<'blog'>) => {
  return data.draft !== true;
});

const sortedPosts = allPosts.sort((a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) => 
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

// newest post is pinned on the right; the next 8 fill the 4-column grid (2 clean rows)
const pinnedPost = sortedPosts[0];
const gridPosts = sortedPosts.slice(1, 9);

// the 7 category enum values (must match your content schema exactly)
const CATEGORIES = ['Artist Stories', 'Materials', 'Impact', 'Partnerships', 'Tips', 'Innovation', 'Community'];

// tags that actually appear on the posts being shown
const allTags = [
  ...new Set(
    [pinnedPost, ...gridPosts]
      .filter(Boolean)
      .flatMap((p: CollectionEntry<'blog'>) => p.data.tags ?? [])
  ),
].sort();

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('en-US', { 
    year: 'numeric', 
    month: 'short' 
  }).format(new Date(date));
}

function getCategoryTag(category: string) {
  const tags: Record<string, string> = {
    'Artist Stories': 'green',
    'Materials': 'olive',
    'Impact': 'olive',
    'Partnerships': 'olive',
    'Tips': 'green',
    'Innovation': 'brown',
    'Community': 'olive',
  };
  return tags[category] || 'green';
}
 
// Courses
const courses = coursesData.courses ?? [];
const COURSE_GRADIENTS = {
  green: 'linear-gradient(135deg,#cfe4c9,#6b8f76)',
  pink:  'linear-gradient(135deg,#eeccdc,#c48fa4)',
  brown: 'linear-gradient(135deg,#e3cdb2,#a07850)',
  sage:  'linear-gradient(135deg,#cfe4c9,#95BD8D)',
};
 
// Projects (folder tabs come from the categories you manage in the admin)
const SHOWCASE_TABS = projectsData.categories ?? [];
const projectsJson = JSON.stringify({ projects: projectsData.projects ?? [] }).replace(/</g, '\\u003c');
 
// Partners
const partnersJson = JSON.stringify(partnersData.partners ?? []).replace(/</g, '\\u003c');
---

<Layout title="Resources - Ecorazón">
  <Header />

  <main class="resources-page">

    <!-- Think Tank Hero -->
    <section class="tt-hero">
      <div class="tt-hero-head">
        <h1 class="tt-title animate-fade-in">Ecorazón Think Tank</h1>
        <p class="tt-subtitle animate-fade-in-delay">The Knowledge Commons for ideas, evidence and alliances towards a more empathetic economy.</p>
      </div>
    
      <div class="tt-stack-wrap">
        <div class="tt-stack" id="ttStack">
          <button class="tt-card" data-index="0">
            <div class="tt-card-top">
              <span class="tt-card-step">01</span>
            </div>
            <div class="tt-card-bottom">
              <h3 class="tt-card-title">The C.Y.C.L.E. Library</h3>
              <p class="tt-card-desc">A living archive of research, case studies and toolkits on circular materials, dignified labor and community-rooted design — open to anyone building a more empathetic economy.</p>
              <a href="#lib-hero" class="tt-card-link">Explore →</a>
            </div>
          </button>

          <button class="tt-card" data-index="1">
            <div class="tt-card-top">
              <span class="tt-card-step">02</span>
            </div>
            <div class="tt-card-bottom">
              <h3 class="tt-card-title">Human Sustainability Academy</h3>
              <p class="tt-card-desc">Workshops and learning pathways for teams and artisans alike, covering wellbeing, fair practice and the human side of sustainable business.</p>
              <a href="#academy-hero" class="tt-card-link">Explore →</a>
            </div>
          </button>

          <button class="tt-card" data-index="2">
            <div class="tt-card-top">
              <span class="tt-card-step">03</span>
            </div>
            <div class="tt-card-bottom">
              <h3 class="tt-card-title">Strategic Partners</h3>
              <p class="tt-card-desc">The organizations, foundations and companies co-building this commons with us — and how your team can join the alliance.</p>
              <a href="#partners-hero" class="tt-card-link">Explore →</a>
            </div>
          </button>
    
          <button class="tt-card" data-index="3">
            <div class="tt-card-top">
              <span class="tt-card-step">04</span>
            </div>
            <div class="tt-card-bottom">
              <h3 class="tt-card-title">Project Showcase</h3>
              <p class="tt-card-desc">Real initiatives from our network of artists, cooperatives and partners — documented from first sketch to finished impact, with the people and numbers behind them.</p>
              <a href="#showcase-hero" class="tt-card-link">Explore →</a>
            </div>
          </button>
        </div>
      </div>
    </section>

    <!-- The C.Y.C.L.E. Library -->
    <section class="lib-hero" id="lib-hero">
      <div class="lib-head">
        <h2 class="lib-title animate-fade-in">The C.Y.C.L.E. Library</h2>
        <p class="lib-tagline animate-fade-in-delay">Ideas worth growing.</p>
        <p class="lib-intro animate-fade-in-delay">A curated digital library of research papers, white papers, trend reports and frameworks exploring empathy, sustainable development, inclusive design, social innovation and technology with purpose.</p>
      </div>

      <div class="lib-shelf-viewport">
        <div class="lib-shelf-track" id="libShelf"></div>
        <div class="lib-board"></div>
      </div>
    </section>


    <!-- From the Journal -->
    <section class="journal-hero" id="from-the-journal">
      <div class="journal-top">
        <div class="journal-head">
          <h2 class="journal-title animate-fade-in">From the Journal</h2>
          <p class="journal-tagline animate-fade-in-delay">Stories, insights and updates.</p>
          <p class="journal-intro animate-fade-in-delay">Field notes from our artists, partners and team. Open a book on the shelf above, or sort below.</p>

          <div class="journal-filters" id="journalFilters">
            <div class="journal-filter-group">
              <span class="journal-filter-label">Category</span>
              <div class="journal-filter-row" data-group="category">
                <button type="button" class="journal-filter is-active" data-value="all">All</button>
                {CATEGORIES.map((c) => <button type="button" class="journal-filter" data-value={c}>{c}</button>)}
              </div>
            </div>

            {allTags.length > 0 && (
              <div class="journal-filter-group">
                <span class="journal-filter-label">Tag</span>
                <div class="journal-filter-row" data-group="tag">
                  <button type="button" class="journal-filter is-active" data-value="all">All</button>
                  {allTags.map((t: string) => <button type="button" class="journal-filter" data-value={t}>{t}</button>)}
                </div>
              </div>
            )}
          </div>

          <p class="journal-status" id="journalStatus" hidden></p>
        </div>

        {pinnedPost && (
          <a href={`/blog/${pinnedPost.id}`} class="journal-pinned">
            <img src={pinnedPost.data.image} alt={pinnedPost.data.imageAlt} class="journal-pinned-img" />
            <div class="journal-pinned-body">
              <div class="journal-card-meta">
                <span class={`journal-badge journal-badge--${getCategoryTag(pinnedPost.data.category)}`}>{pinnedPost.data.category}</span>
                <span class="journal-pin-label">📌 Pinned</span>
              </div>
              <h3>{pinnedPost.data.title}</h3>
              <p>{pinnedPost.data.excerpt}</p>
              <span class="journal-date">{formatDate(pinnedPost.data.date)}</span>
            </div>
          </a>
        )}
      </div>

      <div class="journal-grid" id="journalGrid">
        {gridPosts.map((post: CollectionEntry<'blog'>) => (
          <a
            href={`/blog/${post.id}`}
            class="journal-card"
            data-tags={(post.data.tags ?? []).join('|')}
            data-category={post.data.category}
          >
            <img src={post.data.image} alt={post.data.imageAlt} class="journal-card-img" />
            <div class="journal-card-body">
              <div class="journal-card-meta">
                <span class={`journal-badge journal-badge--${getCategoryTag(post.data.category)}`}>{post.data.category}</span>
                <span class="journal-date">{formatDate(post.data.date)}</span>
              </div>
              <h3>{post.data.title}</h3>
              <p>{post.data.excerpt}</p>
              {post.data.tags && post.data.tags.length > 0 && (
                <div class="journal-card-tags">
                  {post.data.tags.map((t: string) => <span class="journal-chip">{t}</span>)}
                </div>
              )}
            </div>
          </a>
        ))}
      </div>

      <p class="journal-empty" id="journalEmpty" hidden>No articles match that combination yet — try another one.</p>
    </section>

    <!-- Ecorazón Academy -->
    <section class="acad-hero" id="academy-hero">
      <div class="acad-top">
        <span class="acad-pill acad-pill--1">#Wellbeing</span>
        <span class="acad-pill acad-pill--2">#FairPractice</span>
        <span class="acad-pill acad-pill--3">#Workshops</span>
        <span class="acad-pill acad-pill--4">#Community</span>
        <span class="acad-pill acad-pill--5">#Skills</span>

        <span class="acad-eyebrow animate-fade-in">WHY</span>
        <h2 class="acad-title animate-fade-in">Ecorazón Academy</h2>
        <p class="acad-intro animate-fade-in-delay">
          Learning through play. Mastering skills that stay.
          <span>Learn skills you can put into practice—in everyday life, relationships and work.</span>
        </p>
        <a href="#courses-hero" class="acad-cta animate-fade-in-delay" data-scroll>View Our Courses <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <!-- Academy Courses Carousel -->
    <section class="courses-hero" id="courses-hero">
      <div class="courses-head">
        <h3 class="courses-title">Our Courses</h3>
        <div class="courses-nav">
          <button type="button" class="courses-arrow" id="coursesPrev" aria-label="Previous courses">←</button>
          <button type="button" class="courses-arrow" id="coursesNext" aria-label="Next courses">→</button>
        </div>
      </div>

      <div class="courses-track" id="coursesTrack">
        {courses.map((c) => {
          const d = c.details ?? {};
          const formats = c.format ?? [];
          const outcomes = d.outcomes ?? [];
          const media = c.image ? `url('${c.image}')` : (COURSE_GRADIENTS[c.color] ?? COURSE_GRADIENTS.green);
          return (
            <article class="course-card">
              <div class="course-media" style={`--media: ${media};`}>
                <div class="course-badges">
                  {formats.map((f) => <span class="course-badge">{f}</span>)}
                  {c.featured && <span class="course-badge course-badge--dark">Featured</span>}
                </div>
              </div>
              <div class="course-body">
                <h4 class="course-name">{c.title}</h4>
                <div class="course-tags">
                  {(c.tags ?? []).map((t) => <span class={`course-tag course-tag--${t.color ?? 'green'}`}>{t.label}</span>)}
                </div>
                <div class="course-stats">
                  <div><small>Theory</small><strong>{c.theory}</strong></div>
                  <div><small>Practice</small><strong>{c.practice}</strong></div>
                </div>
              </div>
              <div class="course-foot">
                <span class="course-instructor">{c.instructor}</span>
                <button type="button" class="course-btn" data-course-open>Details <span aria-hidden="true">↗</span></button>
              </div>
      
              <template class="course-detail">
                {d.lead && <p class="cd-lead">{d.lead}</p>}
                <div class="cd-grid">
                  <div><small>Format</small><strong>{formats.length ? formats.join(' & ') : '—'}</strong></div>
                  <div><small>Duration</small><strong>{d.duration || '—'}</strong></div>
                  <div><small>Theory</small><strong>{c.theory || '—'}</strong></div>
                  <div><small>Practice</small><strong>{c.practice || '—'}</strong></div>
                  <div><small>Next intake</small><strong>{d.nextIntake || 'TBC'}</strong></div>
                  <div><small>Instructor</small><strong>{c.instructor || '—'}</strong></div>
                </div>
                {outcomes.length > 0 && (
                  <>
                    <h5 class="cd-heading">What you'll learn</h5>
                    <ul class="cd-list">
                      {outcomes.map((o) => <li>{o}</li>)}
                    </ul>
                  </>
                )}
                <a href={d.registerUrl || '/get-in-touch'} class="course-btn cd-register">Register interest</a>
              </template>
            </article>
          );
        })}
      </div>
    </section>
    <div class="course-modal" id="courseModal" hidden>
      <div class="course-modal-backdrop" data-close></div>
      <div class="course-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="courseModalTitle">
        <button type="button" class="course-modal-close" data-close aria-label="Close">×</button>
        <div class="course-modal-media" id="courseModalMedia"></div>
        <div class="course-modal-content" id="courseModalContent"></div>
      </div>
    </div>

    <!-- Strategic Partners -->
    <section class="partners-hero" id="partners-hero">
      <div class="partners-head">
        <h2 class="partners-title animate-fade-in">Strategic Partners</h2>
        <p class="partners-tagline animate-fade-in-delay">Shared values. Greater impact.</p>
        <p class="partners-intro animate-fade-in-delay">Together, we connect expertise, resources and communities to create solutions that no one organisation could build alone.</p>
        <p class="partners-intro animate-fade-in-delay">We collaborate with educators, artists, community organisations, social innovators and technology partners who believe progress should be human, responsible and shared.</p>
      </div>

      <div class="partners-rows" id="partnersRows">
        <div class="partners-row" data-direction="left" data-duration="20s">
          <div class="partners-track" id="partnersRow1"></div>
        </div>
        <div class="partners-row" data-direction="right" data-duration="24s">
          <div class="partners-track" id="partnersRow2"></div>
        </div>
      </div>

      <script type="application/json" id="partnersData" set:html={partnersJson}></script>
    </section>

    <!-- Project Showcase -->
    <section class="showcase-hero" id="showcase-hero">
      <div class="showcase-layout">
    
        <div class="showcase-head">
          <h2 class="showcase-title animate-fade-in">Project Showroom</h2>
          <p class="showcase-tagline animate-fade-in-delay">Ideas, made visible.</p>
          <p class="showcase-intro animate-fade-in-delay">Discover projects, pilot programmes and case studies that bring research into the real world. From ESG and CSR initiatives to inclusive arts, employee wellbeing, co-creation workshops and responsible technology experiments — each project shows how insight can become shared impact.</p>
    
          <div class="pj-sort" id="pjSort" role="tablist" aria-label="Project categories">
            {SHOWCASE_TABS.map((t, i) => (
              <button type="button" role="tab" class={`pj-sort-btn${i === 0 ? ' is-active' : ''}`} data-tab={t.id} style={`--tc:${t.color}`}>
                <span>{t.label}</span><em class="pj-count">0</em>
              </button>
            ))}
          </div>
          <p class="pj-filter-status" id="pjFilterStatus" hidden></p>
        </div>
    
        <div class="pj-folder" id="pjFolder" style={`--c:${SHOWCASE_TABS[0]?.color ?? '#6b8f76'}`}>
          <div class="pj-back" aria-hidden="true"></div>
    
          <div class="pj-tabs" role="tablist" aria-label="Project categories (folder)">
            {SHOWCASE_TABS.map((t, i) => (
              <button
                type="button"
                role="tab"
                class={`pj-tab${i === 0 ? ' is-active' : ''}`}
                data-tab={t.id}
                data-blurb={t.blurb}
                data-color={t.color}
                style={`--tc:${t.color}`}
              >{t.short || t.label}</button>
            ))}
          </div>
    
          <div class="pj-body">
            <div class="pj-stage" id="pjStage" aria-live="polite"></div>
          </div>
        </div>
    
      </div>
      <script type="application/json" id="projectsData" set:html={projectsJson}></script>
    </section>

  </main>

  <Footer />
</Layout>

<style is:global>
    /* ─── SECTION SNAP SCROLL ─── */
  html {
    scroll-snap-type: y proximity;   /* use "y mandatory" for a firmer snap */
    scroll-behavior: smooth;
  }
  .tt-hero,
  .lib-hero,
  .journal-hero,
  .acad-hero,
  .courses-hero,
  .partners-hero,
  .showcase-hero {
    scroll-snap-align: start;
  }

  /* pauses snapping and CSS smoothing while the custom scroll animation runs, so they don't fight it */
  html.is-auto-scrolling {
    scroll-snap-type: none !important;
    scroll-behavior: auto !important;
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-snap-type: none; scroll-behavior: auto; }
  }
  /* ─── THINK TANK HERO ─── */
  .tt-hero,
  .tt-hero *,
  .tt-hero *::before,
  .tt-hero *::after {
    box-sizing: border-box;
  }
 
  .tt-hero {
    height: 100vh;
    height: 100dvh;          /* was: calc(100vh - 72px) / calc(100dvh - 72px) */
    display: flex;
    flex-direction: column;
    padding: 9rem clamp(1rem, 4vw, 3rem) 0;
    background: #f7f5f0;
    overflow: hidden;
  }
 
  .tt-hero-head {
    max-width: 720px;
    margin: 0 0 3rem 0;
    flex-shrink: 0;
  }
 
  .tt-title {
    font-family: 'MaoWei', sans-serif;
    font-weight: 700;
    font-size: clamp(2rem, 4.2vw, 3.4rem);
    line-height: 1.08;
    color: #000000;
    margin: 0 0 1rem 0;
  }
 
  .tt-subtitle {
    font-family: 'MaoWei', sans-serif;
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    color: #000000;
    opacity: 0.65;
    line-height: 1.6;
    margin: 0;
    max-width: 560px;
  }
 
  /* ─── STACK ─── */
  .tt-stack-wrap {
    flex: 1;
    min-height: 0;
    position: relative;
    width: 100%;
  }

  .tt-stack {
    position: relative;
    width: 100%;
    height: 100%;   /* was: flex: 1; min-height: 0; margin: 0 auto; */
  }
 
  .tt-card {
    position: absolute;
    bottom: 0;
    width: 95%;
    border: none;
    text-align: left;
    padding: 2.5rem 2.75rem;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    color: #ffffff;
    box-shadow: 0 18px 40px rgba(0,0,0,0.14);
    transition: transform 0.55s cubic-bezier(.4,0,.2,1), opacity 0.5s ease;
    will-change: transform, opacity;
    /* overflow: hidden;  <-- removed, this was clipping content that didn't fit */
    background-size: cover;
    background-position: center;
    border-radius: 12px; /* optional, since we lost the clipped corners overflow:hidden gave us on the background — add this back if you want rounded corners on the bg image itself */
  }
 
  /* color tint sits over the background image; swap background-image
     for the real photo per card below, the tint stays as-is */
  .tt-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--tint);
    opacity: 0.82;
    z-index: 0;
  }
 
  .tt-card-top,
  .tt-card-bottom {
    position: relative;
    z-index: 1;
  }
 
  .tt-card:focus-visible {
    outline: 3px solid #000000;
    outline-offset: 3px;
  }
 
  .tt-card[data-index="0"] {
    left: 0%;
    height: 64%;
    min-height: 320px;   /* NEW — guarantees room for step number + title + desc + link */
    --tint: #6b8f76;
    background-image: linear-gradient(135deg, #cfd9c9, #8fa38a);
    z-index: 4;
    transform: translate(0, 0);
  }
  .tt-card[data-index="1"] {
    left: 5%;
    height: 86%;
    min-height: 380px;   /* NEW */
    --tint: #a07850;
    background-image: linear-gradient(135deg, #e3cdb2, #a9855e);
    z-index: 3;
    transform: translate(0, 0);
  }
  .tt-card[data-index="2"] {
    left: 1%;
    height: 75%;
    min-height: 360px;   /* NEW */
    --tint: #C08EA4;
    background-image: linear-gradient(135deg, #eeccdc, #c48fa4);
    z-index: 2;
    transform: translate(0, 0);
  }
  .tt-card[data-index="3"] {
    left: 4%;
    height: 100%;
    min-height: 420px;   /* NEW */
    --tint: #95BD8D;
    background-image: linear-gradient(135deg, #cfe4c9, #9ec295);
    z-index: 1;
    transform: translate(0, 0);
  }
 
  .tt-card--gone {
    transform: translateY(140%) !important;
    opacity: 0;
    pointer-events: none;
  }
 
  .tt-card--front { cursor: pointer; }
  .tt-card--waiting { cursor: default; }
 
  .tt-card-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
 
  .tt-card-step {
    font-family: 'MaoWei', sans-serif;
    font-size: clamp(2.75rem, 6vw, 4.5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    opacity: 0.95;
  }
 
  .tt-card-title {
    font-family: 'MaoWei', sans-serif;
    font-size: clamp(1.3rem, 2.2vw, 1.8rem);
    font-weight: 700;
    margin: 0 0 0.6rem 0;
    line-height: 1.2;
  }
 
  .tt-card-desc {
    font-family: 'MaoWei', sans-serif;
    font-size: 0.95rem;
    line-height: 1.6;
    opacity: 0.92;
    margin: 0 0 1.25rem 0;
    max-width: 46ch;
  }
 
  .tt-card-link {
    font-family: 'MaoWei', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    color: #ffffff;
    text-decoration: none;
    align-self: flex-start;
    border-bottom: 1px solid rgba(255,255,255,0.6);
    padding-bottom: 2px;
    transition: opacity 0.2s ease;
  }
  .tt-card-link:hover { opacity: 0.75; }
 
  @media (max-width: 768px) {
    .tt-hero { padding-top: 6rem; }
    .tt-hero-head { margin-bottom: 2rem; }
    .tt-card { width: 97%; padding: 1.75rem; }
  }
 
  @media (prefers-reduced-motion: reduce) {
    .tt-card { transition: opacity 0.3s ease; }
  }

  /* ─── ECORAZÓN ACADEMY ─── */
  .acad-hero,
  .acad-hero *,
  .acad-hero *::before,
  .acad-hero *::after { box-sizing: border-box; }

  .acad-hero {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    background-color: #f7f5f0;
    background-image:
      radial-gradient(ellipse 60% 32% at 50% 36%, rgba(247,245,240,0.88) 0%, rgba(247,245,240,0.6) 45%, rgba(247,245,240,0) 100%),
      linear-gradient(to bottom, rgba(247,245,240,0) 50%, #f7f5f0 82%),
      url('/images/academy.png');
    background-size: 100% 100%, 100% 100%, cover;
    background-position: center top, center top, center top;
    background-repeat: no-repeat;
    overflow: hidden;
  }

  .acad-top {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem clamp(1rem, 4vw, 3rem) 6rem;
    min-height: 75vh;
  }

  .acad-eyebrow {
    font-family: 'MaoWei', sans-serif;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0.32em;
    text-indent: 0.32em;      
    color: #6b8f76;
    margin-bottom: 0.9rem;
    text-shadow: 0 0 12px rgba(247,245,240,1);
  }

  .acad-title {
    font-family: 'MaoWei', sans-serif;
    font-weight: 900;
    font-size: 70px;
    line-height: 1.05;
    color: black;
    margin: 0 0 1.25rem;
    text-shadow:
      0 0 28px rgba(247,245,240,0.95),
      0 0 10px rgba(247,245,240,0.8);
  }

  .acad-intro {
    font-family: 'MaoWei', sans-serif;
    font-size: 1.1rem;
    line-height: 1.7;
    max-width: 52ch;
    margin: 0 0 2rem;
    color: rgba(0,0,0,0.85);  
    font-weight: 600;
    text-shadow:
      0 0 18px rgba(247,245,240,1),
      0 0 6px rgba(247,245,240,0.9);
  }

  .acad-intro span {
    display: block;
    margin-top: 0.5rem;
    font-size: 1rem;
    font-weight: 500;
    color: rgba(0,0,0,0.65);
  }

  .acad-cta {
    font-family: 'MaoWei', sans-serif;
    font-weight: 600;
    font-size: 1rem;
    color: #fff;
    text-decoration: none;
    padding: 1rem 2.25rem;
    border-radius: 999px;
    background: linear-gradient(135deg, #6b8f76, #95BD8D);
    box-shadow: 0 14px 30px rgba(107,143,118,0.35);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .acad-cta:hover {
    transform: translateY(-3px);
    box-shadow: 0 18px 36px rgba(107,143,118,0.45);
  }

  /* floating tag pills */
  .acad-pill {
    position: absolute;
    font-family: 'MaoWei', sans-serif;
    font-weight: 600;
    font-size: 1rem;
    color: #000;
    background: #fff;
    padding: 1.1rem 2.25rem;
    border-radius: 999px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    white-space: nowrap;
  }
  .acad-pill--1 { left: 6%;  top: 42%; --rot: 8deg;   --hover: #6b8f76; }
  .acad-pill--2 { left: 1%;  top: 58%; --rot: -9deg;  --hover: #C08EA4; }
  .acad-pill--3 { left: 16%; top: 64%; --rot: -12deg; --hover: #a07850; }
  .acad-pill--4 { right: 4%; top: 38%; --rot: -8deg;  --hover: #4a7fae; }
  .acad-pill--5 { right: 6%; top: 58%; --rot: 14deg;  --hover: #c9a227; }

  .acad-pill {
    transform: rotate(var(--rot, 0deg));
    cursor: default;
    transition: background 0.3s ease, color 0.3s ease, transform 0.35s cubic-bezier(.22,.9,.34,1), box-shadow 0.3s ease;
  }
  .acad-pill:hover {
    background: var(--hover);
    color: #fff;
    transform: rotate(var(--rot, 0deg)) scale(1.08);
    box-shadow: 0 16px 36px rgba(0,0,0,0.16);
  }

  /* cursor echo — whole page: shapes are dropped along the cursor's path, then shrink and fade on their own */
  .acad-echo {
    position: fixed;
    inset: 0;
    z-index: 900;   /* above page content, below the course popup (2000) */
    pointer-events: none;
    overflow: hidden;
  }
  .acad-echo-item {
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    opacity: 0;
    will-change: transform, opacity;
  }
  .acad-echo-item svg { display: block; width: 100%; height: 100%; fill: currentColor; }

  @media (max-width: 900px) {
    .acad-pill { font-size: 0.85rem; padding: 0.8rem 1.4rem; }
    .acad-pill--3, .acad-pill--5 { display: none; }
    .acad-pill--1 { top: 18%; left: 2%; }
    .acad-pill--2 { top: 26%; left: auto; right: 2%; }
    .acad-pill--4 { top: auto; bottom: 8%; right: 4%; }
  }

  /* ─── ACADEMY COURSES CAROUSEL ─── */
.courses-hero,
.courses-hero *,
.courses-hero *::before,
.courses-hero *::after { box-sizing: border-box; }

.courses-hero {
  background: #f7f5f0;
  padding: 2rem 0 6rem;
}

.courses-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 clamp(1.5rem, 5vw, 4rem);
  margin-bottom: 2rem;
}

.courses-title {
  font-family: 'MaoWei', sans-serif;
  font-weight: 700;
  font-size: clamp(1.8rem, 3.2vw, 2.6rem);
