/* ─── COURSE DETAILS POPUP ─── */
.course-modal,
.course-modal *,
.course-modal *::before,
.course-modal *::after { box-sizing: border-box; }

.course-modal {
  position: fixed;
  inset: 0;
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1.5rem;
  opacity: 0;
  transition: opacity 0.3s ease;
}
.course-modal[hidden] { display: none; }
.course-modal.is-open { opacity: 1; }

.course-modal-backdrop {
  position: absolute;
