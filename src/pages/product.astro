---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const categories = [
  { id: 'all', label: 'All' },
  { id: 'mice', label: 'Curated MICE' },
  { id: 'gifts', label: 'Corporate Gifts' },
  { id: 'wellness', label: 'Wellness Initiatives' },
  { id: 'esg', label: 'ESG Solutions' },
];

const products = [
  { id: 1, category: 'mice', name: 'Exhibition Curation Package', desc: 'End-to-end event curation blending art, culture, and purpose.', img: '/images/1.png' },
  { id: 2, category: 'mice', name: 'Corporate Retreat Experience', desc: 'Meaningful team experiences designed around sustainability.', img: '/images/2.png' },
  { id: 3, category: 'mice', name: 'Themed Conference Design', desc: 'Immersive conference environments with a social impact narrative.', img: '/images/3.png' },
  { id: 4, category: 'gifts', name: 'Artisan Gift Set', desc: 'Handcrafted gifts by special needs artists using eco materials.', img: '/images/4.png' },
  { id: 5, category: 'gifts', name: 'Custom Branded Merchandise', desc: 'Bespoke products that carry your brand story sustainably.', img: '/images/5.png' },
  { id: 6, category: 'gifts', name: 'Seasonal Gift Collection', desc: 'Curated seasonal sets crafted from recycled and natural materials.', img: '/images/6.png' },
  { id: 7, category: 'wellness', name: 'Mindfulness Workshop Kit', desc: 'Wellness kits designed to nurture creativity and connection.', img: '/images/7.png' },
  { id: 8, category: 'wellness', name: 'Team Wellbeing Programme', desc: 'Structured programmes that foster belonging and mental wellness.', img: '/images/12.png' },
  { id: 9, category: 'esg', name: 'Sustainability Audit Pack', desc: 'Tools and guidance to align your brand with ESG commitments.', img: '/images/8.png' },
  { id: 10, category: 'esg', name: 'Green Impact Campaign', desc: 'Campaign design that communicates your environmental values.', img: '/images/9.png' },
  { id: 11, category: 'esg', name: 'Inclusive Community Kit', desc: 'Resources for building empowering, inclusive workplace cultures.', img: '/images/13.png' },
  { id: 12, category: 'mice', name: 'Pop-Up Gallery Experience', desc: 'Traveling art exhibitions that tell your brand\'s sustainability story.', img: '/images/11.png' },
];
---

<Layout title="Product - Ecorazón">
  <Header />

  <main class="product-page">

    <!-- Page Hero -->
    <section class="hero-gifts">
      <canvas id="giftCanvas" aria-hidden="true"></canvas>

      <div class="hero-content">
        <h1>
          <span class="line-big">Couldn't find the right gift</span>
          <span class="line-big">for that one special day?</span>
        </h1>
        <p class="line-small">
          Make it meaningful with<br />
          Ecorazón Atelier
        </p>

        <div class="hero-actions">
          <a href="#intro" class="btn btn-ghost">Who are we?</a>
          <a href="#bestsellers" class="btn btn-solid">Shop now!</a>
        </div>
      </div>
    </section>

    <!-- Intro / typed-word section -->
    <section class="intro-section" id="intro">
      <div class="intro-content">
        <h2 class="intro-title">Ecorazón Atelier</h2>
        <p class="intro-tagline">Meaningful gifts, thoughtfully curated.</p>
        <p class="intro-line">
          We offer bespoke corporate gifts for brands that care — about <span class="typed-wrap">
            <span id="typedWord" class="typed-word"></span><span class="typed-cursor">|</span>
          </span>
        </p>
      </div>
    </section>

    <!-- Product Catalog -->
    <section class="catalog-section">
      <div class="catalog-inner">

        <!-- Sidebar Filters -->
        <aside class="catalog-sidebar">
          <p class="sidebar-label">Categories</p>
          <ul class="filter-list">
            {categories.map(cat => (
              <li>
                <button
                  class="filter-btn"
                  data-category={cat.id}
                  data-active={cat.id === 'all' ? 'true' : 'false'}
                >
                  {cat.label}
                </button>
              </li>
            ))}
          </ul>
        </aside>

        <!-- Product Grid -->
        <div class="product-grid" id="productGrid">
          {products.map(product => (
            <div class="product-card" data-category={product.category}>
              <div class="product-img-wrap">
                <img src={product.img} alt={product.name} class="product-img" />
              </div>
              <div class="product-info">
                <h3 class="product-name">{product.name}</h3>
                <p class="product-desc">{product.desc}</p>
                <a href="/get-in-touch" class="product-cta">Enquire</a>
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style is:global>
  .product-page {
    padding-top: 72px;
  }

  /* ─── CATALOG ─── */
  .catalog-section {
    padding: 4rem clamp(2rem, 6vw, 6rem);
  }

  .catalog-inner {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 4rem;
    align-items: start;
  }

  /* ─── SIDEBAR ─── */
  .catalog-sidebar {
    position: sticky;
    top: 100px;
  }

  .sidebar-label {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #000000;
    opacity: 0.4;
    margin: 0 0 1rem 0;
  }

  .filter-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .filter-btn {
    width: 100%;
    text-align: left;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.95rem;
    font-weight: 400;
    color: #000000;
    background: transparent;
    border: 1px solid rgba(0,0,0,0.15);
    border-radius: 0;
    padding: 0.5rem 1rem;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .filter-btn:hover {
    background: rgba(149, 189, 141, 0.1);
    border-color: #95BD8D;
  }

  .filter-btn[data-active="true"] {
    background: #95BD8D;
    color: #ffffff;
    border-color: #95BD8D;
    font-weight: 600;
  }

  /* ─── PRODUCT GRID ─── */
  .product-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .product-card {
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(0,0,0,0.08);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }

  .product-card:hover {
    box-shadow: 0 8px 24px rgba(0,0,0,0.08);
    transform: translateY(-4px);
  }

  .product-card.hidden {
    display: none;
  }

  .product-img-wrap {
    width: 100%;
    aspect-ratio: 4/3;
    overflow: hidden;
    background: #f0f4f0;
  }

  .product-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .product-card:hover .product-img {
    transform: scale(1.03);
  }

  .product-info {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .product-name {
    font-family: 'DM Sans', sans-serif;
    font-weight: 700;
    font-size: 1rem;
    color: #000000;
    margin: 0 0 0.5rem 0;
  }

  .product-desc {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.875rem;
    color: #000000;
    opacity: 0.6;
    margin: 0 0 1.25rem 0;
    line-height: 1.6;
    flex: 1;
  }

  .product-cta {
    display: inline-block;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    color: #ffffff;
    background: #95BD8D;
    text-decoration: none;
    padding: 0.5rem 1.25rem;
    border-radius: 0;
    align-self: flex-start;
    transition: background 0.2s ease;
  }

  .product-cta:hover {
    background: #C08EA4;
  }

  /* ─── MOBILE ─── */
  @media (max-width: 768px) {
    .catalog-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .catalog-sidebar {
      position: static;
    }

    .filter-list {
      flex-direction: row;
      flex-wrap: wrap;
    }

    .filter-btn {
      width: auto;
    }

    .product-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .product-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<!-- ─── HERO STYLES + SCRIPT ─── -->
<style>
  .hero-gifts {
    position: relative;
    width: 100%;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: #faf8f4;
  }

  #giftCanvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 90vw;
    margin: 0 auto;
    padding: 0 1.5rem;
    pointer-events: none;
  }

  .hero-content h1 {
    font-family: 'MaoWei', serif;
    font-weight: 800;
    line-height: 1.15;
    margin: 0 auto 1.25rem;
    width: 100%;
    text-align: center;
  }

  .line-big {
    display: block;
    width: 100%;
    white-space: nowrap;
    font-size: clamp(1.75rem, 5.2vw, 4.5rem);
    color: #2b2b28;
    text-align: center;
  }

  .line-small {
    font-family: 'MaoWei', serif;
    font-size: clamp(1.1rem, 2.2vw, 1.5rem);
    color: #5f5e5a;
    margin: 0 0 2.25rem;
    line-height: 1.5;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    pointer-events: auto;
  }

  .btn {
    display: inline-block;
    padding: 0.85rem 1.75rem;
    border-radius: 999px;
    font-size: 1rem;
    font-weight: 500;
    text-decoration: none;
    transition: transform 0.2s ease, background 0.2s ease, color 0.2s ease;
  }

  .btn-ghost {
    border: 1.5px solid #95bd8d;
    color: #3b6d11;
    background: transparent;
  }
  .btn-ghost:hover {
    background: #95bd8d;
    color: #fff;
    transform: translateY(-2px);
  }

  .btn-solid {
    background: #95bd8d;
    color: #fff;
    border: 1.5px solid #95bd8d;
  }
  .btn-solid:hover {
    background: #7fa878;
    transform: translateY(-2px);
  }

  @media (max-width: 640px) {
    .hero-gifts {
      min-height: 100svh;
    }
    .hero-actions {
      flex-direction: column;
      align-items: center;
      width: 100%;
    }
    .btn {
      width: 100%;
      max-width: 260px;
      text-align: center;
    }
    .line-big {
      white-space: normal;
      font-size: clamp(1.5rem, 6.5vw, 2.1rem);
      text-align: center;
    }
    .hero-content {
      max-width: 100%;
      padding: 0 1rem;
    }
  }
</style>

<script is:inline>
  (function () {
    function init() {
      var canvas = document.getElementById('giftCanvas');
      var section = canvas.closest('.hero-gifts');
      var ctx = canvas.getContext('2d');
      var W, H;

      function resize() {
        W = section.clientWidth;
        H = section.clientHeight;
        canvas.width = W * devicePixelRatio;
        canvas.height = H * devicePixelRatio;
        canvas.style.width = W + 'px';
        canvas.style.height = H + 'px';
        ctx.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0);
      }
      resize();
      window.addEventListener('resize', resize);

      var palette = [
        { box: '#95BD8D', ribbon: '#5F8A57' },
        { box: '#E8C1A0', ribbon: '#C68A55' },
        { box: '#D8A0A8', ribbon: '#B06B78' },
        { box: '#B7C7DA', ribbon: '#7E97B5' },
        { box: '#EFE3C8', ribbon: '#CBAE7A' }
      ];

      function drawGiftBox(ctx, size, colors, rotation) {
        var s = size;
        ctx.save();
        ctx.rotate(rotation);

        ctx.fillStyle = colors.box;
        ctx.fillRect(-s / 2, -s / 2, s, s);

        ctx.fillStyle = colors.ribbon;
        ctx.fillRect(-s * 0.09, -s / 2, s * 0.18, s);
        ctx.fillRect(-s / 2, -s * 0.09, s, s * 0.18);

        ctx.beginPath();
        ctx.ellipse(-s * 0.16, -s / 2, s * 0.14, s * 0.1, 0.5, 0, Math.PI * 2);
        ctx.ellipse(s * 0.16, -s / 2, s * 0.14, s * 0.1, -0.5, 0, Math.PI * 2);
        ctx.fill();
        ctx.beginPath();
        ctx.arc(0, -s / 2, s * 0.08, 0, Math.PI * 2);
        ctx.fill();

        ctx.restore();
      }

      var N = 26;
      var boxes = [];
      for (var i = 0; i < N; i++) {
        var ang = Math.random() * Math.PI * 2;
        var speed = 0.1 + Math.random() * 0.18;
        boxes.push({
          x: Math.random() * W,
          y: Math.random() * H,
          vx: Math.cos(ang) * speed,
          vy: Math.sin(ang) * speed,
          size: 80 + Math.pow(Math.random(), 1.3) * 160,
          rot: Math.random() * Math.PI,
          rotSpeed: (Math.random() - 0.5) * 0.004,
          colors: palette[i % palette.length],
          opacity: 0.55 + Math.random() * 0.4
        });
      }

      var mouse = { x: -9999, y: -9999, active: false };
      section.addEventListener('mousemove', function (e) {
        var rect = section.getBoundingClientRect();
        mouse.x = e.clientX - rect.left;
        mouse.y = e.clientY - rect.top;
        mouse.active = true;
      });
      section.addEventListener('mouseleave', function () {
        mouse.active = false;
      });
      section.addEventListener(
        'touchmove',
        function (e) {
          var rect = section.getBoundingClientRect();
          var t = e.touches[0];
          mouse.x = t.clientX - rect.left;
          mouse.y = t.clientY - rect.top;
          mouse.active = true;
        },
        { passive: true }
      );

      var sweepRadius = 190;
      var maxSpeed = 6;

      function tick() {
        ctx.clearRect(0, 0, W, H);
        for (var i = 0; i < boxes.length; i++) {
          var b = boxes[i];

          if (mouse.active) {
            var dx = b.x - mouse.x,
              dy = b.y - mouse.y;
            var dist = Math.sqrt(dx * dx + dy * dy) || 0.001;
            if (dist < sweepRadius) {
              var force = (1 - dist / sweepRadius) * 2.6;
              b.vx += (dx / dist) * force;
              b.vy += (dy / dist) * force;
            }
          }

          b.vx *= 0.985;
          b.vy *= 0.985;

          var sp = Math.sqrt(b.vx * b.vx + b.vy * b.vy);
          if (sp > maxSpeed) {
            b.vx = (b.vx / sp) * maxSpeed;
            b.vy = (b.vy / sp) * maxSpeed;
          }
          if (sp < 0.08) {
            b.vx += (Math.random() - 0.5) * 0.04;
            b.vy += (Math.random() - 0.5) * 0.04;
          }

          b.x += b.vx;
          b.y += b.vy;
          b.rot += b.rotSpeed + b.vx * 0.002;

          var half = b.size / 2;
          if (b.x - half < 0) {
            b.x = half;
            b.vx *= -0.6;
          }
          if (b.x + half > W) {
            b.x = W - half;
            b.vx *= -0.6;
          }
          if (b.y - half < 0) {
            b.y = half;
            b.vy *= -0.6;
          }
          if (b.y + half > H) {
            b.y = H - half;
            b.vy *= -0.6;
          }

          ctx.save();
          ctx.globalAlpha = b.opacity;
          ctx.translate(b.x, b.y);
          drawGiftBox(ctx, b.size, b.colors, b.rot);
          ctx.restore();
        }
        requestAnimationFrame(tick);
      }
      tick();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>

<!-- ─── PRODUCT FILTER SCRIPT ─── -->
<script is:inline>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const productCards = document.querySelectorAll('.product-card');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.setAttribute('data-active', 'false'));
      btn.setAttribute('data-active', 'true');

      const selected = btn.getAttribute('data-category');

      productCards.forEach(card => {
        if (selected === 'all' || card.getAttribute('data-category') === selected) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    });
  });
</script>

<!-- ─── INTRO / TYPED-WORD STYLES + SCRIPT ─── -->
<style>
  .intro-section {
    position: relative;
    width: 100%;
    min-height: 100vh;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 1.5rem;
    overflow: hidden;
  }

  .intro-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url('/images/gradient-bg-1.png') center center / cover no-repeat;
    opacity: 0.6;
    z-index: 0;
  }

  .intro-content {
    position: relative;
    z-index: 1;
    max-width: 50rem;
    text-align: center;
  }

  .intro-title {
    font-family: 'MaoWei', serif;
    font-weight: 700;
    font-size: clamp(2rem, 5vw, 3.5rem);
    color: #2b2b28;
    margin: 0 0 1rem;
  }

  .intro-tagline {
    font-family: 'MaoWei', serif;
    font-size: clamp(1.1rem, 2.2vw, 1.6rem);
    color: #5f5e5a;
    margin: 0 0 2rem;
  }

  .intro-line {
    font-family: 'MaoWei', serif;
    font-weight: 500;
    font-size: clamp(1.4rem, 3.2vw, 2.4rem);
    line-height: 1.4;
    color: #2b2b28;
    margin: 0;
  }

  .typed-wrap {
    display: inline-flex;
    align-items: baseline;
  }

  .typed-word {
    color: #95bd8d;
    font-weight: 700;
    white-space: pre;
  }

  .typed-cursor {
    color: #95bd8d;
    font-weight: 400;
    margin-left: 2px;
    animation: blink 0.9s step-end infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  @media (max-width: 640px) {
    .intro-section {
      min-height: 70vh;
      padding: 3rem 1.5rem;
    }
  }
</style>

<script is:inline>
  (function () {
    function init() {
      var el = document.getElementById('typedWord');
      if (!el) return;

      var words = ['people.', 'planet.', 'purpose.'];
      var wordIndex = 0;
      var charIndex = 0;
      var typing = true;
      var typeSpeed = 90;
      var deleteSpeed = 55;
      var pauseAfterType = 1100;
      var pauseAfterDelete = 250;

      function tick() {
        var current = words[wordIndex];

        if (typing) {
          charIndex++;
          el.textContent = current.slice(0, charIndex);
          if (charIndex === current.length) {
            typing = false;
            setTimeout(tick, pauseAfterType);
            return;
          }
          setTimeout(tick, typeSpeed);
        } else {
          charIndex--;
          el.textContent = current.slice(0, charIndex);
          if (charIndex === 0) {
            typing = true;
            wordIndex = (wordIndex + 1) % words.length;
            setTimeout(tick, pauseAfterDelete);
            return;
          }
          setTimeout(tick, deleteSpeed);
        }
      }

      tick();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>