<script is:inline>
  (function () {
    function init() {
      var canvas = document.getElementById('giftCanvas');
      var section = canvas.closest('.hero-gifts');
      var ctx = canvas.getContext('2d');
      var W, H;

      function resize() {
        W = section.clientWidth;
        H = section.clientHeight;
        canvas.width = W * devicePixelRatio;
        canvas.height = H * devicePixelRatio;
        canvas.style.width = W + 'px';
        canvas.style.height = H + 'px';
        ctx.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0);
      }
      resize();
      window.addEventListener('resize', resize);

      var palette = [
        { box: '#95BD8D', ribbon: '#5F8A57' },
        { box: '#E8C1A0', ribbon: '#C68A55' },
        { box: '#D8A0A8', ribbon: '#B06B78' },
        { box: '#B7C7DA', ribbon: '#7E97B5' },
        { box: '#EFE3C8', ribbon: '#CBAE7A' }
      ];

      function drawGiftBox(ctx, size, colors, rotation) {
        var s = size;
        ctx.save();
        ctx.rotate(rotation);

        ctx.fillStyle = colors.box;
        ctx.fillRect(-s / 2, -s / 2, s, s);

        ctx.fillStyle = colors.ribbon;
        ctx.fillRect(-s * 0.09, -s / 2, s * 0.18, s);
        ctx.fillRect(-s / 2, -s * 0.09, s, s * 0.18);

        ctx.beginPath();
        ctx.ellipse(-s * 0.16, -s / 2, s * 0.14, s * 0.1, 0.5, 0, Math.PI * 2);
        ctx.ellipse(s * 0.16, -s / 2, s * 0.14, s * 0.1, -0.5, 0, Math.PI * 2);
        ctx.fill();
        ctx.beginPath();
        ctx.arc(0, -s / 2, s * 0.08, 0, Math.PI * 2);
        ctx.fill();

        ctx.restore();
      }

      var N = 26;
      var boxes = [];
      for (var i = 0; i < N; i++) {
        var ang = Math.random() * Math.PI * 2;
        var speed = 0.1 + Math.random() * 0.18;
        boxes.push({
          x: Math.random() * W,
          y: Math.random() * H,
          vx: Math.cos(ang) * speed,
          vy: Math.sin(ang) * speed,
          size: 80 + Math.pow(Math.random(), 1.3) * 160,
          rot: Math.random() * Math.PI,
          rotSpeed: (Math.random() - 0.5) * 0.004,
          colors: palette[i % palette.length],
          opacity: 0.55 + Math.random() * 0.4
        });
      }

      var mouse = { x: -9999, y: -9999, active: false };
      section.addEventListener('mousemove', function (e) {
        var rect = section.getBoundingClientRect();
        mouse.x = e.clientX - rect.left;
        mouse.y = e.clientY - rect.top;
        mouse.active = true;
      });
      section.addEventListener('mouseleave', function () {
        mouse.active = false;
      });
      section.addEventListener(
        'touchmove',
        function (e) {
          var rect = section.getBoundingClientRect();
          var t = e.touches[0];
          mouse.x = t.clientX - rect.left;
          mouse.y = t.clientY - rect.top;
          mouse.active = true;
        },
        { passive: true }
      );

      var sweepRadius = 190;
      var maxSpeed = 6;

      function tick() {
        ctx.clearRect(0, 0, W, H);
        for (var i = 0; i < boxes.length; i++) {
          var b = boxes[i];

          if (mouse.active) {
            var dx = b.x - mouse.x,
              dy = b.y - mouse.y;
            var dist = Math.sqrt(dx * dx + dy * dy) || 0.001;
            if (dist < sweepRadius) {
              var force = (1 - dist / sweepRadius) * 2.6;
              b.vx += (dx / dist) * force;
              b.vy += (dy / dist) * force;
            }
          }

          b.vx *= 0.985;
          b.vy *= 0.985;

          var sp = Math.sqrt(b.vx * b.vx + b.vy * b.vy);
          if (sp > maxSpeed) {
            b.vx = (b.vx / sp) * maxSpeed;
            b.vy = (b.vy / sp) * maxSpeed;
          }
          if (sp < 0.08) {
            b.vx += (Math.random() - 0.5) * 0.04;
            b.vy += (Math.random() - 0.5) * 0.04;
          }

          b.x += b.vx;
          b.y += b.vy;
          b.rot += b.rotSpeed + b.vx * 0.002;

          var half = b.size / 2;
          if (b.x - half < 0) {
            b.x = half;
            b.vx *= -0.6;
          }
          if (b.x + half > W) {
            b.x = W - half;
            b.vx *= -0.6;
          }
          if (b.y - half < 0) {
            b.y = half;
            b.vy *= -0.6;
          }
          if (b.y + half > H) {
            b.y = H - half;
            b.vy *= -0.6;
          }

          ctx.save();
          ctx.globalAlpha = b.opacity;
          ctx.translate(b.x, b.y);
          drawGiftBox(ctx, b.size, b.colors, b.rot);
          ctx.restore();
        }
        requestAnimationFrame(tick);
      }
      tick();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>

<!-- ─── PRODUCT FILTER SCRIPT (Category + Series + Gift Levels + Tags, all AND-combined) ─── -->
<script is:inline>
  (function () {
    var categoryBtns = document.querySelectorAll('.category-btn');
    var seriesChecks = document.querySelectorAll('.series-filter');
    var giftlevelChecks = document.querySelectorAll('.giftlevel-filter');
    var tagChecks = document.querySelectorAll('.tag-filter');
    var productCards = document.querySelectorAll('.product-card');

    var activeCategory = 'all';

    function getCheckedValues(nodeList) {
      return Array.prototype.slice.call(nodeList)
        .filter(function (cb) { return cb.checked; })
        .map(function (cb) { return cb.value; });
    }

    function matches(card) {
      if (activeCategory !== 'all' && card.getAttribute('data-category') !== activeCategory) {
        return false;
      }

      var series = getCheckedValues(seriesChecks);
      if (series.length) {
        var cardSeries = (card.getAttribute('data-series') || '').split('|');
        var hasSeries = series.some(function (s) { return cardSeries.indexOf(s) !== -1; });
        if (!hasSeries) return false;
      }

      var levels = getCheckedValues(giftlevelChecks);
      if (levels.length) {
        var cardLevels = (card.getAttribute('data-giftlevels') || '').split('|');
        var hasLevel = levels.some(function (l) { return cardLevels.indexOf(l) !== -1; });
        if (!hasLevel) return false;
      }

      var tags = getCheckedValues(tagChecks);
      if (tags.length) {
        var cardTags = (card.getAttribute('data-tags') || '').split('|');
        var hasTag = tags.some(function (t) { return cardTags.indexOf(t) !== -1; });
        if (!hasTag) return false;
      }

      return true;
    }

    function applyFilters() {
      productCards.forEach(function (card) {
        card.classList.toggle('hidden', !matches(card));
      });
    }

    categoryBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        categoryBtns.forEach(function (b) { b.setAttribute('data-active', 'false'); });
        btn.setAttribute('data-active', 'true');
        activeCategory = btn.getAttribute('data-category');
        applyFilters();
      });
    });

    [seriesChecks, giftlevelChecks, tagChecks].forEach(function (group) {
      group.forEach(function (cb) {
        cb.addEventListener('change', applyFilters);
      });
    });
  })();
</script>

