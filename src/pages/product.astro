---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import productsRaw from '../data/products.json';
import taxonomyRaw from '../data/product-taxonomy.json';

type Product = {
  id: number;
  category: string;
  name: string;
  desc: string;
  img: string;
  series: string[];
  giftLevels: string[];
  tags: string[];
};

type Taxonomy = {
  series: string[];
  giftLevels: string[];
  tags: string[];
};

const products = productsRaw as Product[];
const taxonomy = taxonomyRaw as Taxonomy;

const categories = [
  { id: 'all', label: 'All' },
  { id: 'mice', label: 'Curated MICE' },
  { id: 'gifts', label: 'Corporate Gifts' },
  { id: 'wellness', label: 'Wellness Initiatives' },
  { id: 'esg', label: 'ESG Solutions' },
];
---

<Layout title="Product - Ecorazón">
  <Header />

  <main class="product-page">

    <!-- Page Hero -->
    <section class="hero-gifts">
      <canvas id="giftCanvas" aria-hidden="true"></canvas>

      <div class="hero-content">
        <h1>
          <span class="line-big">Couldn't find the right gift</span>
          <span class="line-big">for that one special day?</span>
        </h1>
        <p class="line-small">
          Make it meaningful with<br />
          Ecorazón Atelier
        </p>

        <div class="hero-actions">
          <a href="#intro" class="btn btn-ghost">Who are we?</a>
          <a href="#catalog" class="btn btn-solid">Shop now!</a>
        </div>
      </div>
    </section>

    <!-- Intro / typed-word section -->
    <section class="intro-section" id="intro">
      <div class="intro-content">
        <h2 class="intro-title">Ecorazón Atelier</h2>
        <p class="intro-tagline">Meaningful gifts, thoughtfully curated.</p>
        <p class="intro-line">
          We offer bespoke corporate gifts for brands that care — about <span class="typed-wrap">
            <span id="typedWord" class="typed-word"></span><span class="typed-cursor">|</span>
          </span>
        </p>
      </div>
    </section>

    <!-- Cycle Showcase -->
 
    <section class="cycle-showcase">
      <div class="cycle-hero-row">
        <span class="bg-letter bg-letter-left" aria-hidden="true">G</span>
    
        <div class="cycle-circles">
          <div class="cycle-circle circle-message">
            <span class="circle-arrow">↗</span>
            <p>Gifts with meaning created through sustainable materials, distinctive design and artist collaboration.</p>
          </div>
    
          <div class="cycle-circle circle-photo circle-photo-1" style="background-image:url('/images/c.jpg');">
          </div>
    
          <div class="cycle-circle circle-photo circle-photo-2" style="background-image:url('/images/c1.jpg');">
            <a href="#catalog" class="cycle-learn-more">
              Learn More <span>↗</span>
            </a>
          </div>
    
          <h2 class="cycle-wordmark">C.Y.C.L.E.</h2>
        </div>
    
        <span class="bg-letter bg-letter-right" aria-hidden="true">d</span>
      </div>
    
      <div class="cycle-cards">
        <a href="#testimonials" class="cycle-card">
          <div class="cycle-card-text">
            <h3>Original Design</h3>
            <span class="cycle-explore-btn">Explore</span>
          </div>
          <div class="cycle-card-photo" style="background-image:url('/images/ricehusk.jpg');"></div>
          <div class="cycle-card-circle" style="background-image:url('/images/ricehusk.jpg');" aria-hidden="true"></div>
          <span class="cycle-card-arrow">↗</span>
        </a>

        <a href="#artists" class="cycle-card">
          <div class="cycle-card-text">
            <h3>Cultural Artistry</h3>
            <span class="cycle-explore-btn">Explore</span>
          </div>
          <div class="cycle-card-photo" style="background-image:url('/images/coffee.jpg');"></div>
          <div class="cycle-card-circle" style="background-image:url('/images/coffee.jpg');" aria-hidden="true"></div>
          <span class="cycle-card-arrow">↗</span>
        </a>

        <a href="#catalog" class="cycle-card">
          <div class="cycle-card-text">
            <h3>Sustainable Materials</h3>
            <span class="cycle-explore-btn">Explore</span>
          </div>
          <div class="cycle-card-photo" style="background-image:url('/images/c3.jpg');"></div>
          <div class="cycle-card-circle" style="background-image:url('/images/c3.jpg');" aria-hidden="true"></div>
          <span class="cycle-card-arrow">↗</span>
        </a>
      </div>
    </section>

    <!-- Testimonials / Trust Section -->
    <section class="trust-section" id="testimonials">
      <div class="trust-collage">

        <div class="trust-col trust-col-tall">
          <div class="trust-img" style="background-image:url('/images/1.png');"></div>
          <div class="trust-img" style="background-image:url('/images/2.png');"></div>
        </div>

        <div class="trust-col trust-col-short">
          <div class="trust-img" style="background-image:url('/images/3.png');"></div>
          <div class="trust-img" style="background-image:url('/images/4.png');"></div>
          <div class="trust-img" style="background-image:url('/images/5.png');"></div>
        </div>

        <div class="trust-col trust-col-mid">
          <div class="trust-img trust-img-lg" style="background-image:url('/images/6.png');"></div>
          <div class="trust-img" style="background-image:url('/images/7.png');"></div>
        </div>

        <div class="trust-col trust-col-peak">
          <div class="trust-img trust-img-xl" style="background-image:url('/images/8.png');"></div>
        </div>

        <div class="trust-col trust-col-peak">
          <div class="trust-img trust-img-xl" style="background-image:url('/images/9.png');"></div>
        </div>

        <div class="trust-col trust-col-mid">
          <div class="trust-img trust-img-lg" style="background-image:url('/images/10.png');"></div>
        </div>

        <div class="trust-col trust-col-short">
          <div class="trust-img" style="background-image:url('/images/11.png');"></div>
          <div class="trust-img" style="background-image:url('/images/12.png');"></div>
          <div class="trust-img" style="background-image:url('/images/13.png');"></div>
        </div>

        <div class="trust-col trust-col-tall">
          <div class="trust-img" style="background-image:url('/images/14.png');"></div>
          <div class="trust-img" style="background-image:url('/images/15.png');"></div>
        </div>

      </div>

      <div class="trust-heading">
        <span class="trust-pill">Testimonials</span>
        <h2 class="trust-title">
          Trusted by creatives and leaders<br />
          <span class="trust-title-sub">from various industries</span>
        </h2>
        <p class="trust-blurb">
          For brands, events, and communities, we turn everyday gifting into
          something more thoughtful, more memorable, and more human.
        </p>
      </div>

      <div class="trust-cards">
        <div class="trust-card">
          <div class="trust-stars">
            <span class="star">★</span><span class="star">★</span><span class="star">★</span><span class="star">★</span><span class="star">★</span>
          </div>
          <p class="trust-quote">"WorkNook makes finding a coworking space so easy! I can book a desk in minutes and get straight to work. Highly recommend!"</p>
          <div class="trust-author">
            <div class="trust-avatar" style="background-image:url('/images/A1.png');"></div>
            <div>
              <p class="trust-name">Joao M.</p>
              <p class="trust-role">Startup Founder</p>
            </div>
          </div>
        </div>

        <div class="trust-card">
          <div class="trust-stars">
            <span class="star">★</span><span class="star">★</span><span class="star">★</span><span class="star">★</span><span class="star">★</span>
          </div>
          <p class="trust-quote">Our team needed a flexible meeting space, and WorkNook delivered. The process was smooth, and the space was exactly what we needed!</p>
          <div class="trust-author">
            <div class="trust-avatar" style="background-image:url('/images/A2.png');"></div>
            <div>
              <p class="trust-name">Bruno K.</p>
              <p class="trust-role">UX Designer</p>
            </div>
          </div>
        </div>

        <div class="trust-card">
          <div class="trust-stars">
            <span class="star">★</span><span class="star">★</span><span class="star">★</span><span class="star">★</span><span class="star">★</span>
          </div>
          <p class="trust-quote">"I love the variety of spaces available! Whether I need a quiet spot or a collaborative space, WorkNook always has the perfect option."</p>
          <div class="trust-author">
            <div class="trust-avatar" style="background-image:url('/images/A3.png');"></div>
            <div>
              <p class="trust-name">Lais A.</p>
              <p class="trust-role">Digital Marketer</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Artists We Create With -->
    <section class="artists-section" id="artists">
      <div class="artists-inner">
        <div class="artists-text">
          <p>
            We collaborate with diverse neurodivergent artists whose perspectives bring depth, originality, and emotional resonance to our work. These collaborations are not decorative add-ons, but part of how we create products with real human meaning.
          </p>
        </div>

        <div class="artists-columns">
          <div class="artists-col" data-direction="up">
            <div class="artists-col-track">
              <div class="artist-card">
                <div class="artist-photo" style="background-image:url('https://picsum.photos/seed/artist1/420/540'); --clip: polygon(8% 0%, 45% 3%, 100% 8%, 96% 55%, 100% 100%, 40% 96%, 0% 100%, 3% 45%);"></div>
                <div class="artist-info"><p class="artist-name">Jordan Ellery</p><p class="artist-role">Visual Artist</p></div>
              </div>
              <div class="artist-card">
                <div class="artist-photo" style="background-image:url('https://picsum.photos/seed/artist4/420/540'); --clip: polygon(0% 0%, 60% 0%, 96% 10%, 100% 60%, 90% 100%, 35% 96%, 5% 100%, 0% 40%);"></div>
                <div class="artist-info"><p class="artist-name">Rae Whitfield</p><p class="artist-role">Sculptor</p></div>
              </div>
              <div class="artist-card">
                <div class="artist-photo" style="background-image:url('https://picsum.photos/seed/artist7/420/540'); --clip: polygon(5% 0%, 100% 4%, 95% 40%, 100% 90%, 60% 100%, 15% 97%, 0% 60%, 8% 20%);"></div>
                <div class="artist-info"><p class="artist-name">Bea Halvorsen</p><p class="artist-role">Mixed Media</p></div>
              </div>
              <div class="artist-card">
                <div class="artist-photo" style="background-image:url('https://picsum.photos/seed/artist10/420/540'); --clip: polygon(0% 8%, 30% 0%, 90% 5%, 100% 45%, 97% 85%, 65% 100%, 10% 100%, 0% 55%);"></div>
                <div class="artist-info"><p class="artist-name">Priya Chandran</p><p class="artist-role">Muralist</p></div>
              </div>
              <!-- duplicate set for seamless loop -->
              <div class="artist-card">
                <div class="artist-photo" style="background-image:url('https://picsum.photos/seed/artist1/420/540'); --clip: polygon(8% 0%, 45% 3%, 100% 8%, 96% 55%, 100% 100%, 40% 96%, 0% 100%, 3% 45%);"></div>
                <div class="artist-info"><p class="artist-name">Jordan Ellery</p><p class="artist-role">Visual Artist</p></div>
              </div>
              <div class="artist-card">
                <div class="artist-photo" style="background-image:url('https://picsum.photos/seed/artist4/420/540'); --clip: polygon(0% 0%, 60% 0%, 96% 10%, 100% 60%, 90% 100%, 35% 96%, 5% 100%, 0% 40%);"></div>
                <div class="artist-info"><p class="artist-name">Rae Whitfield</p><p class="artist-role">Sculptor</p></div>
              </div>
              <div class="artist-card">
                <div class="artist-photo" style="background-image:url('https://picsum.photos/seed/artist7/420/540'); --clip: polygon(5% 0%, 100% 4%, 95% 40%, 100% 90%, 60% 100%, 15% 97%, 0% 60%, 8% 20%);"></div>
                <div class="artist-info"><p class="artist-name">Bea Halvorsen</p><p class="artist-role">Mixed Media</p></div>
              </div>
              <div class="artist-card">
                <div class="artist-photo" style="background-image:url('https://picsum.photos/seed/artist10/420/540'); --clip: polygon(0% 8%, 30% 0%, 90% 5%, 100% 45%, 97% 85%, 65% 100%, 10% 100%, 0% 55%);"></div>
                <div class="artist-info"><p class="artist-name">Priya Chandran</p><p class="artist-role">Muralist</p></div>
              </div>
            </div>
          </div>

          <div class="artists-col" data-direction="down">
            <div class="artists-col-track">
              <div class="artist-card">
                <div class="artist-photo" style="background-image:url('https://picsum.photos/seed/artist2/420/540'); --clip: polygon(10% 0%, 70% 4%, 100% 30%, 95% 70%, 100% 100%, 40% 95%, 0% 100%, 5% 40%);"></div>
                <div class="artist-info"><p class="artist-name">Mika Sato</p><p class="artist-role">Textile Artist</p></div>
              </div>
              <div class="artist-card">
                <div class="artist-photo" style="background-image:url('https://picsum.photos/seed/artist5/420/540'); --clip: polygon(0% 5%, 40% 0%, 100% 8%, 90% 50%, 100% 90%, 55% 100%, 0% 95%, 8% 50%);"></div>
                <div class="artist-info"><p class="artist-name">Lena Osei</p><p class="artist-role">Ceramicist</p></div>
              </div>
              <div class="artist-card">
                <div class="artist-photo" style="background-image:url('https://picsum.photos/seed/artist8/420/540'); --clip: polygon(6% 0%, 100% 6%, 92% 45%, 100% 80%, 70% 100%, 20% 100%, 0% 65%, 10% 25%);"></div>
                <div class="artist-info"><p class="artist-name">Kofi Amankwah</p><p class="artist-role">Painter</p></div>
              </div>
              <!-- duplicate set for seamless loop -->
              <div class="artist-card">
                <div class="artist-photo" style="background-image:url('https://picsum.photos/seed/artist2/420/540'); --clip: polygon(10% 0%, 70% 4%, 100% 30%, 95% 70%, 100% 100%, 40% 95%, 0% 100%, 5% 40%);"></div>
                <div class="artist-info"><p class="artist-name">Mika Sato</p><p class="artist-role">Textile Artist</p></div>
              </div>
              <div class="artist-card">
                <div class="artist-photo" style="background-image:url('https://picsum.photos/seed/artist5/420/540'); --clip: polygon(0% 5%, 40% 0%, 100% 8%, 90% 50%, 100% 90%, 55% 100%, 0% 95%, 8% 50%);"></div>
                <div class="artist-info"><p class="artist-name">Lena Osei</p><p class="artist-role">Ceramicist</p></div>
              </div>
              <div class="artist-card">
                <div class="artist-photo" style="background-image:url('https://picsum.photos/seed/artist8/420/540'); --clip: polygon(6% 0%, 100% 6%, 92% 45%, 100% 80%, 70% 100%, 20% 100%, 0% 65%, 10% 25%);"></div>
                <div class="artist-info"><p class="artist-name">Kofi Amankwah</p><p class="artist-role">Painter</p></div>
              </div>
            </div>
          </div>

          <div class="artists-col" data-direction="up">
            <div class="artists-col-track">
              `<div class="artist-card">
                <div class="artist-photo" style="background-image:url('https://picsum.photos/seed/artist3/420/540'); --clip: polygon(0% 0%, 55% 0%, 100% 20%, 92% 60%, 100% 100%, 30% 100%, 0% 70%, 8% 30%);"></div>
                <div class="artist-info"><p class="artist-name">Noor Adisa</p><p class="artist-role">Illustrator</p></div>
              </div>
              <div class="artist-card">
                <div class="artist-photo" style="background-image:url('https://picsum.photos/seed/artist6/420/540'); --clip: polygon(15% 0%, 100% 10%, 90% 55%, 100% 95%, 50% 100%, 0% 85%, 5% 45%, 0% 15%);"></div>
                <div class="artist-info"><p class="artist-name">Théo Marchand</p><p class="artist-role">Printmaker</p></div>
              </div>
              <div class="artist-card">
                <div class="artist-photo" style="background-image:url('https://picsum.photos/seed/artist9/420/540'); --clip: polygon(0% 10%, 45% 0%, 100% 5%, 95% 50%, 100% 100%, 60% 95%, 10% 100%, 0% 55%);"></div>
                <div class="artist-info"><p class="artist-name">Sana Ibarra</p><p class="artist-role">Photographer</p></div>
              </div>
              <!-- duplicate set for seamless loop -->
              <div class="artist-card">
                <div class="artist-photo" style="background-image:url('https://picsum.photos/seed/artist3/420/540'); --clip: polygon(0% 0%, 55% 0%, 100% 20%, 92% 60%, 100% 100%, 30% 100%, 0% 70%, 8% 30%);"></div>
                <div class="artist-info"><p class="artist-name">Noor Adisa</p><p class="artist-role">Illustrator</p></div>
              </div>
              <div class="artist-card">
                <div class="artist-photo" style="background-image:url('https://picsum.photos/seed/artist6/420/540'); --clip: polygon(15% 0%, 100% 10%, 90% 55%, 100% 95%, 50% 100%, 0% 85%, 5% 45%, 0% 15%);"></div>
                <div class="artist-info"><p class="artist-name">Théo Marchand</p><p class="artist-role">Printmaker</p></div>
              </div>
              <div class="artist-card">
                <div class="artist-photo" style="background-image:url('https://picsum.photos/seed/artist9/420/540'); --clip: polygon(0% 10%, 45% 0%, 100% 5%, 95% 50%, 100% 100%, 60% 95%, 10% 100%, 0% 55%);"></div>
                <div class="artist-info"><p class="artist-name">Sana Ibarra</p><p class="artist-role">Photographer</p></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Product Catalog -->
    <section class="catalog-section" id="catalog">
      <div class="catalog-inner">

        <!-- Sidebar Filters -->
        <aside class="catalog-sidebar">
          <p class="sidebar-label">Categories</p>
          <ul class="filter-list">
            {categories.map(cat => (
              <li>
                <button
                  class="filter-btn category-btn"
                  data-category={cat.id}
                  data-active={cat.id === 'all' ? 'true' : 'false'}
                >
                  {cat.label}
                </button>
              </li>
            ))}
          </ul>

          {taxonomy.series.length > 0 && (
            <>
              <p class="sidebar-label sidebar-label-spaced">Series</p>
              <ul class="filter-list checkbox-filter-list">
                {taxonomy.series.map(s => (
                  <li>
                    <label class="checkbox-filter">
                      <input type="checkbox" class="series-filter" value={s} />
                      <span>{s}</span>
                    </label>
                  </li>
                ))}
              </ul>
            </>
          )}

          {taxonomy.giftLevels.length > 0 && (
            <>
              <p class="sidebar-label sidebar-label-spaced">Gift Levels</p>
              <ul class="filter-list checkbox-filter-list">
                {taxonomy.giftLevels.map(g => (
                  <li>
                    <label class="checkbox-filter">
                      <input type="checkbox" class="giftlevel-filter" value={g} />
                      <span>{g}</span>
                    </label>
                  </li>
                ))}
              </ul>
            </>
          )}

          {taxonomy.tags.length > 0 && (
            <>
              <p class="sidebar-label sidebar-label-spaced">Tags</p>
              <ul class="filter-list checkbox-filter-list">
                {taxonomy.tags.map(t => (
                  <li>
                    <label class="checkbox-filter">
                      <input type="checkbox" class="tag-filter" value={t} />
                      <span>{t}</span>
                    </label>
                  </li>
                ))}
              </ul>
            </>
          )}
        </aside>

        <!-- Product Grid -->
        <div class="product-grid" id="productGrid">
          {products.map(product => (
            <div
              class="product-card"
              data-category={product.category}
              data-series={(product.series || []).join('|')}
              data-giftlevels={(product.giftLevels || []).join('|')}
              data-tags={(product.tags || []).join('|')}
            >
              <div class="product-img-wrap">
                <img src={product.img} alt={product.name} class="product-img" />
              </div>
              <div class="product-info">
                <h3 class="product-name">{product.name}</h3>
                <p class="product-desc">{product.desc}</p>
                <a href="/get-in-touch" class="product-cta">Enquire</a>
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style is:global>
  .product-page {
    padding-top: 72px;
  }

  /* ─── CATALOG ─── */
  .catalog-section {
    padding: 4rem clamp(2rem, 6vw, 6rem);
  }

  .catalog-inner {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 4rem;
    align-items: start;
  }

  /* ─── SIDEBAR ─── */
  .catalog-sidebar {
    position: sticky;
    top: 100px;
    max-height: calc(100vh - 130px);
    overflow-y: auto;
  }

  .sidebar-label {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #000000;
    opacity: 0.4;
    margin: 0 0 1rem 0;
  }

  .sidebar-label-spaced {
    margin-top: 1.75rem;
  }

  .filter-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .filter-btn {
    width: 100%;
    text-align: left;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.95rem;
    font-weight: 400;
    color: #000000;
    background: transparent;
    border: 1px solid rgba(0,0,0,0.15);
    border-radius: 0;
    padding: 0.5rem 1rem;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .filter-btn:hover {
    background: rgba(149, 189, 141, 0.1);
    border-color: #95BD8D;
  }

  .filter-btn[data-active="true"] {
    background: #95BD8D;
    color: #ffffff;
    border-color: #95BD8D;
    font-weight: 600;
  }

  .checkbox-filter-list {
    gap: 0.4rem;
  }

  .checkbox-filter {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.88rem;
    color: #000000;
    opacity: 0.75;
    cursor: pointer;
  }

  .checkbox-filter input {
    accent-color: #95BD8D;
    width: 15px;
    height: 15px;
    cursor: pointer;
  }

  /* ─── PRODUCT GRID ─── */
  .product-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .product-card {
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(0,0,0,0.08);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }

  .product-card:hover {
    box-shadow: 0 8px 24px rgba(0,0,0,0.08);
    transform: translateY(-4px);
  }

  .product-card.hidden {
    display: none;
  }

  .product-img-wrap {
    width: 100%;
    aspect-ratio: 4/3;
    overflow: hidden;
    background: #f0f4f0;
  }

  .product-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .product-card:hover .product-img {
