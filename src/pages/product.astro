<script is:inline>
  (function () {
    function init() {
      var cols = document.querySelectorAll('.artists-col');
      if (!cols.length) return;

      var speed = 0.35; // px/frame

      cols.forEach(function (col) {
        var track = col.querySelector('.artists-col-track');
        if (!track) return;

        var direction = col.getAttribute('data-direction') === 'down' ? -1 : 1;
        var paused = false;
        var resumeTimeout = null;

        function halfHeight() { return track.scrollHeight / 2; }
        function setStart() { col.scrollTop = direction === -1 ? halfHeight() : 0; }
        setStart();

        function pause() {
          paused = true;
          if (resumeTimeout) clearTimeout(resumeTimeout);
        }
        function scheduleResume() {
          if (resumeTimeout) clearTimeout(resumeTimeout);
          resumeTimeout = setTimeout(function () { paused = false; }, 1200);
        }

        col.addEventListener('mouseenter', pause);
        col.addEventListener('mouseleave', scheduleResume);
        col.addEventListener('touchstart', pause, { passive: true });
        col.addEventListener('touchend', scheduleResume, { passive: true });
        col.addEventListener('wheel', pause, { passive: true });

        function frame() {
          if (!paused) {
            var half = halfHeight();
            col.scrollTop += speed * direction;
            if (direction === 1 && col.scrollTop >= half) col.scrollTop -= half;
            else if (direction === -1 && col.scrollTop <= 0) col.scrollTop += half;
          }
          requestAnimationFrame(frame);
        }
        requestAnimationFrame(frame);
      });

      window.addEventListener('load', function () {
        cols.forEach(function (col) {
          var direction = col.getAttribute('data-direction') === 'down' ? -1 : 1;
          var track = col.querySelector('.artists-col-track');
          if (!track) return;
          col.scrollTop = direction === -1 ? track.scrollHeight / 2 : 0;
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>

<script is:inline>
  (function () {
    function init() {
      var cards = document.querySelectorAll('.trust-card');
      if (!cards.length) return;

      if (!('IntersectionObserver' in window)) {
        cards.forEach(function (c) { c.classList.add('in-view'); });
        return;
      }

      var observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('in-view');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.3 }
      );

      cards.forEach(function (c) { observer.observe(c); });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>

<script is:inline>
  (function () {
    function init() {
      var collage = document.querySelector('.trust-collage');
      if (!collage) return;

      var imgs = Array.prototype.slice.call(collage.querySelectorAll('.trust-img'));
      if (!imgs.length) return;

      var state = imgs.map(function () { return { tx: 0, ty: 0 }; });
      var mouse = { x: -9999, y: -9999, active: false };
      var radius = 170;
      var strength = 16; // max px shift — subtle on purpose

      collage.addEventListener('mousemove', function (e) {
        var rect = collage.getBoundingClientRect();
        mouse.x = e.clientX - rect.left;
        mouse.y = e.clientY - rect.top;
        mouse.active = true;
      });
      collage.addEventListener('mouseleave', function () {
        mouse.active = false;
      });

      function frame() {
        var collageRect = collage.getBoundingClientRect();

        imgs.forEach(function (img, i) {
          var rect = img.getBoundingClientRect();
          var cx = rect.left - collageRect.left + rect.width / 2;
          var cy = rect.top - collageRect.top + rect.height / 2;

          var targetX = 0,
            targetY = 0;

          if (mouse.active) {
            var dx = cx - mouse.x;
            var dy = cy - mouse.y;
            var dist = Math.sqrt(dx * dx + dy * dy) || 0.001;
            if (dist < radius) {
              var force = (1 - dist / radius) * strength;
              targetX = (dx / dist) * force;
              targetY = (dy / dist) * force;
            }
          }

          var s = state[i];
          s.tx += (targetX - s.tx) * 0.12;
          s.ty += (targetY - s.ty) * 0.12;
          img.style.transform = 'translate(' + s.tx.toFixed(2) + 'px, ' + s.ty.toFixed(2) + 'px)';
        });

        requestAnimationFrame(frame);
      }
      requestAnimationFrame(frame);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>