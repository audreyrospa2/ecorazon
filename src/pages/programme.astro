<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.scroll-reveal').forEach(el => observer.observe(el));
  });
</script>

<!-- "Signature Experiences" CTA scrolls smoothly to the wheel section -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const cta = document.querySelector<HTMLAnchorElement>('.js-scroll-cta');
    const target = document.getElementById('wheel-section');
    if (!cta || !target) return;

    cta.addEventListener('click', (e) => {
      e.preventDefault();
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
</script>

<!-- H.E.A.R.T. card stack + circle nav -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const section = document.querySelector<HTMLElement>('.heart-framework-section');
    if (!section) return;

    const cards = Array.from(section.querySelectorAll<HTMLButtonElement>('.stack-card'));
    const circles = Array.from(section.querySelectorAll<HTMLButtonElement>('.pillar-circle'));

    if (cards.length === 0 || circles.length === 0) return;

    const count = cards.length;
    let positions = cards.map((_, i) => i);
    let animating = false;
    let autoplayId: ReturnType<typeof setInterval> | null = null;
    let resumeTimeoutId: ReturnType<typeof setTimeout> | null = null;

    const findByPosition = (pos: number) => positions.indexOf(pos);

    const applyPositions = () => {
      cards.forEach((el, i) => { el.dataset.position = String(positions[i]); });
    };

    const renderCaption = () => {
      const frontIdx = findByPosition(0);
      circles.forEach((c, i) => {
        const isActive = i === frontIdx;
        c.classList.toggle('active', isActive);
        c.setAttribute('aria-selected', String(isActive));
      });
    };

    const rotate = (steps: number) => {
      if (animating || steps === 0) return;
      animating = true;

      const oldFrontIdx = findByPosition(0);
      if (steps > 0) cards[oldFrontIdx].classList.add('exit-left');

      positions = positions.map((p) => ((p - steps) % count + count) % count);

      if (steps < 0) {
        const newFrontIdx = findByPosition(0);
        cards[newFrontIdx].classList.add('enter-left');
      }

      applyPositions();
      renderCaption();

      setTimeout(() => {
        cards[oldFrontIdx].classList.remove('exit-left');
        cards.forEach((el) => el.classList.remove('enter-left'));
        animating = false;
      }, 650);
    };

    const next = () => rotate(1);

    const goToIndex = (targetIdx: number) => rotate(positions[targetIdx]);

    const startAutoplay = () => { stopAutoplay(); autoplayId = setInterval(next, 2800); };
    const stopAutoplay = () => { if (autoplayId) clearInterval(autoplayId); autoplayId = null; };
    const pauseThenResume = () => {
      stopAutoplay();
      if (resumeTimeoutId) clearTimeout(resumeTimeoutId);
      resumeTimeoutId = setTimeout(startAutoplay, 6000);
    };

    cards.forEach((el) => {
      el.addEventListener('click', () => {
        const pos = Number(el.dataset.position);
        rotate(pos === 0 ? 1 : pos);
        pauseThenResume();
      });
    });

    circles.forEach((c, i) => {
      c.addEventListener('click', () => { goToIndex(i); pauseThenResume(); });
    });

    applyPositions();
    renderCaption();

    const heartObserver = new IntersectionObserver(
      (entries) => entries.forEach((entry) => entry.isIntersecting ? startAutoplay() : stopAutoplay()),
      { threshold: 0.4 }
    );
    heartObserver.observe(section);
  });
</script>

<!-- "Ways to Bring H.E.A.R.T." horizontal card scroller -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const section = document.querySelector<HTMLElement>('.cards-switch-section');
    if (!section) return;

    const viewport = section.querySelector<HTMLElement>('.cards-switch-viewport');
    const track = section.querySelector<HTMLElement>('#formatsTrack');
    const prevBtn = section.querySelector<HTMLButtonElement>('.cards-arrow.prev');
    const nextBtn = section.querySelector<HTMLButtonElement>('.cards-arrow.next');

    if (!viewport || !track || !prevBtn || !nextBtn) return;

    const firstCard = track.querySelector<HTMLElement>('.format-card');

    const step = (): number => {
      if (!firstCard) return viewport.clientWidth * 0.8;
      const trackStyles = window.getComputedStyle(track);
      const gap = parseFloat(trackStyles.columnGap || trackStyles.gap || '0') || 0;
      return firstCard.offsetWidth + gap;
    };

    prevBtn.addEventListener('click', () => {
      viewport.scrollBy({ left: -step(), behavior: 'smooth' });
    });

    nextBtn.addEventListener('click', () => {
      viewport.scrollBy({ left: step(), behavior: 'smooth' });
    });
  });
</script>

<!-- H.E.A.R.T. Wheel carousel -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const section = document.querySelector<HTMLElement>('.wheel-section');
    if (!section) return;

    const items = Array.from(section.querySelectorAll<HTMLButtonElement>('.wheel-item'));
    const titleEl = section.querySelector<HTMLElement>('#wheelTitle');
    const descEl = section.querySelector<HTMLElement>('#wheelDesc');
    const prevBtn = section.querySelector<HTMLButtonElement>('.wheel-arrow.prev');
    const nextBtn = section.querySelector<HTMLButtonElement>('.wheel-arrow.next');

    if (!titleEl || !descEl || !prevBtn || !nextBtn || items.length === 0) return;

    const pillars = items.map((el) => ({
      color: el.dataset.color ?? '#1a1a1a',
      title: el.dataset.title ?? '',
      desc: el.dataset.desc ?? ''
    }));

    // Circle geometry — matches the viewBox of .wheel-arc-line (0 0 640 400):
    // center (320,400), radius 260. 180° = far left, 90° = top apex, 0° = far right.
    const CX = 320, CY = 400, R = 260;
    const STEP = 45; // degrees between neighbouring items, matches the original layout
    const baseAngles = pillars.map((_, i) => 180 - i * STEP); // 180,135,90,45,0

    let index = 0;
    let rotation = 0;
    let rafId: number | null = null;

    const opacityFor = (norm: number) => {
      // norm 0–180 is the visible top of the wheel — always fully shown.
      // Past 180 the item has swung underneath; fade it out over ~25°
      // instead of popping, so it reads as sinking below the edge.
      if (norm <= 180) return 1;
      const distanceBelow = Math.min(norm - 180, 360 - norm);
      const buffer = 25;
      return Math.max(0, 1 - distanceBelow / buffer);
    };

    const setItemPosition = (el: HTMLElement, angleDeg: number) => {
      const rad = (angleDeg * Math.PI) / 180;
      const x = CX + R * Math.cos(rad);
      const y = CY - R * Math.sin(rad);
      el.style.left = (x / 640) * 100 + '%';
      el.style.top = (y / 400) * 100 + '%';

      const norm = ((angleDeg % 360) + 360) % 360;
      const opacity = opacityFor(norm);
      el.style.opacity = String(opacity);
      el.style.pointerEvents = opacity < 0.1 ? 'none' : '';
    };

    const render = (rot: number) => {
      items.forEach((el, i) => setItemPosition(el, baseAngles[i] + rot));
    };

    const easeInOutCubic = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

    const animateTo = (from: number, to: number, duration = 700) => {
      if (rafId) cancelAnimationFrame(rafId);
      const start = performance.now();
      const step = (now: number) => {
        const t = Math.min(1, (now - start) / duration);
        render(from + (to - from) * easeInOutCubic(t));
        rafId = t < 1 ? requestAnimationFrame(step) : null;
      };
      rafId = requestAnimationFrame(step);
    };

    const updateCaption = () => {
      const pillar = pillars[index];
      items.forEach((el, i) => {
        const isActive = i === index;
        el.classList.toggle('active', isActive);
        el.setAttribute('aria-selected', String(isActive));
      });
      section.style.setProperty('--pillar-color', pillar.color);
      titleEl.textContent = pillar.title;
      titleEl.style.color = pillar.color;
      descEl.textContent = pillar.desc;
    };

    const goTo = (targetIndex: number) => {
      const n = pillars.length;
      const newIndex = ((targetIndex % n) + n) % n;
      if (newIndex === index) return;

      // shortest signed path around the wheel, so a distant click spins
      // the short way rather than the long way
      let diff = newIndex - index;
      if (diff > n / 2) diff -= n;
      if (diff < -n / 2) diff += n;

      const target = rotation - diff * STEP;
      index = newIndex;
      updateCaption();
      animateTo(rotation, target);
      rotation = target;
    };

    const next = () => goTo(index + 1);
    const prev = () => goTo(index - 1);

    let autoplayId: ReturnType<typeof setInterval> | null = null;
    let resumeTimeoutId: ReturnType<typeof setTimeout> | null = null;

    const startAutoplay = () => { stopAutoplay(); autoplayId = setInterval(next, 3200); };
    const stopAutoplay = () => { if (autoplayId) clearInterval(autoplayId); autoplayId = null; };
    const pauseThenResume = () => {
      stopAutoplay();
      if (resumeTimeoutId) clearTimeout(resumeTimeoutId);
      resumeTimeoutId = setTimeout(startAutoplay, 6000);
    };

    items.forEach((el, i) => {
      el.addEventListener('click', () => { goTo(i); pauseThenResume(); });
    });
    nextBtn.addEventListener('click', () => { next(); pauseThenResume(); });
    prevBtn.addEventListener('click', () => { prev(); pauseThenResume(); });

    render(0);
    updateCaption();

    const wheelObserver = new IntersectionObserver(
      (entries) => entries.forEach((entry) => entry.isIntersecting ? startAutoplay() : stopAutoplay()),
      { threshold: 0.4 }
    );
    wheelObserver.observe(section);
  });
</script>

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    if (window.gsap && window.ScrollTrigger) {
      gsap.registerPlugin(ScrollTrigger);

      // Each photo gets its own drift distance (yPercent) and direction.
      // Bigger / higher z-index photos ("closer" to the viewer) move further,
      // smaller / lower z-index photos ("further back") move less — that
      // difference in speed is what reads as parallax depth.
      const driftMap = {
        '.photo-1': 45,   // mid-large, front-ish -> moves down
        '.photo-2': -60,  // biggest, frontmost   -> moves up, furthest
        '.photo-3': 25,   // small, background    -> subtle drift down
        '.photo-4': -35,  // mid, front-ish        -> moves up
        '.photo-5': -15   // smallest, furthest back -> barely moves
      };

      Object.entries(driftMap).forEach(([selector, yPercent]) => {
        const el = document.querySelector(selector);
        if (!el) return;

        gsap.to(el, {
          yPercent,
          ease: 'none',
          scrollTrigger: {
            trigger: '.wellbeing-section',
            start: 'top bottom',   // begin as section enters viewport from below
            end: 'bottom top',     // finish as it exits above
            scrub: true            // ties directly to scroll position, no pin needed
          }
        });
      });
    } else {
      console.warn('[wellbeing-section] GSAP or ScrollTrigger did not load — photo animation disabled.');
    }
  });
</script>