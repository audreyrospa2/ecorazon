---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Our Works - Ecorazón">
  <Header />

  <main class="works-page">

    <!-- Hero -->
    <section class="works-hero">
      <div class="works-hero-content">
        <h1 class="works-hero-title animate-fade-in i18n-text-html" data-zh-html="身心可感受的健康<br />組織可衡量的成效">
          Wellness that people can feel<br />
          and organizations can measure
        </h1>
        <p class="works-hero-sub animate-fade-in-delay i18n-text" data-zh="Ecorazón 為企業策劃結合運動、創意實踐、自然體驗與專業支援的身心健康企劃。每個企劃皆圍繞您的團隊與業務需求量身打造，協助團隊重新調整步伐、建立連結，發展更健康的工作方式。">
          Ecorazón curates corporate wellness programmes that combine movement, creative practice, nature-based experiences and professional support. Built around your people and business priorities, each programme helps teams reset, reconnect and build healthier ways of working.
        </p>
        <a href="#wheel-section" class="hero-cta animate-fade-in-cta i18n-text js-scroll-cta" data-zh="精選體驗">Signature Experiences</a>
      </div>

      <div class="works-hero-media animate-fade-in-media">
        <div class="jelly-wrap">
          <video
            class="hero-jelly-video"
            autoplay
            muted
            loop
            playsinline
            preload="auto"
            disablepictureinpicture
            disableRemotePlayback
          >
            <source src="/video/programme-hero.mp4" type="video/mp4" />
          </video>
        </div>
      </div>
    </section>

    <!-- Wellbeing Movement Intro -->
    <section class="wellbeing-section">
      <div class="wellbeing-photos">
        <div class="floating-photo photo-1"><div class="floating-photo-inner"><img src="/images/artists.jpg" alt="" /></div></div>
        <div class="floating-photo photo-2"><div class="floating-photo-inner"><img src="/images/artists.jpg" alt="" /></div></div>
        <div class="floating-photo photo-3"><div class="floating-photo-inner"><img src="/images/artists.jpg" alt="" /></div></div>
        <div class="floating-photo photo-4"><div class="floating-photo-inner"><img src="/images/artists.jpg" alt="" /></div></div>
        <div class="floating-photo photo-5"><div class="floating-photo-inner"><img src="/images/artists.jpg" alt="" /></div></div>
      </div>

      <div class="wellbeing-inner">
        <h2 class="wellbeing-title i18n-text" data-zh="身心共好行動">Ecorazón Wellbeing Movement</h2>
        <p class="wellbeing-desc i18n-text-html" data-zh-html="<strong>我們相信身心健康是基本需求，而非奢侈品。</strong><br /><br />Ecorazón 源於一個簡單的信念：人們不應該為了成功而與自己失去連結。在快節奏的世界裡，許多人默默承受著壓力、疲憊與焦慮。我們創造一個讓人們得以暫停、呼吸、重新連結並被看見的空間。<br /><br /><strong>我們不是來販賣健康的。<br />我們是來培養一種關懷的文化。</strong>">
          <strong>We believe wellbeing is a human need, not a luxury.</strong>
          <br /><br />
          Ecorazón began with a simple belief: people should not have to disconnect from themselves in order to succeed. In a fast-moving world, many carry stress, fatigue and pressure quietly. We create space for people to pause, breathe, reconnect and feel seen.
          <br /><br />
          <strong>We are not here to sell wellness.<br />We are here to cultivate a culture of care.</strong>
        </p>
      </div>
    </section>

    <!-- H.E.A.R.T. Framework -->
    <section class="heart-framework-section">

      <!-- Left: copy + nav -->
      <div class="heart-content">
        <p class="heart-eyebrow scroll-reveal">The H.E.A.R.T. Framework</p>
        <h2 class="heart-title scroll-reveal">
          One H.E.A.R.T. Framework,<br />
          Five ways to support your people
        </h2>
        <p class="heart-desc scroll-reveal">
          From physical foundations and active self-care to creativity, meaningful connection
          and professional development, H.E.A.R.T. turns wellness into practical experiences
          your team can use at work and beyond.
        </p>

        <div class="heart-circles-row scroll-reveal">
          <div class="heart-circles" role="tablist" aria-label="H.E.A.R.T. pillars">
            <button class="pillar-circle active" role="tab" aria-selected="true" data-name="Health" data-blurb="Physical foundations" style="background-image:url('/images/4.png');"><span class="letter">H</span></button>
            <button class="pillar-circle" role="tab" aria-selected="false" data-name="Energy" data-blurb="Active self-care" style="background-image:url('/images/16.jpg');"><span class="letter">E</span></button>
            <button class="pillar-circle" role="tab" aria-selected="false" data-name="Art" data-blurb="Creative practice" style="background-image:url('/images/17.jpg');"><span class="letter">A</span></button>
            <button class="pillar-circle" role="tab" aria-selected="false" data-name="Relationships" data-blurb="Meaningful connection" style="background-image:url('/images/2.png');"><span class="letter">R</span></button>
            <button class="pillar-circle" role="tab" aria-selected="false" data-name="Talent" data-blurb="Professional development" style="background-image:url('/images/artists.jpg');"><span class="letter">T</span></button>
          </div>
        </div>
      </div>

      <!-- Right: big tilted card stack -->
      <div class="heart-visual scroll-reveal">
        <div class="heart-stack" id="heartStack">
          <button class="stack-card" data-name="Health" data-blurb="Physical foundations" style="background-image:url('/images/4.png');"></button>
          <button class="stack-card" data-name="Energy" data-blurb="Active self-care" style="background-image:url('/images/16.jpg');"></button>
          <button class="stack-card" data-name="Art" data-blurb="Creative practice" style="background-image:url('/images/17.jpg');"></button>
          <button class="stack-card" data-name="Relationships" data-blurb="Meaningful connection" style="background-image:url('/images/2.png');"></button>
          <button class="stack-card" data-name="Talent" data-blurb="Professional development" style="background-image:url('/images/artists.jpg');"></button>
        </div>
      </div>
    </section>

    <!-- H.E.A.R.T. Wheel -->
    <section class="wheel-section" id="wheel-section">
      <div class="wheel-inner">
        <p class="wheel-eyebrow scroll-reveal">The H.E.A.R.T. Framework</p>
        <h2 class="wheel-title scroll-reveal" id="wheelTitle">Health, Habits &amp; Healing</h2>
        <p class="wheel-desc scroll-reveal" id="wheelDesc">Supporting everyday energy, rest and physical wellbeing as the basis for a sustainable working life.</p>

        <div class="wheel-carousel scroll-reveal">
          <button class="wheel-arrow prev" aria-label="Previous pillar">←</button>

          <div class="wheel-arc-wrap">
            <svg class="wheel-arc-line" viewBox="0 0 640 400" preserveAspectRatio="none" aria-hidden="true">
              <path d="M 60 400 A 260 260 0 0 1 580 400" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2 8" stroke-linecap="round"/>
            </svg>

            <div class="wheel-track" id="wheelTrack" role="tablist" aria-label="H.E.A.R.T. pillars">

              <button
                class="wheel-item active"
                role="tab"
                aria-selected="true"
                data-key="H"
                data-color="#E2954E"
                data-title="Health, Habits &amp; Healing"
                data-desc="Supporting everyday energy, rest and physical wellbeing as the basis for a sustainable working life."
                style="left:9.4%; top:100%;"
              >
                <span class="wheel-circle">
                  <svg viewBox="0 0 100 100" class="wheel-icon" aria-hidden="true">
                    <line x1="10" y1="68" x2="90" y2="68" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
                    <path d="M28 68a22 22 0 0 1 44 0" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
                    <g stroke="currentColor" stroke-width="4" stroke-linecap="round">
                      <line x1="50" y1="30" x2="50" y2="20"/>
                      <line x1="26" y1="40" x2="18" y2="33"/>
                      <line x1="74" y1="40" x2="82" y2="33"/>
                    </g>
                  </svg>
                </span>
                <span class="wheel-letter">H</span>
                <span class="wheel-dot"></span>
              </button>

              <button
                class="wheel-item"
                role="tab"
                aria-selected="false"
                data-key="E"
                data-color="#9B7BAE"
                data-title="Exercise, Engagement &amp; Empowerment"
                data-desc="Using accessible movement to help people release tension, restore balance and feel more present."
                style="left:21.3%; top:54.05%;"
              >
                <span class="wheel-circle">
                  <svg viewBox="0 0 100 100" class="wheel-icon" aria-hidden="true">
                    <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="4"/>
                    <circle cx="50" cy="50" r="6" fill="none" stroke="currentColor" stroke-width="4"/>
                    <g stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                      <line x1="50" y1="16" x2="50" y2="44"/>
                      <line x1="50" y1="56" x2="50" y2="84"/>
                      <line x1="16" y1="50" x2="44" y2="50"/>
                      <line x1="56" y1="50" x2="84" y2="50"/>
                      <line x1="26" y1="26" x2="46" y2="46"/>
                      <line x1="74" y1="26" x2="54" y2="46"/>
                      <line x1="26" y1="74" x2="46" y2="54"/>
                      <line x1="74" y1="74" x2="54" y2="54"/>
                    </g>
                  </svg>
                </span>
                <span class="wheel-letter">E</span>
                <span class="wheel-dot"></span>
              </button>

              <button
                class="wheel-item"
                role="tab"
                aria-selected="false"
                data-key="A"
                data-color="#5F8FA6"
                data-title="Arts, Actions &amp; Appreciation"
                data-desc="Inviting creativity, mindfulness and self-expression to create focus, calm and fresh perspectives."
                style="left:50%; top:35%;"
              >
                <span class="wheel-circle">
                  <svg viewBox="0 0 100 100" class="wheel-icon" aria-hidden="true">
                    <path d="M50 16c19 0 34 14 34 30 0 10-7 15-15 15h-6c-3 0-5 2-5 5 0 2 1 3 1 5 0 5-4 9-9 9-19 0-34-15-34-34S31 16 50 16z" fill="none" stroke="currentColor" stroke-width="4" stroke-linejoin="round"/>
                    <circle cx="36" cy="42" r="4" fill="currentColor"/>
                    <circle cx="50" cy="34" r="4" fill="currentColor"/>
                    <circle cx="64" cy="42" r="4" fill="currentColor"/>
                    <circle cx="32" cy="60" r="4" fill="currentColor"/>
                  </svg>
                </span>
                <span class="wheel-letter">A</span>
                <span class="wheel-dot"></span>
              </button>

              <button
                class="wheel-item"
                role="tab"
                aria-selected="false"
                data-key="R"
                data-color="#95BD8D"
                data-title="Retreat, Resilience &amp; Relationships"
                data-desc="Building meaningful connection, trust and the capacity to navigate challenges together."
                style="left:78.7%; top:54.05%;"
              >
                <span class="wheel-circle">
                  <svg viewBox="0 0 100 100" class="wheel-icon" aria-hidden="true">
                    <circle cx="50" cy="50" r="8" fill="none" stroke="currentColor" stroke-width="3.5"/>
                    <circle cx="50" cy="50" r="18" fill="none" stroke="currentColor" stroke-width="3.5"/>
                    <circle cx="50" cy="50" r="28" fill="none" stroke="currentColor" stroke-width="3.5"/>
                    <circle cx="50" cy="50" r="38" fill="none" stroke="currentColor" stroke-width="3.5"/>
                  </svg>
                </span>
                <span class="wheel-letter">R</span>
                <span class="wheel-dot"></span>
              </button>

              <button
                class="wheel-item"
                role="tab"
                aria-selected="false"
                data-key="T"
                data-color="#3F5A45"
                data-title="Training, Therapy &amp; Transformation"
                data-desc="Bringing learning, coaching and professional support together so individuals and teams can grow with confidence."
                style="left:90.6%; top:100%;"
              >
                <span class="wheel-circle">
                  <svg viewBox="0 0 100 100" class="wheel-icon" aria-hidden="true">
                    <circle cx="42" cy="42" r="2.5" fill="currentColor"/>
                    <circle cx="50" cy="50" r="10" fill="none" stroke="currentColor" stroke-width="3"/>
                    <circle cx="50" cy="50" r="20" fill="none" stroke="currentColor" stroke-width="2.5" opacity="0.75"/>
                    <circle cx="50" cy="50" r="30" fill="none" stroke="currentColor" stroke-width="2" opacity="0.5"/>
                    <circle cx="50" cy="50" r="39" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.3"/>
                  </svg>
                </span>
                <span class="wheel-letter">T</span>
                <span class="wheel-dot"></span>
              </button>

            </div>
          </div>

          <button class="wheel-arrow next" aria-label="Next pillar">→</button>
        </div>
      </div>
    </section>

    <!-- Ways to Bring H.E.A.R.T. to Your Team -->
    <section class="wrk-section bg-warm cards-switch-section">
      <div class="wrk-inner">
        <div class="cards-switch-head">
          <div>
            <h2 class="section-title scroll-reveal">Ways to Bring H.E.A.R.T. to Your Team</h2>
            <p class="section-sub scroll-reveal">However much time and space you have, we shape a format around your team and your goals.</p>
          </div>
          <div class="cards-switch-nav scroll-reveal">
            <button class="cards-arrow prev" aria-label="Scroll formats left">←</button>
            <button class="cards-arrow next" aria-label="Scroll formats right">→</button>
          </div>
        </div>

        <div class="cards-switch-viewport scroll-reveal">
          <div class="cards-switch-track" id="formatsTrack">

            <div class="format-card">
              <span class="format-index">01</span>
              <h3 class="format-name">Half-Day Reset</h3>
              <p class="format-desc">A focused single session — movement, breathwork or a creative activity — built to fit around a busy work day.</p>
            </div>

            <div class="format-card">
              <span class="format-index">02</span>
              <h3 class="format-name">Multi-Day Programme</h3>
              <p class="format-desc">A series of sessions across several weeks, layering the H.E.A.R.T. pillars so new habits have time to stick.</p>
            </div>

            <div class="format-card">
              <span class="format-index">03</span>
              <h3 class="format-name">Off-Site Retreat</h3>
              <p class="format-desc">An immersive day or overnight retreat combining nature, movement and reflection away from the office.</p>
            </div>

            <div class="format-card">
              <span class="format-index">04</span>
              <h3 class="format-name">Ongoing Partnership</h3>
              <p class="format-desc">Regular touchpoints across the year, so wellbeing becomes part of how your team works, not a one-off event.</p>
            </div>

            <div class="format-card">
              <span class="format-index">05</span>
              <h3 class="format-name">Custom Activation</h3>
              <p class="format-desc">A one-off experience designed around a specific milestone — a launch, an offsite, or an internal campaign.</p>
            </div>

          </div>
        </div>
      </div>
    </section>

    <!-- Testimonials -->
    <section class="wrk-section bg-white testi-section">
      <div class="wrk-inner">
        <div class="testi-head">
          <h2 class="section-title scroll-reveal">What people experience with Ecorazón</h2>
          <p class="section-sub scroll-reveal">From HR leads booking their first reset to founders building ongoing wellbeing programmes — here's how teams describe working with us.</p>
        </div>

        <div class="testi-grid scroll-reveal">
          <div class="testi-card">
            <p class="testi-quote">We use Laughter Yoga as a dynamic group session that combines stress-relief training with team-building. It trains the body to release stress, provides a therapeutic emotional release, and uses shared joy to instantly unify the team.</p>
            <div class="testi-footer">
              <img src="/images/bnw-logo.png" alt="" class="testi-logo" />
              <span class="testi-company">Company Name</span>
            </div>
          </div>

          <div class="testi-card">
            <p class="testi-quote">We use Laughter Yoga as a dynamic group session that combines stress-relief training with team-building. It trains the body to release stress, provides a therapeutic emotional release, and uses shared joy to instantly unify the team.</p>
            <div class="testi-footer">
              <img src="/images/bnw-logo.png" alt="" class="testi-logo" />
              <span class="testi-company">Company Name</span>
            </div>
          </div>

          <div class="testi-card">
            <p class="testi-quote">We use Laughter Yoga as a dynamic group session that combines stress-relief training with team-building. It trains the body to release stress, provides a therapeutic emotional release, and uses shared joy to instantly unify the team.</p>
            <div class="testi-footer">
              <img src="/images/bnw-logo.png" alt="" class="testi-logo" />
              <span class="testi-company">Company Name</span>
            </div>
          </div>

          <div class="testi-card">
            <p class="testi-quote">We use Laughter Yoga as a dynamic group session that combines stress-relief training with team-building. It trains the body to release stress, provides a therapeutic emotional release, and uses shared joy to instantly unify the team.</p>
            <div class="testi-footer">
              <img src="/images/bnw-logo.png" alt="" class="testi-logo" />
              <span class="testi-company">Company Name</span>
            </div>
          </div>

          <div class="testi-card">
            <p class="testi-quote">We use Laughter Yoga as a dynamic group session that combines stress-relief training with team-building. It trains the body to release stress, provides a therapeutic emotional release, and uses shared joy to instantly unify the team.</p>
            <div class="testi-footer">
              <img src="/images/bnw-logo.png" alt="" class="testi-logo" />
              <span class="testi-company">Company Name</span>
            </div>
          </div>
        </div>
      </div>
    </section>

        <!-- CTA Section -->
    <section class="cta-section text-center">
      <div class="max-w-4xl mx-auto px-6">
        <h2 class="text-3xl md:text-4xl font-bold mb-6 tracking-wide parallax-text">
          READY TO TRANSFORM YOUR WORKPLACE CULTURE?
        </h2>
        <p class="text-lg mb-8 leading-relaxed parallax-text">
          Let's co-create gifts and experiences that inspire, empower, and sustain.
        </p>
        <a href="/get-in-touch" class="cta-btn">Get in Touch</a>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style is:global>
  .works-page {
    padding-top: 72px;
  }

  /* ─── HERO ─── */
  html {
    scroll-snap-type: y mandatory;
    scroll-behavior: auto;
  }

  .works-hero,
  .wrk-section,
  .wellbeing-section,
  .heart-framework-section,
  .wheel-section,
  .cta-section {
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .works-hero {
    position: relative;
    background: linear-gradient(
      to right,
      #C7DBA9 0%,
      #D8E6BF 8%,
      #EAE8C1 16%,
      #F5DBBE 26%,
      #F8DBC1 32%,
      #FBEAD6 40%,
      #FAF5F0 46%,
      #F8F8F8 54%,
      #F8F8F8 100%
    );
    height: 100vh;
    padding: clamp(4rem, 8vw, 7rem) clamp(2rem, 8vw, 7rem);
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(2rem, 5vw, 5rem);
    overflow: hidden;
  }

  .works-hero-content {
    position: relative;
    z-index: 2;
    max-width: 820px;
    flex: 1 1 480px;
  }

  .works-hero-title {
    font-family: 'MaoWei', sans-serif;
    font-weight: 700;
    font-size: clamp(2rem, 4vw, 3rem);
    color: #1a1a1a;
    margin: 0 0 1.25rem 0;
    line-height: 1.15;
  }

  .works-hero-sub {
    font-family: 'MaoWei', sans-serif;
    font-size: clamp(0.9rem, 1.4vw, 1.05rem);
    color: #1a1a1a;
    opacity: 0.75;
    margin: 0 0 2rem 0;
    max-width: 520px;
    line-height: 1.7;
  }

  .hero-cta {
    display: inline-block;
    font-family: 'MaoWei', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    color: #ffffff;
    background: #1a1a1a;
    padding: 0.85rem 2rem;
    transition: background 0.25s ease, transform 0.25s ease;
  }

  .hero-cta:hover {
    background: #C08EA4;
    transform: translateY(-2px);
  }

  /* ─── HERO MEDIA / ROTATING JELLY VIDEO ─── */
  .works-hero-media {
    position: relative;
    z-index: 2;
    flex: 0 1 380px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .jelly-wrap {
    width: clamp(280px, 34vw, 520px);
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #FCFCFB;
  }

  .hero-jelly-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none; /* no click-to-pause / native controls interaction */
  }

  .hero-jelly-video::-webkit-media-controls,
  .hero-jelly-video::-webkit-media-controls-start-playback-button {
    display: none !important;
    -webkit-appearance: none;
  }

  /* ─── HERO ENTRY ANIMATION ─── */
  @keyframes fadeInDown {
    from { opacity: 0; transform: translateY(-16px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  .animate-fade-in        { animation: fadeInDown 0.8s ease-out 0.15s both; }
  .animate-fade-in-delay  { animation: fadeInDown 0.8s ease-out 0.35s both; }
  .animate-fade-in-cta    { animation: fadeInUp 0.8s ease-out 0.55s both; }
  .animate-fade-in-media  { animation: fadeIn 1.2s ease-out 0.4s both; }

  /* ─── WELLBEING MOVEMENT INTRO ─── */
  .wellbeing-section {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(180deg, #ffffff 0%, #E8E8E5 100%);
    overflow: hidden;
    padding: clamp(6rem, 10vh, 9rem) clamp(2rem, 6vw, 6rem);
  }

  .wellbeing-inner {
    position: relative;
    z-index: 2;
    max-width: 760px;
    text-align: center;
  }

  .wellbeing-title {
    font-family: 'MaoWei', sans-serif;
    font-weight: 700;
    font-size: clamp(1.8rem, 3.4vw, 2.75rem);
    color: #1a1a1a;
    margin: 0 0 2.25rem 0;
    line-height: 1.3;
  }

  .wellbeing-desc {
    font-family: 'MaoWei', sans-serif;
    font-size: clamp(0.95rem, 1.3vw, 1.05rem);
    color: #1a1a1a;
    opacity: 0.75;
    line-height: 1.9;
    margin: 0;
  }

  .wellbeing-desc strong {
    opacity: 1;
    font-weight: 700;
  }

  /* Floating reference photos */
  .wellbeing-photos {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .floating-photo {
    position: absolute;
  }

  .floating-photo-inner {
    position: relative;
