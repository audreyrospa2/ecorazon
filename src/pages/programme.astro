<!-- H.E.A.R.T. card stack + circle nav -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const section = document.querySelector<HTMLElement>('.heart-framework-section');
    if (!section) return;

    const cards = Array.from(section.querySelectorAll<HTMLButtonElement>('.stack-card'));
    const circles = Array.from(section.querySelectorAll<HTMLButtonElement>('.pillar-circle'));
    const labelEl = section.querySelector<HTMLElement>('#heartPillarLabel');

    if (cards.length === 0 || circles.length === 0) return;

    const count = cards.length;
    let positions = cards.map((_, i) => i);
    let animating = false;
    let autoplayId: ReturnType<typeof setInterval> | null = null;
    let resumeTimeoutId: ReturnType<typeof setTimeout> | null = null;

    const findByPosition = (pos: number) => positions.indexOf(pos);

    const applyPositions = () => {
      cards.forEach((el, i) => { el.dataset.position = String(positions[i]); });
    };

    const renderCaption = () => {
      const frontIdx = findByPosition(0);
      circles.forEach((c, i) => {
        const isActive = i === frontIdx;
        c.classList.toggle('active', isActive);
        c.setAttribute('aria-selected', String(isActive));
      });
      if (labelEl) labelEl.textContent = circles[frontIdx].dataset.title ?? '';
    };

    const rotate = (steps: number) => {
      if (animating || steps === 0) return;
      animating = true;

      const oldFrontIdx = findByPosition(0);
      if (steps > 0) cards[oldFrontIdx].classList.add('exit-left');

      positions = positions.map((p) => ((p - steps) % count + count) % count);

      if (steps < 0) {
        const newFrontIdx = findByPosition(0);
        cards[newFrontIdx].classList.add('enter-left');
      }

      applyPositions();
      renderCaption();

      setTimeout(() => {
        cards[oldFrontIdx].classList.remove('exit-left');
        cards.forEach((el) => el.classList.remove('enter-left'));
        animating = false;
      }, 650);
    };

    const next = () => rotate(1);

    const goToIndex = (targetIdx: number) => rotate(positions[targetIdx]);

    const startAutoplay = () => { stopAutoplay(); autoplayId = setInterval(next, 2800); };
    const stopAutoplay = () => { if (autoplayId) clearInterval(autoplayId); autoplayId = null; };
    const pauseThenResume = () => {
      stopAutoplay();
      if (resumeTimeoutId) clearTimeout(resumeTimeoutId);
      resumeTimeoutId = setTimeout(startAutoplay, 6000);
    };

    cards.forEach((el) => {
      el.addEventListener('click', () => {
        const pos = Number(el.dataset.position);
        rotate(pos === 0 ? 1 : pos);
        pauseThenResume();
      });
    });

    circles.forEach((c, i) => {
      c.addEventListener('click', () => { goToIndex(i); pauseThenResume(); });
    });

    applyPositions();
    renderCaption();

    const heartObserver = new IntersectionObserver(
      (entries) => entries.forEach((entry) => entry.isIntersecting ? startAutoplay() : stopAutoplay()),
      { threshold: 0.4 }
    );
    heartObserver.observe(section);
  });
</script>

<!-- "Ways to Bring H.E.A.R.T." horizontal card scroller -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const section = document.querySelector<HTMLElement>('.cards-switch-section');
    if (!section) return;

    const viewport = section.querySelector<HTMLElement>('.cards-switch-viewport');
    const track = section.querySelector<HTMLElement>('#formatsTrack');
    const prevBtn = section.querySelector<HTMLButtonElement>('.cards-arrow.prev');
    const nextBtn = section.querySelector<HTMLButtonElement>('.cards-arrow.next');

    if (!viewport || !track || !prevBtn || !nextBtn) return;

    const firstCard = track.querySelector<HTMLElement>('.format-card');

    const step = (): number => {
      if (!firstCard) return viewport.clientWidth * 0.8;
      const trackStyles = window.getComputedStyle(track);
      const gap = parseFloat(trackStyles.columnGap || trackStyles.gap || '0') || 0;
      return firstCard.offsetWidth + gap;
    };

    prevBtn.addEventListener('click', () => {
      viewport.scrollBy({ left: -step(), behavior: 'smooth' });
    });

    nextBtn.addEventListener('click', () => {
      viewport.scrollBy({ left: step(), behavior: 'smooth' });
    });
  });
</script>

<!-- H.E.A.R.T. Wheel: dome arc navigation + spinning icon + expandable activity cards -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const section = document.querySelector<HTMLElement>('.wheel-section');
    if (!section) return;

    const letters = Array.from(section.querySelectorAll<HTMLButtonElement>('.wheel-arc-letter'));
    const titleEl = section.querySelector<HTMLElement>('#wheelTitle');
    const descEl = section.querySelector<HTMLElement>('#wheelDesc');
    const cardsRow = section.querySelector<HTMLElement>('#wheelCardsRow');

    if (!titleEl || !descEl || !cardsRow || letters.length === 0) return;

    const wheelInner = section.querySelector<HTMLElement>('.wheel-inner');
    const arcWrap = section.querySelector<HTMLElement>('#wheelArcWrap');
    const iconImgEl = section.querySelector<HTMLImageElement>('#wheelIconImg');

    const pillarIcons: Record<string, string> = {
      H: '/images/sun.png',
      E: '/images/wheel.png',
      A: '/images/palette.png',
      R: '/images/log.png',
      T: '/images/ripple.png'
    };

    const sizeDome = () => {
      if (!wheelInner || !arcWrap) return;
      const sectionRect = section.getBoundingClientRect();
      const innerRect = wheelInner.getBoundingClientRect();
      const gap = 30;

      const available = sectionRect.bottom - innerRect.bottom - gap;
      const maxH = 220;

      if (available < 40) {
        arcWrap.style.opacity = '0';
        arcWrap.style.pointerEvents = 'none';
        return;
      }

      arcWrap.style.opacity = '1';
      arcWrap.style.pointerEvents = '';

      const h = Math.min(maxH, available);
      const w = Math.min(h * 3, window.innerWidth * 0.94);
      const finalH = w / 3;

      arcWrap.style.width = `${w}px`;
      arcWrap.style.height = `${finalH}px`;
      arcWrap.style.setProperty('--letter-size', `${Math.max(24, Math.min(46, finalH * 0.4))}px`);
    };

    sizeDome();
    window.addEventListener('resize', sizeDome);

    const modalOverlay = document.getElementById('wheelModalOverlay');
    const modalClose = document.getElementById('wheelModalClose');
    const modalGallery = document.getElementById('wheelModalGallery');
    const modalTitle = document.getElementById('wheelModalTitle');
    const modalText = document.getElementById('wheelModalText');

    type PillarActivity = { img: string; images?: string[]; caption: string; detail: string };

    const pillarData: Record<string, { color: string; title: string; desc: string }> = {
      H: { color: '#E2954E', title: 'Health, Habits &amp; Healing', desc: 'Supporting everyday energy, rest and physical wellbeing as the basis for a sustainable working life.' },
      E: { color: '#9B7BAE', title: 'Exercise, Engagement &amp; Empowerment', desc: 'Using accessible movement to help people release tension, restore balance and feel more present.' },
      A: { color: '#5F8FA6', title: 'Arts, Actions &amp; Appreciation', desc: 'Inviting creativity, mindfulness and self-expression to create focus, calm and fresh perspectives.' },
      R: { color: '#95BD8D', title: 'Retreat, Resilience &amp; Relationships', desc: 'Building meaningful connection, trust and the capacity to navigate challenges together.' },
      T: { color: '#3F5A45', title: 'Training, Therapy &amp; Transformation', desc: 'Bringing learning, coaching and professional support together so individuals and teams can grow with confidence.' }
    };

    const pillarCards: Record<string, PillarActivity[]> = {
      H: [
        { img: '/images/H1.jpg', caption: 'Wellness through Balance by TCM', detail: 'TCM wellbeing program offers health talks, consultations, and practical workshops on diet, stress, sleep, and yin-yang balance. It also includes herbal sachet making, soup and tea education, and wellness packs for staff.' },
        { img: '/images/H2.png', caption: 'Meridian & Acupoint Massage', detail: 'Learn the fundamentals of meridian wellness and master practical acupressure techniques to instantly relieve desk fatigue, headaches, and muscle tension—giving you the tools to stay comfortable both at work and at home.' }
      ],
      E: [
        { img: '/images/E1.png', caption: '"Gyrokinesis" Stress Relief', detail: 'Gyrokinesis releases tension, improves body awareness, and promotes deep relaxation. It also enhances spinal mobility and joint health, helping relieve desk-related stiffness and restore natural movement.' },
        { img: '/images/E2.png', caption: 'Wing Chun Cardio', detail: 'Wing Chun is a dynamic cardio workout that improves endurance, burns calories, and helps reduce stress while building focus and coordination.' },
        { img: '/images/E3.png', caption: 'Flexi-Functional Training', detail: 'Combines stretching and functional exercises in a practical, science-based way to train the body. It improves flexibility and joint range, strengthens core stability and posture, enhances balance and functional strength for everyday movement, reduces risk of neck/back pain and sports injuries, speeds recovery and performance, and builds a body that is both supple and powerful.' },
        { img: '/images/E4.png', caption: 'Tai Chi & Qigong Wellness Program', detail: 'Tai Chi and Qigong combine gentle movement, breath control, and mindful focus to support overall wellbeing. This practice helps reduce stress, improve balance and flexibility, boost energy flow, and build a lasting self-care routine.' },
        { img: '/images/E5.png', caption: 'The Mind-Body Reset Yoga Workshop', detail: 'A refreshing mind-body reset designed to help employees decompress, release physical desk tension, and lower workplace stress through accessible movement and breathwork.' }
      ],
      A: [
        { img: '/images/A1.png', caption: 'Art Workshop for Workplace Wellbeing', detail: 'Office Art Jamming is a relaxed team activity that encourages creativity, connection, and stress relief through guided painting. It helps improve team bonding, refresh the mind, and create positive shared experience at work.' },
        { img: '/images/A2.png', caption: 'Soothing Calligraphy', detail: 'Soothing Calligraphy is a mindful activity that combines breathing, gentle stretching, and brush practice to calm the mind and improve focus. It also encourages creativity through writing and simple art drawing.' },
        { img: '/images/A3.png', caption: 'Happy ME in Caricature', detail: 'Caricature with aromatherapy is a fun, light-hearted activity that helps participants relax, laugh, and connect. A quick portrait drawing, shared interactions, and a simple wellness pledge make it both enjoyable and meaningful.' },
        { img: '/images/A4.png', caption: 'Crystal Sound Healing & Wellness Session', detail: 'Experience a high-frequency sound journey featuring crystal singing bowls, didgeridoos, and pyramids. Combined with vocal resonance and guided meditation, this session helps release stress, calm the nervous system, and deeply relax the mind. Return to a grounded, refreshed state with restored clarity and energy in no time.' },
        { img: '/images/A5.png', caption: 'Gong Vibrational Wellness for Teams', detail: 'Immerse in a deep-vibration Gong Bath combined with vocal resonance and guided meditation. This powerful session releases stress, anxiety, and mental fatigue, calming the nervous system to help professionals quickly declutter their minds, recharge, and restore peak energy and clarity.' },
        { img: '/images/A6.png', caption: 'Mindful Tea & Wellness Workshop (Five-Senses Meditation, Tea Appreciation & Chair Stretching)', detail: 'Transform the office into a healing space with a mindful tea-and-relaxation session. Through five-senses meditation, tea mindfulness, gentle chair stretches, and self-care massage, it helps staff release stress, restore energy, and enjoy a calm "me time" at work.' }
      ],
      R: [
        { img: '/images/R1.png', caption: 'Forest Bathing - Nature Reconnect', detail: 'Forest bathing helps calm the mind, reduce stress, and support overall health by gently immersing your senses in nature. It has been linked to lower blood pressure and heart rate, better mood, and improved sleep and immune function, making it a simple, natural way to recharge in our busy lives.' }
      ],
      T: [
        { img: '/images/T1.png', caption: 'Laughing Yoga - Empowering Teams with Joy and Connection', detail: 'Laughter Yoga is a fun, science-based way to boost energy, lift mood, and reduce stress at work. Through guided laughter and breathing exercises, it helps teams feel more connected, positive, and collaborative.' }
      ]
    };

    const openModal = (item: PillarActivity) => {
      if (!modalOverlay || !modalGallery || !modalTitle || !modalText) return;
      const images = item.images && item.images.length ? item.images : [item.img];
      modalGallery.innerHTML = images.map((src) => `<img src="${src}" alt="" />`).join('');
      modalTitle.textContent = item.caption;
      modalText.textContent = item.detail;
      modalOverlay.classList.add('open');
      stopAutoplay();
    };

    const closeModal = () => {
      if (!modalOverlay) return;
      modalOverlay.classList.remove('open');
      pauseThenResume();
    };

    modalClose?.addEventListener('click', closeModal);
    modalOverlay?.addEventListener('click', (e) => {
      if (e.target === modalOverlay) closeModal();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modalOverlay?.classList.contains('open')) closeModal();
    });

    const buildCards = (key: string) => {
      const data = pillarCards[key] || [];
      cardsRow.innerHTML = '';

      data.forEach((item) => {
        const card = document.createElement('button');
        card.type = 'button';
        card.className = 'wheel-card';
        card.style.setProperty('--card-img', `url('${item.img}')`);

        const bg = document.createElement('span');
        bg.className = 'wheel-card-bg';
        bg.setAttribute('aria-hidden', 'true');

        const overlay = document.createElement('span');
        overlay.className = 'wheel-card-overlay';
        overlay.setAttribute('aria-hidden', 'true');

        const title = document.createElement('h3');
        title.className = 'wheel-card-title';
        title.textContent = item.caption;

        card.append(bg, overlay, title);
        card.addEventListener('click', () => openModal(item));
        cardsRow.appendChild(card);
      });
    };

    const keys = letters.map((b) => b.dataset.key ?? '');

    let activePillarIdx = 0;
    let iconSpinTimeoutId: ReturnType<typeof setTimeout> | null = null;

    const spinIcon = (key: string, newIdx: number) => {
      if (!iconImgEl) return;
      const dir = newIdx > activePillarIdx ? 'right' : newIdx < activePillarIdx ? 'left' : null;
      activePillarIdx = newIdx;
      if (!dir) return;

      if (iconSpinTimeoutId) clearTimeout(iconSpinTimeoutId);
      iconImgEl.classList.remove('spin-right', 'spin-left');
      void iconImgEl.offsetWidth; // restart animation cleanly
      iconImgEl.classList.add(dir === 'right' ? 'spin-right' : 'spin-left');

      // swap the icon image mid-spin, so it "flips" to the new one
      iconSpinTimeoutId = setTimeout(() => {
        iconImgEl.src = pillarIcons[key] ?? '';
      }, 300);
    };

    let swapTimeoutId: ReturnType<typeof setTimeout> | null = null;

    const selectPillar = (key: string) => {
      const pillar = pillarData[key];
      if (!pillar) return;

      const newIdx = keys.indexOf(key);
      spinIcon(key, newIdx);

      letters.forEach((btn) => {
        const isActive = btn.dataset.key === key;
        const wasActive = btn.classList.contains('active');
        btn.classList.toggle('active', isActive);
        btn.setAttribute('aria-selected', String(isActive));

        if (isActive && !wasActive) {
          btn.style.animation = 'none';
          void btn.offsetWidth;
          btn.style.animation = '';
        }
      });

      if (swapTimeoutId) clearTimeout(swapTimeoutId);

      const contentEls = [titleEl, descEl, cardsRow];
      contentEls.forEach((el) => el.classList.add('wheel-swap-out'));

      swapTimeoutId = setTimeout(() => {
        section.style.setProperty('--pillar-color', pillar.color);
        titleEl.innerHTML = pillar.title;
        titleEl.style.color = pillar.color;
        descEl.innerHTML = pillar.desc;
        buildCards(key);
        sizeDome();

        void cardsRow.offsetWidth;
        contentEls.forEach((el) => el.classList.remove('wheel-swap-out'));
        swapTimeoutId = null;
      }, 550);
    };

    let autoplayId: ReturnType<typeof setInterval> | null = null;
    let resumeTimeoutId: ReturnType<typeof setTimeout> | null = null;
    let currentIdx = 0;

    const next = () => {
      currentIdx = (currentIdx + 1) % keys.length;
      selectPillar(keys[currentIdx]);
    };

    const startAutoplay = () => { stopAutoplay(); autoplayId = setInterval(next, 3200); };
    const stopAutoplay = () => { if (autoplayId) clearInterval(autoplayId); autoplayId = null; };
    const pauseThenResume = () => {
      stopAutoplay();
      if (resumeTimeoutId) clearTimeout(resumeTimeoutId);
      resumeTimeoutId = setTimeout(startAutoplay, 6000);
    };

    letters.forEach((btn, i) => {
      btn.addEventListener('click', () => {
        currentIdx = i;
        selectPillar(btn.dataset.key ?? '');
        pauseThenResume();
      });
    });

    // Set the first icon immediately, no spin (nothing to spin from yet)
    activePillarIdx = 0;
    if (iconImgEl) iconImgEl.src = pillarIcons[keys[0]] ?? '/images/sun.png';
    selectPillar(keys[0]);

    const wheelObserver = new IntersectionObserver(
      (entries) => entries.forEach((entry) => entry.isIntersecting ? startAutoplay() : stopAutoplay()),
      { threshold: 0.4 }
    );
    wheelObserver.observe(section);
  });
</script>


<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    if (window.gsap && window.ScrollTrigger) {
      gsap.registerPlugin(ScrollTrigger);

      const driftMap = {
        '.photo-1': 45,
        '.photo-2': -60,
        '.photo-3': 25,
        '.photo-4': -35,
        '.photo-5': -15
      };

      Object.entries(driftMap).forEach(([selector, yPercent]) => {
        const el = document.querySelector(selector);
        if (!el) return;

        gsap.to(el, {
          yPercent,
          ease: 'none',
          scrollTrigger: {
            trigger: '.wellbeing-section',
            start: 'top bottom',
            end: 'bottom top',
            scrub: true
          }
        });
      });
    } else {
      console.warn('[wellbeing-section] GSAP or ScrollTrigger did not load — photo animation disabled.');
    }
  });
</script>