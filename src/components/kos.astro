---
// src/components/Kos.astro
---

<div id="kos-popup-overlay" class="kos-popup-overlay">
  <div class="kos-popup-content">
    <button id="kos-popup-close" class="kos-popup-close" aria-label="Close video">
      &times;
    </button>
    <div class="kos-popup-wrapper">
      <video controls autoplay muted>
        <source src="/video/kos.mp4" type="video/mp4" />
        Your browser does not support the video tag.
      </video>
    </div>
  </div>
</div>

<style>
  .kos-popup-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease;
  }

  .kos-popup-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .kos-popup-content {
    position: relative;
    width: 90%;
    max-width: 800px;
    animation: kos-popup-scale-in 0.3s ease;
  }

  @keyframes kos-popup-scale-in {
    from { transform: scale(0.9); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }

  .kos-popup-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
    border-radius: 8px;
    overflow: hidden;
  }

  .kos-popup-wrapper video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .kos-popup-close {
    position: absolute;
    top: -40px;
    right: 0;
    background: none;
    border: none;
    color: #fff;
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
    padding: 0.25rem 0.5rem;
  }

  .kos-popup-close:hover {
    opacity: 0.7;
  }

  @media (max-width: 640px) {
    .kos-popup-close {
      top: -36px;
      font-size: 1.5rem;
    }
  }
</style>

<script>
  const overlay = document.getElementById('kos-popup-overlay');
  const closeBtn = document.getElementById('kos-popup-close');
  const video = overlay?.querySelector('video');

  function openPopup() {
    overlay?.classList.add('active');
  }

  function closePopup() {
    overlay?.classList.remove('active');
    if (video) video.pause();
  }

  // Only auto-open if the URL path is /kos (case-insensitive, trailing slash optional)
  const path = window.location.pathname.toLowerCase().replace(/\/$/, '');
  if (path === '/kos') {
    setTimeout(openPopup, 500);
  }

  closeBtn?.addEventListener('click', closePopup);

  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) closePopup();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closePopup();
  });
</script>